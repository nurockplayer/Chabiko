{
  "name": "chabiko",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint src/ tests/ functions/",
    "typecheck": "astro check && tsc --noEmit -p functions/tsconfig.json",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "test": "vitest run",
    "test:a11y": "node tests/a11y/run.ts",
    "test:visual": "node tests/visual/run.ts verify",
    "test:visual:update": "node tests/visual/run.ts update",
    "validate": "node scripts/validation/run.ts run",
    "validate:affected": "node scripts/validation/run.ts run --tier t1",
    "validate:integration": "node scripts/validation/run.ts run --tier t2",
    "validate:full": "node scripts/validation/run.ts run --tier t3",
    "validate:classify": "node scripts/validation/run.ts classify",
    "validate:content": "bash scripts/validate-content.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.0",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@eslint/js": "^9.0.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^9.0.0",
    "happy-dom": "^20.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
