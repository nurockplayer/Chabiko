      "statusCurrent": {
        "css": "--color-status-current",
        "alias": null,
        "light": "#765215",
        "dark": "#f0bd6d",
        "role": "current/active status label text",
        "usedIn": [
          ".path-status",
          ".lesson-completion-status--current",
          ".can-do-section h2",
          ".route-status"
        ],
        "pointer": "#/tokens/color/statusCurrent"
      },
      "statusSuccess": {
        "css": "--color-status-success",
        "alias": null,
        "light": "#2f666b",
        "dark": "#8acbc4",
        "role": "completed status label text",
        "usedIn": [
          ".lesson-completion-status--done",
          ".completion-badge--done"
