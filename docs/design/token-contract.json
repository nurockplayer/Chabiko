{
  "id": "https://chabiko.dev/docs/design/token-contract.json",
  "title": "Chabiko Design Token Contract — A1 foundation deployed",
  "status": "a1-foundation-deployed",
  "frozenTarget": "./reference-family-389.md",
  "description": "Issue #393 (Session 1) has deployed the frozen A1 Editorial Calm foundation: semantic tokens, base text defaults, Header, Breadcrumb, and TrackNav in BaseLayout.astro. New surface code must use the A1 semantic tokens below. Legacy aliases (--color-*, --c-*, --font-ja|zh|pinyin, --radius, --space-*) are retained as a documented transitional compatibility layer for not-yet-migrated surfaces and are role-mapped to A1 values; they are removed surface by surface in #394–#397.",
  "source": "src/layouts/BaseLayout.astro token blocks (baseline :root, :root[data-theme-enabled='true'], :root[data-theme-enabled='true'][data-theme='dark'])",
  "verifiedAt": "2026-08-17",
  "tokens": {
    "a1": {
      "description": "Frozen A1 Editorial Calm semantic tokens (reference-family-389.md §§1–5). Use these in new surface code.",
      "color": {
        "paper": { "css": "--paper", "light": "#FAF8F4", "dark": "#1E1C19", "role": "page background" },
        "paperDeep": { "css": "--paper-deep", "light": "#F4F0E9", "dark": "#2A2723", "role": "soft block surface (can-do, flashcard base)" },
        "ink": { "css": "--ink", "light": "#272522", "dark": "#EFE9E0", "role": "primary text" },
        "inkSecondary": { "css": "--ink-secondary", "light": "#5E5A53", "dark": "#C6BFB4", "role": "secondary / supporting text" },
        "inkMuted": { "css": "--ink-muted", "light": "#736C66", "dark": "#A29A8E", "role": "pinyin / metadata text" },
        "hairline": { "css": "--hairline", "light": "#E6E1D8", "dark": "#3A352D", "role": "row separators" },
        "hairlineStrong": { "css": "--hairline-strong", "light": "#D6D0C5", "dark": "#4C463D", "role": "track-nav / input borders" },
        "jade": { "css": "--jade", "light": "#536B62", "dark": "#7FA093", "role": "brand / learning state" },
        "jadeInk": { "css": "--jade-ink", "light": "#3E554D", "dark": "#A5C0B5", "role": "jade-colored text" },
        "jadeSoft": { "css": "--jade-soft", "light": "#E7ECE8", "dark": "#27302B", "role": "light jade support surface" },
        "coral": { "css": "--coral", "light": "#E87961", "dark": "#F09380", "role": "editorial / now-here accent" },
        "coralDeep": { "css": "--coral-deep", "light": "#B84C38", "dark": "#EB8D74", "role": "coral-colored text" },
        "coralSoft": { "css": "--coral-soft", "light": "#F6E6E1", "dark": "#352621", "role": "light coral support surface" }
      },
      "typography": {
        "fontSans": { "css": "--font-sans", "value": "'Hiragino Sans', 'Noto Sans JP', 'Helvetica Neue', Arial, sans-serif", "role": "Japanese UI / body (default)" },
        "fontSerifJa": { "css": "--font-serif-ja", "value": "'Hiragino Mincho ProN', 'Yu Mincho', serif", "role": "Japanese editorial headings" },
        "fontSerifZh": { "css": "--font-serif-zh", "value": "'Songti TC', 'Songti SC', 'Hiragino Mincho ProN', serif", "role": "Chinese learning text (deliberate serif role)" }
      },
      "spacing": {
        "sp1": { "css": "--sp-1", "value": "4px", "role": "inline / between elements" },
        "sp2": { "css": "--sp-2", "value": "8px", "role": "inline / between elements" },
        "sp3": { "css": "--sp-3", "value": "12px", "role": "between elements" },
        "sp4": { "css": "--sp-4", "value": "16px", "role": "between elements" },
        "sp5": { "css": "--sp-5", "value": "20px", "role": "between elements / inside cards" },
        "sp6": { "css": "--sp-6", "value": "24px", "role": "between elements / inside cards" },
        "sp7": { "css": "--sp-7", "value": "28px", "role": "mobile page horizontal padding" },
        "sp8": { "css": "--sp-8", "value": "32px", "role": "section spacing / around headings" },
        "sp10": { "css": "--sp-10", "value": "40px", "role": "section spacing" },
        "sp12": { "css": "--sp-12", "value": "48px", "role": "section spacing" }
      },
      "radius": {
        "radiusChip": { "css": "--radius-chip", "value": "6px", "role": "small chips" },
        "radiusControl": { "css": "--radius-control", "value": "8px", "role": "buttons / inputs" },
        "radiusContent": { "css": "--radius-content", "value": "10px", "role": "soft blocks / small imagery" },
        "radiusCard": { "css": "--radius-card", "value": "12px", "role": "genuine object cards (flashcard)" },
        "radiusHero": { "css": "--radius-hero", "value": "16px", "role": "exceptional hero / editorial surface" },
        "circle": { "value": "50%", "role": "brand mark and true dots only" }
      }
    },
    "legacyCompatibility": {
      "description": "Transitional aliases role-mapped to A1 values (Issue #393). Kept so not-yet-migrated surface scoped styles keep functioning with the A1 visual language; removed surface by surface in #394–#397. Do not use in new surface code.",
      "colorAliases": {
        "--color-page / --c-bg": "var(--paper)",
        "--color-surface / --c-surface": "#ffffff (light) / var(--paper-deep) (dark)",
        "--color-text / --c-text": "var(--ink)",
        "--color-text-secondary / --c-text-secondary": "var(--ink-secondary)",
        "--color-text-muted / --c-text-muted": "var(--ink-muted)",
        "--color-primary / --c-primary": "var(--jade)",
        "--color-primary-soft / --c-primary-light / --c-slot-bg": "var(--jade-soft)",
        "--color-accent / --c-accent / --c-accent-hover": "var(--coral)",
        "--color-accent-soft / --c-accent-light": "var(--coral-soft)",
        "--color-route / --c-route-line": "var(--hairline-strong)",
        "--color-border / --c-border": "var(--hairline)",
        "--color-success / --c-success": "var(--jade)",
        "--color-success-soft / --c-success-bg": "var(--jade-soft)",
        "--color-error / --c-error": "#b04435 (light) / #ee8d7d (dark)",
        "--color-error-soft / --c-error-bg": "#f5e8e4 (light) / #3a2222 (dark)",
        "--color-header": "var(--paper)",
        "--color-header-text": "var(--ink)",
        "--color-header-muted": "var(--ink-muted)",
        "--color-on-primary / --color-on-status": "#ffffff (light) / #11141c (dark)",
        "--color-status-current": "var(--jade-ink)",
        "--color-status-success": "var(--jade-ink)",
        "--color-focus": "var(--jade) (light) / var(--coral) (dark)"
      },
      "typographyAliases": {
        "--font-ja": "var(--font-sans)",
        "--font-zh": "var(--font-serif-zh)",
        "--font-pinyin": "var(--font-sans)"
      },
      "radiusAlias": {
        "--radius": "4px — legacy micro-radius (#365/#366), superseded by the A1 semantic radius scale; retained transitional value only, not the final semantic radius system"
      },
      "spacingAliases": {
        "--space-xs / --space-sm / --space-md / --space-lg / --space-xl / --space-2xl / --space-3xl": "legacy rem values retained for not-yet-migrated surfaces; new work uses --sp-*",
        "--max-w": "48rem (baseline) / 80rem (theme-enabled); per-surface max widths (Home 880 / Study 720 / Lesson 760) are surface-owned"
      }
    }
  },
  "themeMechanism": {
    "storageKey": "chabiko_theme",
    "type": "light | dark",
    "scope": "production learner routes: Dashboard (/), lessons, 台湾旅行 paths, 先生厳選単語 (study/catalog/detail/quiz), HSK, phrasebook, tone/word-order practice, kanji-bridge. Error/auth/internal-preview routes stay opt-out.",
    "detection": "inline <script> in BaseLayout.astro reads localStorage first, falls back to prefers-color-scheme",
    "activation": "data-theme-enabled=\"true\" on <html>, data-theme=\"light|dark\"",
    "cssSelector": ":root[data-theme-enabled='true'][data-theme='dark']",
    "optIn": "themeEnabled prop on BaseLayout.astro; default false, enabled consistently on all learner routes (#366)",
    "source": [
      "src/layouts/BaseLayout.astro (inline detection)",
      "src/lib/theme.ts (resolveTheme, getNextTheme, THEME_STORAGE_KEY)",
      "tests/theme-preference.test.ts (unit tests)"
    ]
  },
  "aliasValidation": {
    "allAliasesResolve": true,
    "noCycles": true,
    "aliasMap": {
      "--c-bg": "--color-page",
      "--c-surface": "--color-surface",
      "--c-text": "--color-text",
      "--c-text-secondary": "--color-text-secondary",
      "--c-text-muted": "--color-text-muted",
      "--c-primary": "--color-primary",
      "--c-primary-light": "--color-primary-soft",
      "--c-accent": "--color-accent",
      "--c-accent-light": "--color-accent-soft",
      "--c-route-line": "--color-route",
      "--c-border": "--color-border",
      "--c-success": "--color-success",
      "--c-success-bg": "--color-success-soft",
      "--c-error": "--color-error",
      "--c-error-bg": "--color-error-soft",
      "--c-slot-bg": "var(--c-primary-light)"
    }
  },
  "migrationState": {
    "session1": "Issue #393 — A1 foundation deployed: semantic tokens, base text defaults, Header (A1 brand row), Breadcrumb (demoted), TrackNav (hairline + jade underline). Legacy aliases retained as documented transitional layer.",
    "notYetMigrated": [
      "Home (#394)",
      "先生厳選単語 (#395)",
      "台湾旅行 (#396)",
      "auxiliary / phrasebook / kanji-bridge / tone / word-order (#397)",
      "HSK hub (#377)"
    ],
    "rule": "New surface code must use A1 semantic tokens. Legacy aliases are frozen transitional, not a parallel design system; they are removed as each surface migrates."
  }
}
