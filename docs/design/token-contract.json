          ".practice-feedback.feedback-visible--incorrect"
        ],
        "pointer": "#/tokens/color/errorSoft"
      },
      "header": {
        "css": "--color-header",
        "alias": null,
        "light": "#1a2744",
        "dark": "#161f34",
        "role": "site header background",
        "usedIn": [
          ".site-header"
        ],
        "note": "No --c-* alias; header-specific semantic only",
        "pointer": "#/tokens/color/header"
      },
      "headerText": {
        "css": "--color-header-text",
        "alias": null,
        "light": "#ffffff",
        "dark": "#f6f2ea",
        "role": "site header text / controls",
        "usedIn": [
