{
  "id": "https://chabiko.dev/docs/design/token-contract.json",
  "title": "Chabiko Design Token Contract",
  "description": "Production semantic tokens from BaseLayout.astro — PR #165, commit 04759286 on main",
  "source": "src/layouts/BaseLayout.astro:50-130",
