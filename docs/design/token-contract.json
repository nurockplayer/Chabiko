        ],
        "note": "Matches --c-primary in light; warm gold in dark for contrast",
        "pointer": "#/tokens/color/focus"
      },
      "slotBackground": {
        "css": "--c-slot-bg",
        "aliasRef": "#/tokens/color/primarySoft",
        "light": "var(--c-primary-light)",
        "dark": "var(--c-primary-light)",
        "role": "alias, not an independent token",
        "note": "Defined as var(--c-primary-light); resolves to --color-primary-soft per theme",
        "pointer": "#/tokens/color/slotBackground"
      }
    },
    "typography": {
      "fontZh": {
        "css": "--font-zh",
        "value": "'PingFang TC', 'Noto Sans TC', 'Hiragino Sans', sans-serif",
        "role": "Traditional Chinese content",
        "appliedWhere": [
          "[lang='zh-Hant']",
          ".core-sentence",
          ".lesson-example",
          ".example-sentence",
          ".route-example"
        ],
        "pointer": "#/tokens/typography/fontZh"
      },
      "fontJa": {
        "css": "--font-ja",
        "value": "'Hiragino Sans', 'Noto Sans JP', 'Helvetica Neue', Arial, sans-serif",
        "role": "Japanese UI / body text (default)",
        "appliedWhere": [
          "body"
        ],
        "pointer": "#/tokens/typography/fontJa"
      },
      "fontPinyin": {
        "css": "--font-pinyin",
        "value": "'Hiragino Sans', 'Noto Sans', 'Helvetica Neue', Arial, sans-serif",
        "role": "Pinyin romanization",
        "appliedWhere": [
          "[lang='zh-Latn']",
          ".core-pinyin",
          ".lesson-pinyin",
          ".pinyin"
        ],
        "pointer": "#/tokens/typography/fontPinyin"
      }
    },
    "spacing": {
      "radius": {
        "css": "--radius",
        "value": "0",
        "role": "card / container border radius (zero = no rounding)",
        "note": "Direction C uses no border-radius on cards and general containers. Circular exceptions (border-radius: 50%) apply to: brand-mark, station/route-station/pending dots, lesson-marker, practice-choice__indicator, feedback-icon, practice-complete-icon.",
        "pointer": "#/tokens/spacing/radius"
      },
      "xs": {
        "css": "--space-xs",
        "value": "0.25rem",
        "pointer": "#/tokens/spacing/xs"
      },
      "sm": {
        "css": "--space-sm",
        "value": "0.5rem",
        "pointer": "#/tokens/spacing/sm"
      },
      "md": {
        "css": "--space-md",
        "value": "1rem",
        "pointer": "#/tokens/spacing/md"
      },
      "lg": {
        "css": "--space-lg",
        "value": "1.5rem",
        "pointer": "#/tokens/spacing/lg"
      },
      "xl": {
        "css": "--space-xl",
        "value": "2rem",
        "pointer": "#/tokens/spacing/xl"
      },
      "2xl": {
        "css": "--space-2xl",
        "value": "3rem",
        "pointer": "#/tokens/spacing/2xl"
      },
      "3xl": {
        "css": "--space-3xl",
        "value": "4rem",
        "pointer": "#/tokens/spacing/3xl"
      },
      "maxWidth": {
        "css": "--max-w",
        "value": "80rem",
        "role": "content area max width",
        "pointer": "#/tokens/spacing/maxWidth"
      }
    }
  },
  "themeMechanism": {
    "storageKey": "chabiko_theme",
    "type": "light | dark",
    "scope": "production home and lesson routes only",
    "detection": "inline <script> in BaseLayout.astro reads localStorage first, falls back to prefers-color-scheme",
    "activation": "data-theme-enabled=\"true\" on <html>, data-theme=\"light|dark\"",
    "cssSelector": ":root[data-theme-enabled='true'][data-theme='dark']",
    "optIn": "themeEnabled prop on BaseLayout.astro; default false",
    "source": [
      "src/layouts/BaseLayout.astro:32-49 (inline detection)",
      "src/lib/theme.ts:1-15 (resolveTheme, getNextTheme, THEME_STORAGE_KEY)",
      "tests/theme-preference.test.ts:19-49 (unit tests)"
    ]
  },
  "aliasValidation": {
    "allAliasesResolve": true,
    "noCycles": true,
    "aliasMap": {
      "--c-bg": "--color-page",
      "--c-surface": "--color-surface",
      "--c-text": "--color-text",
      "--c-text-secondary": "--color-text-secondary",
      "--c-text-muted": "--color-text-muted",
      "--c-primary": "--color-primary",
      "--c-primary-light": "--color-primary-soft",
      "--c-accent": "--color-accent",
      "--c-accent-light": "--color-accent-soft",
      "--c-route-line": "--color-route",
      "--c-border": "--color-border",
      "--c-success": "--color-success",
      "--c-success-bg": "--color-success-soft",
      "--c-error": "--color-error",
      "--c-error-bg": "--color-error-soft",
      "--c-slot-bg": "var(--c-primary-light)"
    }
  }
}
