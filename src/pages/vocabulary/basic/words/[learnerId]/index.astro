---
import type { GetStaticPaths } from 'astro';
import Header from '../../../../../components/Header.astro';
import Breadcrumb from '../../../../../components/Breadcrumb.astro';
import BasicVocabularyDetail from '../../../../../components/vocabulary/BasicVocabularyDetail.astro';
import {
  toBasicVocabularyDetailItem,
  type BasicVocabularyDetailItem,
} from '../../../../../content/basicVocabularyDetail';
import { loadProductionLearnerCorpus } from '../../../../../content/loadProductionLearnerCorpus';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';

/** Stable detail route keyed by the opaque learner ID, generated once from the
 * canonical production learner corpus. Each page renders only that item's
 * approved learner data (including the #340 example, when present). */
export const getStaticPaths = (() => {
  const corpus = loadProductionLearnerCorpus();
  return corpus.map((item) => ({
    params: { learnerId: item.learnerId },
    props: { item: toBasicVocabularyDetailItem(item) },
  }));
}) satisfies GetStaticPaths;

const { item } = Astro.props as { item: BasicVocabularyDetailItem };
---

<BaseLayout title={item.simplified} themeEnabled>
  <Fragment slot="header">
    <Header themeEnabled />
  </Fragment>

  <div
    class="basic-vocabulary-detail-page"
    data-basic-vocabulary-detail-page
    data-learner-id={item.learnerId}
  >
    <Breadcrumb
      crumbs={[
        { label: 'ホーム', href: '/' },
        { label: '先生厳選単語', href: '/vocabulary/basic/' },
        { label: '単語一覧', href: '/vocabulary/basic/words/' },
        { label: item.simplified },
      ]}
    />
    <BasicVocabularyDetail item={item} />
  </div>
</BaseLayout>

<script>
  import {
    BASIC_VOCABULARY_CATALOG_PATH,
    sanitizeBasicVocabularyCatalogReturnTarget,
  } from '../../../../../domain/basicVocabularyCatalogState';

  function initialiseCatalogReturn(): void {
    const rawTarget = new URL(window.location.href).searchParams.get('from');
    document.querySelectorAll<HTMLElement>('[data-basic-vocabulary-detail-page]')
      .forEach((root) => {
        const learnerId = root.dataset.learnerId;
        if (learnerId === undefined) return;
        const returnTarget = sanitizeBasicVocabularyCatalogReturnTarget(
          rawTarget,
          learnerId,
        );
        const explicitReturn = root.querySelector<HTMLAnchorElement>(
          '.basic-vocabulary-detail-back a',
        );
        if (explicitReturn) {
          explicitReturn.href = returnTarget;
          explicitReturn.textContent = returnTarget === BASIC_VOCABULARY_CATALOG_PATH
            ? '単語一覧に戻る'
            : '単語一覧の元の位置に戻る';
        }
        root.querySelectorAll<HTMLAnchorElement>(
          `a[href="${BASIC_VOCABULARY_CATALOG_PATH}"]`,
        ).forEach((link) => {
          link.href = returnTarget;
        });
      });
  }

  initialiseCatalogReturn();
  document.addEventListener('astro:page-load', initialiseCatalogReturn);
</script>

<style>
  .basic-vocabulary-detail-page {
    width: min(100%, 45rem);
    margin: 0 auto;
  }
</style>
