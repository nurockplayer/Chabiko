---
import Header from '../../../components/Header.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import TrackNav from '../../../components/TrackNav.astro';
import BasicVocabularyAccount from '../../../components/vocabulary/BasicVocabularyAccount.astro';
import BasicVocabularySession from '../../../components/vocabulary/BasicVocabularySession.astro';
import { buildLearnerSessionPayload, serializeLearnerSessionPayload } from '../../../content/learnerSessionPayload';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const payload = buildLearnerSessionPayload();
const payloadJson = serializeLearnerSessionPayload(payload);

if (payload.totalCount === 0) {
  throw new Error('basic vocabulary has no provisional items');
}
---

<BaseLayout title="イラストで学ぶ基礎中国語" themeEnabled>
  <Fragment slot="header">
    <Header themeEnabled />
  </Fragment>

  <div class="basic-vocabulary-page">
    <Breadcrumb
      crumbs={[
        { label: 'ホーム', href: '/' },
        { label: '先生厳選単語', href: '/vocabulary/basic/' },
        { label: '学ぶ' },
      ]}
    />
    <TrackNav
      label="先生厳選単語"
      items={[
        { label: '学ぶ', href: '/vocabulary/basic/', current: true },
        { label: '単語一覧', href: '/vocabulary/basic/words/' },
        { label: 'テスト', href: '/vocabulary/basic/quiz/' },
      ]}
    />
    <h1>イラストで学ぶ基礎中国語</h1>
    <p class="basic-vocabulary-page__catalog-link-row">
      <a class="basic-vocabulary-page__catalog-link" href="/vocabulary/basic/words/">単語一覧を見る</a>
    </p>
    <p class="basic-vocabulary-page__quiz-link-row">
      <a class="basic-vocabulary-page__quiz-link" href="/vocabulary/basic/quiz/">絵なしテスト</a>
    </p>
    <BasicVocabularyAccount />
    <BasicVocabularySession payload={payload} payloadJson={payloadJson} />
  </div>
</BaseLayout>

<style>
  .basic-vocabulary-page {
    width: min(100%, 45rem);
    margin: 0 auto;
  }

  h1 {
    margin: 0 0 var(--sp-8);
    font-family: var(--font-serif-ja);
    color: var(--ink);
    font-size: 1.75rem;
    font-weight: 700;
  }

  .basic-vocabulary-page__catalog-link-row {
    margin: 0 0 var(--sp-6);
  }

  .basic-vocabulary-page__catalog-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--sp-2) var(--sp-6);
    background: transparent;
    color: var(--jade-ink);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    border: 2px solid transparent;
  }
  .basic-vocabulary-page__catalog-link:hover {
    background: var(--jade-soft);
    color: var(--jade-ink);
    text-decoration: underline;
  }
  .basic-vocabulary-page__catalog-link:focus-visible {
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px var(--coral-soft);
  }

  .basic-vocabulary-page__quiz-link-row {
    margin: 0 0 var(--sp-6);
  }

  .basic-vocabulary-page__quiz-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--sp-2) var(--sp-6);
    background: transparent;
    color: var(--jade-ink);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    border: 2px solid transparent;
  }
  .basic-vocabulary-page__quiz-link:hover {
    background: var(--jade-soft);
    color: var(--jade-ink);
    text-decoration: underline;
  }
  .basic-vocabulary-page__quiz-link:focus-visible {
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px var(--coral-soft);
  }
</style>
