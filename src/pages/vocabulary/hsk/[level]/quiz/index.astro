---
import Header from '../../../../../components/Header.astro';
import TrackNav from '../../../../../components/TrackNav.astro';
import HskLevelLinks from '../../../../../components/HskLevelLinks.astro';
import HskQuiz from '../../../../../components/HskQuiz.astro';
import { loadHskPublication, type HskSourceNotice } from '../../../../../content/loadHskVocabulary';
import type { HskLevelPool } from '../../../../../domain/hskLevelPool';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';

interface Props { pool: HskLevelPool; sourceNotice: HskSourceNotice | null }
export function getStaticPaths() {
  const { pools, sourceNotice } = loadHskPublication();
  return pools.map((pool) => ({ params: { level: String(pool.level) }, props: { pool, sourceNotice } }));
}
const { pool, sourceNotice } = Astro.props;
const level = pool.level;
const title = `HSK ${level} 単語テスト`;
---
<BaseLayout title={title} themeEnabled>
  <Fragment slot="header"><Header themeEnabled /></Fragment>
  <div class="hsk-quiz-page">
    <a class="back-link" href={`/vocabulary/hsk/${level}/`}>← HSK {level}の学習に戻る</a>
    <TrackNav label={`HSK ${level}`} items={[
      { label: '学ぶ', href: `/vocabulary/hsk/${level}/` },
      { label: 'テスト', href: `/vocabulary/hsk/${level}/quiz/`, current: true },
    ]} />
    <h1>{title}</h1>
    <p class="availability-note">日本語訳はAIによる下書きで、先生による確認前の内容です。</p>
    <p class="availability-note">単語の理解度を確かめる練習です。公式HSK試験の得点ではありません。最高得点は正答率で比較し、このブラウザに保存します。</p>
    {pool.status === 'unavailable' || pool.fullRange.length === 0 ? (
      <section><h2>準備中</h2><p>このレベルのテストは、単語の公開後に利用できます。</p></section>
    ) : (
      <>
        {pool.status === 'partial' && <p class="availability-note">一部の公開済み単語から出題します。</p>}
        <HskQuiz level={level} ids={pool.fullRange.map((entry) => entry.id)} answerSource={`/data/hsk/${level}.json`} />
      </>
    )}
    {sourceNotice && (
      <aside class="source-notice" aria-label="単語データの出典とライセンス">
        <p><a href={sourceNotice.sourceUrl} rel="noreferrer">{sourceNotice.attribution}</a></p>
        <p>ライセンス: <a href={sourceNotice.licenseUrl} rel="noreferrer">{sourceNotice.license}</a></p>
        <p><a href={sourceNotice.provenanceUrl} rel="noreferrer">出典と独立性について</a></p>
        <p><a href={sourceNotice.disclaimerUrl} rel="noreferrer">免責事項</a></p>
        <p>HearMandarinの簡体字・ピンイン・HSKレベルを使用し、日本語訳を独自に追加しています。</p>
      </aside>
    )}
    <HskLevelLinks showQuizScores />
  </div>
</BaseLayout>
<style>
  .hsk-quiz-page { max-width: 40rem; min-width: 0; margin: 0 auto; overflow-wrap: anywhere; }
  h1 { font-family: var(--font-serif-ja); font-size: 1.75rem; line-height: 1.3; margin-bottom: var(--sp-4); }
  .back-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--jade-ink); margin-bottom: var(--sp-4); }
  a:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .availability-note { color: var(--ink-secondary); margin-bottom: var(--sp-4); font-size: 0.875rem; }
  .source-notice { margin-top: var(--sp-8); padding: var(--sp-4); border-top: 1px solid var(--hairline); color: var(--ink-secondary); font-size: 0.8rem; }
  .source-notice p + p { margin-top: var(--sp-2); }
  .source-notice a { color: var(--jade-ink); text-decoration: underline; text-underline-offset: 0.15em; }
</style>
