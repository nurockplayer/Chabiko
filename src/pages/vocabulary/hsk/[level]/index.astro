---
import Header from '../../../../components/Header.astro';
import FlashcardSession from '../../../../components/FlashcardSession.astro';
import { loadHskPublication } from '../../../../content/loadHskVocabulary';
import type { HskLevelPool } from '../../../../domain/hskLevelPool';
import type { HskSourceNotice } from '../../../../content/loadHskVocabulary';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

interface Props {
  level: 1 | 2 | 3 | 4;
  pool: HskLevelPool;
  sourceNotice: HskSourceNotice | null;
}

export function getStaticPaths() {
  const { pools, sourceNotice } = loadHskPublication();
  return pools.map((pool) => ({
    params: { level: String(pool.level) },
    props: { level: pool.level, pool, sourceNotice },
  }));
}

const { level, pool, sourceNotice } = Astro.props;
const entries = pool.status === 'unavailable' ? [] : pool.fullRange;
const title = `HSK ${level} 単語フラッシュカード`;
---

<BaseLayout title={title} themeEnabled>
  <Fragment slot="header">
    <Header themeEnabled />
  </Fragment>

  <div class="flashcard-page">
    <a class="back-link" href="/">← ホームに戻る</a>
    <h1 class="page-title">{title}</h1>
    <p class="page-subtitle">簡体字を見て、ピンインと日本語の意味を確認しよう。</p>

    {pool.status === 'unavailable' || entries.length === 0 ? (
      <section class="empty-fallback" aria-labelledby="preparing-title">
        <h2 id="preparing-title">準備中</h2>
        <p>このレベルの単語は、公開できる状態になり次第追加します。</p>
      </section>
    ) : (
      <>
        {pool.status === 'partial' && (
          <p class="availability-note" role="status">一部の単語を公開中です。</p>
        )}
        <FlashcardSession level={level} entries={entries.map((entry) => ({
          id: entry.id,
          simplified: entry.simplified,
          pinyin: entry.pinyin,
          japanese: entry.japanese,
        }))} newPoolIds={pool.newWords.map((entry) => entry.id)}
          answerSource={`/data/hsk/${level}.json`} />
        {sourceNotice && (
          <aside class="source-notice" aria-label="単語データの出典とライセンス">
            <p><a href={sourceNotice.sourceUrl} rel="noreferrer">{sourceNotice.attribution}</a></p>
            <p>ライセンス: <a href={sourceNotice.licenseUrl} rel="noreferrer">{sourceNotice.license}</a></p>
            <p><a href={sourceNotice.provenanceUrl} rel="noreferrer">出典と独立性について</a></p>
            <p><a href={sourceNotice.disclaimerUrl} rel="noreferrer">免責事項</a></p>
            <p>{sourceNotice.modificationNotice}</p>
          </aside>
        )}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .flashcard-page {
    max-width: 40rem;
    margin: 0 auto;
    min-width: 0;
  }
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-lg);
    color: var(--jade-ink);
    font-weight: 600;
    min-height: 44px;
    align-content: center;
  }
  .back-link:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .page-title {
    font-family: var(--font-serif-ja);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: var(--sp-1);
    overflow-wrap: anywhere;
  }
  .page-subtitle {
    font-size: 0.85rem;
    color: var(--ink-secondary);
    margin-bottom: var(--sp-8);
  }
  .empty-fallback {
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-content);
    padding: var(--sp-8);
    text-align: center;
    color: var(--ink-secondary);
    overflow-wrap: anywhere;
  }
  .empty-fallback h2 {
    font-family: var(--font-serif-ja);
    color: var(--ink);
  }
  .availability-note {
    color: var(--ink-secondary);
    margin-bottom: var(--sp-4);
  }
  .source-notice {
    margin-top: var(--sp-8);
    padding: var(--sp-4);
    border-top: 1px solid var(--hairline);
    color: var(--ink-secondary);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }
  .source-notice p + p { margin-top: var(--sp-2); }
  .source-notice a {
    color: var(--jade-ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
