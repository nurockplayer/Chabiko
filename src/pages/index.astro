---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { ACHIEVEMENT_CATALOG } from '../domain/achievements';
import {
  buildBasicVocabularyTrackSummary,
  buildCrossTrackProgressSnapshot,
  buildHskTrackSummary,
  buildTaiwanTravelTrackSummary,
} from '../domain/crossTrackProgress';
import {
  buildDashboardProgressPayload,
  serializeDashboardProgressPayload,
} from '../content/dashboardPayload';
import {
  DASHBOARD_TRACK_DESCRIPTIONS,
  DASHBOARD_TRACK_LABELS,
  DASHBOARD_TRACK_ORDER,
  deriveContinuation,
  trackCardStatusKey,
  trackCardStatusLabel,
  trackDestinationHref,
  trackSummaryText,
} from '../domain/dashboardProgress';

// Build-time reference payload for the #372 coordinator: the exact production
// corpora (basic-vocabulary learner ids, HSK levels, Taiwan completable
// lessons + display metadata) it may count against. The client injects this
// into the cross-track coordinator exactly like the /paths/ route payload.
const payload = buildDashboardProgressPayload();
const payloadJson = serializeDashboardProgressPayload(payload);

// Initial SSR snapshot: no progress signals (storage is client-only), so every
// track renders its fixed denominator at zero — the truthful state a fresh
// learner sees. The client re-derives the snapshot from real storage via the
// same pure functions, so SSR and hydrated markup are identical.
const initialSnapshot = buildCrossTrackProgressSnapshot({
  basicVocabulary: buildBasicVocabularyTrackSummary({
    progress: {},
    corpusIds: new Set(payload.basicVocabularyCorpusIds),
    scope: { kind: 'guest' },
  }),
  hsk: buildHskTrackSummary({ progress: {}, levels: payload.hskLevels }),
  taiwanTravel: buildTaiwanTravelTrackSummary({
    completedLessonIds: new Set(),
    completableLessonIds: payload.taiwanCompletableLessonIds,
  }),
});
const initialContinuation = deriveContinuation(
  initialSnapshot,
  payload,
  new Set(),
);
---

<BaseLayout title="ホーム" description="Chabiko の学習ダッシュボードです。" themeEnabled>
  <Fragment slot="header">
    <Header themeEnabled />
  </Fragment>

  <div class="dashboard" data-dashboard-root>
    <h1 class="page-title">今日の学習</h1>
    <p class="page-lead">次に学ぶことを選んで、今日も続けましょう。</p>

    <!-- Continuation · featured spread (coral = "now here") -->
    <section
      class="section"
      id="continuation"
      aria-labelledby="continuation-heading"
    >
      <div class="section-head">
        <h2 id="continuation-heading">続きを学ぶ</h2>
        <span class="en">CONTINUE</span>
      </div>
      <a
        class="featured"
        data-dashboard-continuation
        href={initialContinuation.href ?? undefined}
        hidden={initialContinuation.href === null}
      >
        <p class="featured-kicker">
          <span>続きから</span>
          <span class="sub" data-continuation-kicker>
            {initialContinuation.trackId
              ? DASHBOARD_TRACK_LABELS[initialContinuation.trackId]
              : ''}
          </span>
        </p>
        <p
          class="featured-sentence"
          lang="zh-Hant"
          data-continuation-sentence
          hidden={initialContinuation.sentence === null}
        >{initialContinuation.sentence}</p>
        <p
          class="featured-pinyin"
          lang="zh-Latn"
          data-continuation-pinyin
          hidden={initialContinuation.pinyin === null}
        >{initialContinuation.pinyin}</p>
        <h3 class="featured-title" data-continuation-title>
          {initialContinuation.title}
        </h3>
        <span class="featured-action featured-action--primary">
          <span data-continuation-action>{initialContinuation.actionLabel}</span>
          <span class="arr" aria-hidden="true">→</span>
        </span>
      </a>
      <div
        class="featured featured--empty"
        data-dashboard-continuation-empty
        hidden={initialContinuation.href !== null}
      >
        <span class="featured-title" data-continuation-empty-title>
          {initialContinuation.title}
        </span>
      </div>
    </section>

    <!-- Courses · typographic index -->
    <section class="section" id="courses" aria-labelledby="courses-heading">
      <div class="section-head">
        <h2 id="courses-heading">学習コース</h2>
        <span class="en">COURSES</span>
      </div>
      <ol class="track-list">
        {DASHBOARD_TRACK_ORDER.map((trackId, index) => {
          const label = DASHBOARD_TRACK_LABELS[trackId];
          const description = DASHBOARD_TRACK_DESCRIPTIONS[trackId];
          const href = trackDestinationHref(
            trackId,
            initialSnapshot,
            payload,
            new Set(),
          );
          const statusKey = trackCardStatusKey(trackId, initialSnapshot, payload);
          const statusText = trackCardStatusLabel(trackId, initialSnapshot, payload);
          const summaryText = trackSummaryText(trackId, initialSnapshot, payload);
          const trackIndex = String(index + 1).padStart(2, '0');
          return (
            <li class="track-list-item">
              {href !== null ? (
                <a
                  class="track-row track-row--available"
                  data-dashboard-track={trackId}
                  href={href}
                >
                  <span class="track-index" aria-hidden="true">{trackIndex}</span>
                  <span class="track-body">
                    <span class="track-name">{label}</span>
                    <span class="track-desc">{description}</span>
                    <span class="track-meta">
                      <span class="track-summary" data-track-summary>
                        {summaryText}
                      </span>
                      <span
                        class="track-status"
                        data-track-status
                        data-status={statusKey}
                      >{statusText}</span>
                    </span>
                  </span>
                  <span class="track-arrow" aria-hidden="true">→</span>
                </a>
              ) : (
                <div
                  class="track-row track-row--unavailable"
                  data-dashboard-track={trackId}
                >
                  <span class="track-index" aria-hidden="true">{trackIndex}</span>
                  <span class="track-body">
                    <span class="track-name">{label}</span>
                    <span class="track-desc">{description}</span>
                    <span class="track-meta">
                      <span class="track-summary" data-track-summary>
                        {summaryText}
                      </span>
                      <span
                        class="track-status"
                        data-track-status
                        data-status={statusKey}
                      >{statusText}</span>
                    </span>
                  </span>
                </div>
              )}
            </li>
          );
        })}
      </ol>
    </section>

    <!-- Milestones -->
    <section
      class="section"
      id="achievements"
      aria-labelledby="achievements-heading"
    >
      <div class="section-head">
        <h2 id="achievements-heading">実績</h2>
        <span class="en">MILESTONES</span>
      </div>
      <ol class="ach-list" data-achievement-list>
        {ACHIEVEMENT_CATALOG.map((achievement) => (
          <li class="ach-item" data-achievement={achievement.id} hidden>
            <span class="ach-check" aria-hidden="true">✓</span>
            <span class="ach-body">
              <span class="ach-title">{achievement.title}</span>
              <span class="ach-desc">{achievement.description}</span>
            </span>
          </li>
        ))}
      </ol>
      <p class="achievement-empty" data-achievement-empty>
        まだ実績がありません。学習を始めると、ここにマイルストーンが表示されます。
      </p>
      <a class="dashboard-paths-link" href="/paths/">
        学習ルート一覧
        <span class="paths-arrow" aria-hidden="true">→</span>
      </a>
    </section>

    <div class="dashboard-footer">
      <span class="copy-note">Chabiko ・ チャビコ</span>
      <button id="reset-progress-btn" class="reset-btn" type="button">
        進捗をリセット
      </button>
    </div>
  </div>

  <script is:inline type="application/json" id="dashboard-progress-data" set:html={payloadJson}></script>
</BaseLayout>

<script>
  import { initDashboard } from '../client/dashboardProgress';
  import type { DashboardProgressPayload } from '../domain/dashboardProgress';

  const root = document.querySelector<HTMLElement>('[data-dashboard-root]');
  if (root) {
    const script = document.getElementById('dashboard-progress-data');
    let payload: DashboardProgressPayload | null = null;
    if (script?.textContent) {
      try {
        const parsed = JSON.parse(script.textContent) as unknown;
        if (
          parsed !== null &&
          typeof parsed === 'object' &&
          Array.isArray(
            (parsed as { basicVocabularyCorpusIds?: unknown })
              .basicVocabularyCorpusIds,
          )
        ) {
          payload = parsed as DashboardProgressPayload;
        }
      } catch {
        // Malformed payload: leave the SSR fresh state intact.
      }
    }
    if (payload) {
      initDashboard(root, payload);
    }
  }
</script>

<style>
  /* BaseLayout's global `*` reset is scoped to BaseLayout's own elements and
   * does not reach this page's rendered content, so restore border-box sizing
   * and zero list defaults here (the pre-Dashboard home had the same need). */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  /* Author display rules (e.g. `.featured { display: block }`,
   * `.ach-item { display: flex }`) would otherwise override the UA
   * `[hidden] { display: none }` rule; this guard keeps the hydration `hidden`
   * contract authoritative. */
  [hidden] {
    display: none !important;
  }
  .dashboard {
    width: min(100%, 880px);
    margin: 0 auto;
  }
  .page-title {
    font-family: var(--font-serif-ja);
    font-size: 33px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .page-lead {
    margin-top: var(--sp-2);
    font-size: 13px;
    line-height: 1.8;
    color: var(--ink-secondary);
  }

  /* ── Section header · typographic ── */
  .section {
    margin-top: var(--sp-10);
    min-width: 0;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--ink);
  }
  .section-head h2 {
    font-family: var(--font-serif-ja);
    font-size: 19px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .section-head .en {
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--ink-muted);
  }

  /* ── Continuation · featured spread ── */
  .featured {
    display: block;
    margin-top: var(--sp-6);
    border-top: 2px solid var(--coral);
    padding-top: var(--sp-5);
    color: var(--ink);
    text-decoration: none;
    min-width: 0;
  }
  .featured:hover {
    text-decoration: none;
  }
  .featured:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 6px;
  }
  .featured-kicker {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--jade-ink);
    font-weight: 700;
  }
  .featured-kicker .sub {
    color: var(--ink-muted);
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  .featured-sentence {
    margin-top: var(--sp-4);
    font-family: var(--font-serif-zh);
    font-size: 46px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  .featured-pinyin {
    margin-top: var(--sp-2);
    font-size: 14px;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
  }
  .featured-title {
    margin-top: var(--sp-5);
    font-family: var(--font-serif-ja);
    font-size: 21px;
    font-weight: 700;
    color: var(--ink);
  }
  .featured-action {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    margin-top: var(--sp-5);
    padding: var(--sp-2) var(--sp-4);
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .featured-action--primary {
    border: 1px solid var(--coral-deep);
    border-radius: var(--radius-control);
    background: var(--coral-deep);
    color: var(--color-on-primary);
  }
  .featured:hover .featured-action--primary {
    border-color: var(--coral-deep);
    background: var(--coral-deep);
    box-shadow: 0 0 0 2px var(--coral-soft);
  }
  .featured:active .featured-action--primary {
    background: var(--coral-deep);
    box-shadow: inset 0 1px 0 rgb(0 0 0 / 0.18);
  }
  .featured-action .arr {
    font-size: 15px;
  }
  .featured--empty {
    border-top-color: var(--hairline-strong);
  }
  .featured--empty .featured-title {
    font-size: 15px;
    color: var(--ink-secondary);
  }

  /* ── Courses · typographic rows ── */
  .track-list {
    list-style: none;
  }
  .track-list-item {
    min-width: 0;
  }
  .track-row {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .track-row--available {
    padding: var(--sp-4);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-content);
    background: var(--paper);
  }
  .track-row--available:hover {
    border-color: var(--jade);
    background: var(--paper);
    text-decoration: none;
  }
  .track-row--available:hover .track-name {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .track-row--available:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .track-row--available:active {
    border-color: var(--jade);
    background: var(--paper);
  }
  .track-row--available:active .track-arrow {
    background: var(--jade-soft);
  }
  .track-index {
    font-family: var(--font-serif-ja);
    font-size: 12px;
    font-weight: 700;
    color: var(--coral-deep);
    letter-spacing: 0.06em;
    padding-top: 3px;
    flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
  }
  .track-body {
    flex: 1;
    min-width: 0;
  }
  .track-name {
    display: block;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .track-desc {
    display: block;
    margin-top: var(--sp-1);
    font-size: 12px;
    line-height: 1.75;
    color: var(--ink-secondary);
  }
  .track-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
    font-size: 11.5px;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .track-summary {
    font-weight: 500;
  }
  .track-status {
    font-weight: 700;
    color: var(--ink-muted);
  }
  .track-status[data-status='in-progress'],
  .track-status[data-status='completed'] {
    color: var(--jade-ink);
  }
  .track-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-control);
    background: var(--paper);
    color: var(--ink-muted);
    font-size: 14px;
    flex: 0 0 auto;
  }
  .track-row--unavailable {
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--hairline);
    cursor: default;
  }
  .track-row--unavailable .track-name {
    color: var(--ink-secondary);
  }
  .track-row--unavailable .track-desc,
  .track-row--unavailable .track-summary {
    color: var(--ink-muted);
  }

  /* ── Milestones ── */
  .ach-list {
    list-style: none;
    margin-top: var(--sp-1);
  }
  .ach-item {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--hairline);
  }
  .ach-item:last-child {
    border-bottom: none;
  }
  .ach-check {
    color: var(--jade);
    font-size: 12px;
    font-weight: 700;
    flex: 0 0 auto;
  }
  .ach-body {
    min-width: 0;
  }
  .ach-title {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  .ach-desc {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    line-height: 1.7;
    color: var(--ink-muted);
  }
  .achievement-empty {
    margin-top: var(--sp-3);
    font-size: 12px;
    line-height: 1.7;
    color: var(--ink-secondary);
  }
  .dashboard-paths-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    margin-top: var(--sp-4);
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--jade);
    border-radius: var(--radius-control);
    background: var(--jade-soft);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .dashboard-paths-link:hover {
    border-color: var(--jade-ink);
    background: var(--paper-deep);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .dashboard-paths-link:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .dashboard-paths-link:active {
    background: var(--paper);
  }

  /* ── Footer · quiet ── */
  .dashboard-footer {
    margin-top: var(--sp-10);
    padding: var(--sp-4) 0 var(--sp-7);
    border-top: 1px solid var(--hairline);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  .copy-note {
    font-size: 10.5px;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
  }
  .reset-btn {
    min-height: 44px;
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-control);
    background: var(--paper);
    font-family: inherit;
    font-size: 11px;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
    cursor: pointer;
  }
  .reset-btn:hover {
    border-color: var(--coral-deep);
    background: var(--paper);
    color: var(--coral-deep);
  }
  .reset-btn:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .reset-btn:active {
    background: var(--paper-deep);
  }

  @media (width >= 1024px) {
    .section {
      margin-top: var(--sp-12);
    }
    .section-head h2 {
      font-size: 20px;
    }
    .track-row--available {
      padding: var(--sp-5);
    }
    .track-row--unavailable {
      padding: var(--sp-5) 0;
    }
  }
  @media (width <= 374px) {
    .page-title {
      font-size: 30px;
    }
    .featured-sentence {
      font-size: 40px;
    }
    .featured-title {
      font-size: 20px;
    }
    .section-head h2 {
      font-size: 18px;
    }
    .track-desc {
      font-size: 11.5px;
    }
  }
</style>