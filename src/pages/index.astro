---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import GoalPathSlot from '../components/GoalPathSlot.astro';
import { loadAllRenderableLessons, hasUsableLessonPractice } from '../content/loadLessons';

const lessons = loadAllRenderableLessons();
---

<BaseLayout title="ホーム" themeEnabled>
  <Fragment slot="header">
    <Header themeEnabled />
  </Fragment>

  {lessons.length > 0 ? (
    <div class="home-journey">
      <GoalPathSlot />
      <div class="home-content">
        <section class="path-section" id="taiwan-travel-path" aria-labelledby="path-heading">
          <header class="path-header">
            <p class="path-kicker">台湾旅行ルート</p>
            <h1 id="path-heading" class="path-heading">台湾旅行で使える中国語</h1>
            <p class="path-description">全{lessons.length}レッスン。指差し・値段・場所の順に覚えよう。</p>
          </header>
          <ol class="lesson-list">
            {lessons.map((lesson, index) => {
              const example = lesson.examples?.[0] ?? null;
              return (
                <li class="lesson-list-item" data-route-lesson={lesson.id}>
                  <span class="route-line" aria-hidden="true"></span>
                  <a class="lesson-list-link" href={`/lessons/${lesson.id}/`}>
                    <span class="lesson-marker" aria-hidden="true">
                      <span class="lesson-marker-core"></span>
                    </span>
                    <span class="lesson-info">
                      <span class="lesson-number">レッスン {index + 1}</span>
                      <span class="lesson-title">{lesson.titleJa}</span>
                      <span class="lesson-can-do">{lesson.canDoJa}</span>
                      {example && (
                        <>
                          <span class="lesson-example" lang="zh-Hant">{example.traditional}</span>
                          {example.pinyin && (
                            <span class="lesson-pinyin" lang="zh-Latn">{example.pinyin}</span>
                          )}
                        </>
                      )}
                      <span
                        class="lesson-completion-status"
                        data-lesson-id={lesson.id}
                        data-completable={hasUsableLessonPractice(lesson) ? 'true' : 'false'}
                      ></span>
                    </span>
                    <span class="lesson-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
        <div class="progress-footer">
          <span id="progress-summary" class="progress-summary" aria-live="polite"></span>
          <button id="reset-progress-btn" class="reset-btn">進捗をリセット</button>
        </div>
      </div>
    </div>
  ) : (
    <>
      <article class="fallback-message">
        <h1>レッスンを読み込めませんでした</h1>
        <p>現在レッスンコンテンツが利用できません。しばらく経ってから再度アクセスしてください。</p>
      </article>
      <GoalPathSlot />
    </>
  )}
</BaseLayout>

<script>
  import { ProgressStore } from '../lib/progress';
  import { buildProgressSnapshot, handleProgressStorageEvent } from '../lib/progressSnapshot';

  let store = new ProgressStore();

  function updateCompletionUI() {
    const statusElements = document.querySelectorAll('.lesson-completion-status');
    const entries: { id: string; completable: boolean }[] = [];
    let currentAssigned = false;
    statusElements.forEach((el) => {
      const id = el.getAttribute('data-lesson-id') ?? '';
      if (!id) return;
      const completable = el.getAttribute('data-completable') === 'true';
      const done = store.isComplete(id);
      const routeItem = el.closest('[data-route-lesson]');
      const link = routeItem?.querySelector('.lesson-list-link');
      routeItem?.classList.toggle('lesson-list-item--done', done);
      routeItem?.classList.remove('lesson-list-item--current');
      link?.removeAttribute('aria-current');

      if (done) {
        el.textContent = '✓ 完了';
        el.className = 'lesson-completion-status lesson-completion-status--done';
      } else if (!currentAssigned) {
        currentAssigned = true;
        el.textContent = '進行中';
        el.className = 'lesson-completion-status lesson-completion-status--current';
        routeItem?.classList.add('lesson-list-item--current');
        link?.setAttribute('aria-current', 'step');
      } else {
        el.textContent = 'このあと';
        el.className = 'lesson-completion-status';
      }
      entries.push({ id, completable });
    });

    const snapshot = buildProgressSnapshot(store, entries);
    const summary = document.getElementById('progress-summary');
    if (summary) {
      summary.textContent = snapshot.summaryText;
    }
  }

  function refreshUI() {
    store = new ProgressStore();
    updateCompletionUI();
  }

  updateCompletionUI();

  // Refresh on pageshow (browser back/forward navigation) — re-read localStorage
  window.addEventListener('pageshow', refreshUI);

  // Refresh when another tab writes to the Chabiko progress key
  window.addEventListener('storage', (event) => {
    handleProgressStorageEvent(event, refreshUI);
  });

  const resetBtn = document.getElementById('reset-progress-btn');
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      if (window.confirm('学習進捗をすべてリセットしますか？この操作は元に戻せません。')) {
        store.resetAll();
        updateCompletionUI();
      }
    });
  }
</script>

<style>
  .home-journey {
    display: grid;
    gap: var(--space-xl);
  }
  .home-content {
    min-width: 0;
  }
  .lesson-completion-status {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 24px;
    margin-top: var(--space-xs);
    padding: 0 var(--space-sm);
    background: var(--c-primary-light);
    color: var(--c-text-secondary);
    font-size: 0.6875rem;
    font-weight: 700;
  }
  .lesson-completion-status--done {
    color: var(--color-status-success);
    background: var(--c-success-bg);
  }
  .lesson-completion-status--current {
    color: var(--color-status-current);
    background: var(--c-accent-light);
  }
  .progress-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--c-border);
  }
  .progress-summary {
    font-size: 0.8125rem;
    color: var(--c-text-secondary);
  }
  .reset-btn {
    min-height: 44px;
    flex: 0 0 auto;
    padding: var(--space-sm) var(--space-md);
    font-size: 0.75rem;
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    color: var(--c-text-secondary);
    cursor: pointer;
  }
  .reset-btn:hover {
    border-color: var(--c-error);
    color: var(--c-error);
  }
  .fallback-message {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    padding: var(--space-xl);
    text-align: center;
  }
  .fallback-message h1 {
    font-size: 1.25rem;
    margin-bottom: var(--space-sm);
  }
  .fallback-message p {
    color: var(--c-text-secondary);
  }
  .path-section {
    min-width: 0;
  }
  .path-header {
    margin-bottom: var(--space-xl);
  }
  .path-kicker {
    color: var(--c-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }
  h1.path-heading {
    font-size: clamp(1.5rem, 7vw, 2rem);
    line-height: 1.3;
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }
  .path-description {
    max-width: 44rem;
    font-size: 0.875rem;
    color: var(--c-text-secondary);
  }
  .lesson-list {
    list-style: none;
    display: grid;
  }
  .lesson-list-item {
    position: relative;
    padding-left: 36px;
  }
  .route-line {
    position: absolute;
    top: 28px;
    bottom: -28px;
    left: 15px;
    width: 2px;
    background: var(--c-route-line);
  }
  .lesson-list-item:last-child .route-line {
    bottom: 50%;
  }
  .lesson-list-link {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    background: var(--c-surface);
    border-top: 4px solid var(--c-primary);
    padding: var(--space-lg);
    margin-bottom: var(--space-md);
    text-decoration: none;
    color: var(--c-text);
    min-height: 152px;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .lesson-list-link:hover {
    background: var(--c-primary-light);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .lesson-marker {
    position: absolute;
    left: -30px;
    top: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background: var(--c-surface);
    border: 2px solid var(--c-route-line);
    border-radius: 50%;
    z-index: 1;
  }
  .lesson-list-item--current .lesson-marker {
    background: var(--c-primary);
    border-color: var(--c-primary);
    box-shadow: 0 0 0 4px var(--c-accent-light);
  }
  .lesson-list-item--current .lesson-marker-core {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-accent);
  }
  .lesson-list-item--done .lesson-marker {
    background: var(--c-success);
    border-color: var(--c-success);
  }
  .lesson-list-item--done .lesson-marker-core::before {
    content: '✓';
    display: block;
    color: var(--color-on-status);
    font-size: 0.625rem;
    line-height: 1;
    font-weight: 800;
  }
  .lesson-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .lesson-number {
    color: var(--c-primary);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .lesson-title {
    font-weight: 700;
    font-size: 1rem;
  }
  .lesson-can-do {
    font-size: 0.8125rem;
    color: var(--c-text-secondary);
  }
  .lesson-example {
    font-family: var(--font-zh);
    font-size: 1.125rem;
    color: var(--c-text);
    font-weight: 700;
    margin-top: var(--space-xs);
    overflow-wrap: anywhere;
  }
  .lesson-pinyin {
    font-family: var(--font-pinyin);
    font-size: 0.75rem;
    color: var(--c-text-muted);
    letter-spacing: 0.03em;
  }
  .lesson-arrow {
    align-self: center;
    font-size: 1.25rem;
    color: var(--c-primary);
    flex-shrink: 0;
  }
  @media (width <= 374px) {
    .lesson-list-item {
      padding-left: 30px;
    }
    .lesson-list-link {
      padding: var(--space-md);
      gap: var(--space-sm);
    }
    .lesson-marker {
      left: -24px;
    }
    .progress-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (width >= 768px) {
    .lesson-list-link {
      padding: var(--space-lg);
    }
  }
  @media (width >= 1024px) {
    .home-journey {
      grid-template-columns: 300px minmax(0, 720px);
      gap: var(--space-xl);
      align-items: start;
    }
    .home-content {
      padding-left: 0;
    }
    .lesson-list-link {
      min-height: 0;
      margin-bottom: 0.75rem;
      padding: 0.75rem var(--space-lg);
    }
  }
</style>
