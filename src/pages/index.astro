---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import GoalPathSlot from '../components/GoalPathSlot.astro';
import { loadAllRenderableLessons, hasUsableLessonPractice } from '../content/loadLessons';

const lessons = loadAllRenderableLessons();
---

<BaseLayout title="ホーム">
  <Fragment slot="header">
    <Header />
  </Fragment>

  <div class="home-layout">
    <section class="home-intro" aria-labelledby="home-heading">
      <h1 id="home-heading">台湾旅行で使える中国語</h1>
      <p class="home-description">
        全{lessons.length}レッスン。指差し・値段・場所の順に覚えよう。
      </p>
      {
        lessons.length > 0 && (
          <div class="progress-panel" aria-label="学習進捗">
            <div>
              <span id="progress-summary" class="progress-summary" aria-live="polite">
                0 / {lessons.length} レッスン完了
              </span>
            </div>
            <button id="reset-progress-btn" class="reset-btn" type="button">進捗をリセット</button>
          </div>
        )
      }
    </section>

    <GoalPathSlot />

    {
      lessons.length > 0 ? (
        <section class="path-section" id="taiwan-travel-path" aria-labelledby="path-heading">
          <div class="path-section-heading">
            <h2 id="path-heading">レッスン</h2>
          </div>
          <ol class="lesson-list">
            {lessons.map((lesson, index) => {
              const example = lesson.examples?.[0] ?? null;
              return (
                <li class="lesson-list-item">
                  <a
                    class:list={['lesson-list-link', { 'lesson-list-link--current': index === 0 }]}
                    href={`/lessons/${lesson.id}/`}
                    aria-current={index === 0 ? 'step' : undefined}
                  >
                    <span class="lesson-marker" aria-hidden="true"></span>
                    <span class="lesson-number">レッスン {index + 1}</span>
                    <span class="lesson-info">
                      <span class="lesson-title">{lesson.titleJa}</span>
                      <span class="lesson-can-do">{lesson.canDoJa}</span>
                      {example && (
                        <span class="lesson-example" lang="zh-Hant">{example.traditional}</span>
                      )}
                      <span
                        class="lesson-completion-status"
                        data-lesson-id={lesson.id}
                        data-completable={hasUsableLessonPractice(lesson) ? 'true' : 'false'}
                      >
                        {index === 0 ? '次はこちら' : '未完了'}
                      </span>
                    </span>
                    <span class="lesson-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      ) : (
        <article class="fallback-message">
          <h2>レッスンを読み込めませんでした</h2>
          <p>現在レッスンコンテンツが利用できません。しばらく経ってから再度アクセスしてください。</p>
        </article>
      )
    }
  </div>
</BaseLayout>

<script>
  import { ProgressStore } from '../lib/progress';
  import { buildProgressSnapshot, handleProgressStorageEvent } from '../lib/progressSnapshot';

  let store = new ProgressStore();

  function updateCompletionUI() {
    const statusElements = Array.from(
      document.querySelectorAll<HTMLElement>('.lesson-completion-status'),
    );
    const entries = statusElements
      .map((element) => ({
        id: element.dataset.lessonId ?? '',
        completable: element.dataset.completable === 'true',
      }))
      .filter((entry) => entry.id.length > 0);
    const currentLessonId = entries.find(
      (entry) => entry.completable && !store.isComplete(entry.id),
    )?.id;

    statusElements.forEach((element) => {
      const lessonId = element.dataset.lessonId ?? '';
      if (!lessonId) return;
      const link = element.closest<HTMLAnchorElement>('.lesson-list-link');
      const isComplete = store.isComplete(lessonId);
      const isCurrent = !isComplete && lessonId === currentLessonId;

      element.textContent = isComplete ? '完了' : isCurrent ? '次はこちら' : '未完了';
      element.className = isComplete
        ? 'lesson-completion-status lesson-completion-status--done'
        : 'lesson-completion-status';
      link?.classList.toggle('lesson-list-link--done', isComplete);
      link?.classList.toggle('lesson-list-link--current', isCurrent);
      if (isCurrent) {
        link?.setAttribute('aria-current', 'step');
      } else {
        link?.removeAttribute('aria-current');
      }
    });

    const snapshot = buildProgressSnapshot(store, entries);
    const summary = document.getElementById('progress-summary');
    if (summary) {
      summary.textContent = snapshot.summaryText;
    }
  }

  function refreshUI() {
    store = new ProgressStore();
    updateCompletionUI();
  }

  updateCompletionUI();
  window.addEventListener('pageshow', refreshUI);
  window.addEventListener('storage', (event) => {
    handleProgressStorageEvent(event, refreshUI);
  });

  const resetBtn = document.getElementById('reset-progress-btn');
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      if (window.confirm('学習進捗をすべてリセットしますか？この操作は元に戻せません。')) {
        store.resetAll();
        updateCompletionUI();
      }
    });
  }
</script>

<style>
  .home-layout {
    display: grid;
    gap: var(--space-xl);
  }
  .home-intro {
    min-width: 0;
  }
  .home-intro h1 {
    max-width: 15em;
    color: var(--color-text);
    font-size: clamp(1.65rem, 7vw, 2.25rem);
    line-height: 1.25;
    letter-spacing: 0.01em;
  }
  .home-description {
    max-width: 40rem;
    margin-top: var(--space-sm);
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }
  .progress-panel {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .progress-panel > div {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .progress-summary {
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 700;
  }
  .reset-btn {
    min-height: 44px;
    flex: 0 0 auto;
    padding: 0 var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }
  .reset-btn:hover {
    border-color: var(--color-error);
    color: var(--color-error);
  }
  .reset-btn:active {
    transform: translateY(1px);
  }
  .path-section {
    min-width: 0;
  }
  .path-section-heading {
    margin-bottom: var(--space-lg);
  }
  .path-section-heading h2 {
    color: var(--color-text);
    font-size: 1.25rem;
    line-height: 1.35;
  }
  .lesson-list {
    position: relative;
    display: grid;
    gap: var(--space-sm);
    list-style: none;
  }
  .lesson-list::before {
    content: '';
    position: absolute;
    top: 1.55rem;
    bottom: 1.55rem;
    left: 0.5rem;
    width: 2px;
    background: var(--color-route-line);
  }
  .lesson-list-item {
    min-width: 0;
  }
  .lesson-list-link {
    position: relative;
    min-height: 7.25rem;
    padding: var(--space-md) var(--space-lg) var(--space-md) 2.25rem;
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-md);
    color: var(--color-text);
    border: 1px solid transparent;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }
  .lesson-list-link:hover {
    background: var(--color-surface-raised);
    border-color: var(--color-border);
    text-decoration: none;
  }
  .lesson-list-link:active {
    transform: translateY(1px);
  }
  .lesson-list-link--current {
    background: var(--color-surface);
    border-color: var(--color-border);
    box-shadow: var(--shadow-surface);
  }
  .lesson-marker {
    position: absolute;
    top: 1.45rem;
    left: 0;
    width: 1.125rem;
    height: 1.125rem;
    border: 2px solid var(--color-route-line);
    border-radius: 50%;
    background: var(--color-surface);
  }
  .lesson-list-link--current .lesson-marker {
    border-color: var(--color-primary);
    background: var(--color-primary);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }
  .lesson-list-link--current .lesson-marker::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .lesson-list-link--done .lesson-marker {
    border-color: var(--color-success);
    background: var(--color-success);
  }
  .lesson-list-link--done .lesson-marker::after {
    content: '✓';
    position: absolute;
    inset: -3px;
    display: grid;
    place-items: center;
    color: var(--color-surface);
    font-size: 0.625rem;
    font-weight: 800;
  }
  .lesson-number {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .lesson-info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .lesson-title {
    margin-top: 0.1rem;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 750;
  }
  .lesson-can-do {
    margin-top: 0.15rem;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.55;
  }
  .lesson-example {
    margin-top: var(--space-sm);
    color: var(--color-text);
    font-family: var(--font-zh);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.035em;
  }
  .lesson-completion-status {
    margin-top: var(--space-sm);
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    background: var(--color-primary-soft);
    color: var(--color-text-secondary);
    font-size: 0.6875rem;
    font-weight: 700;
  }
  .lesson-list-link--current .lesson-completion-status {
    background: var(--color-accent-soft);
    color: var(--color-text);
  }
  .lesson-completion-status--done {
    background: var(--color-success-bg);
    color: var(--color-text);
  }
  .lesson-arrow {
    align-self: center;
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }
  .fallback-message {
    padding: var(--space-xl);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    text-align: center;
  }
  .fallback-message h2 {
    font-size: 1.25rem;
  }
  .fallback-message p {
    margin-top: var(--space-sm);
    color: var(--color-text-secondary);
  }
  @media (width <= 374px) {
    .home-layout {
      gap: var(--space-lg);
    }
    .progress-panel {
      align-items: flex-start;
      flex-direction: column;
    }
    .reset-btn {
      width: 100%;
    }
    .lesson-list-link {
      padding-right: var(--space-md);
      padding-left: 2rem;
    }
  }
  @media (width >= 1024px) {
    .home-layout {
      grid-template-columns: 18.75rem minmax(0, 1fr);
      grid-template-areas:
        'route intro'
        'route path';
      column-gap: var(--space-2xl);
      row-gap: var(--space-xl);
      align-items: start;
    }
    .home-intro {
      grid-area: intro;
      max-width: var(--reading-w);
    }
    :global(.home-layout > .route-panel) {
      grid-area: route;
    }
    .path-section,
    .fallback-message {
      grid-area: path;
      max-width: var(--reading-w);
    }
    .lesson-list-link {
      padding: var(--space-lg) var(--space-xl) var(--space-lg) 2.5rem;
    }
    .lesson-marker {
      top: 1.95rem;
    }
    .lesson-list::before {
      top: 2.05rem;
      bottom: 2.05rem;
    }
  }
</style>
