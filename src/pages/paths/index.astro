---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LearningPathCard from '../../components/LearningPathCard.astro';
import { loadLearningPaths } from '../../content/loadLearningPaths';
import { taiwanTravelQuizEntryForTrack } from '../../domain/taiwanTravelQuizNavigation';
import { evaluateTravelQuestReadiness } from '../../domain/travelQuestReadiness';
import {
  basicVocabularyRelevantIds,
  buildReadinessInput,
} from '../../domain/pathsProgress';
import readinessData from '../../../data/travel-quest-readiness.json';
import learnerManifest from '../../../data/teacher-vocabulary-preview/learner-manifest.json';
import type { TravelQuestReadinessDocument } from '../../types/travelQuestReadiness';
import type { LearnerManifest } from '../../types/learnerManifest';

const document = loadLearningPaths();
const learningPaths = document.learningPaths;

const readinessTargets = (readinessData as TravelQuestReadinessDocument).targets;
// Initial SSR snapshot: no progress signals (storage is client-only), so every
// target renders at 0 with its fixed denominator and any contract-level
// unavailable evidence already surfaced truthfully.
const initialReadiness = evaluateTravelQuestReadiness(
  buildReadinessInput(readinessTargets, {
    completedLessons: new Set(),
    learnedVocabulary: new Set(),
    learnedBasicVocabulary: new Set(),
  }),
);

// Exact production basic-vocabulary writer corpus: the learner-manifest
// learnerIds are the only ids the /vocabulary/basic/ writer can produce. Only
// the subset this page can reference (basic path vocabulary members plus the
// completed-vocabulary-session readiness evidence) is serialized, so the
// route-local projection accepts only those ids from
// BasicVocabularyProgressStore while keeping the payload minimal.
const writerIdSet = new Set(
  (learnerManifest as LearnerManifest).rows.map((row) => row.learnerId),
);
const basicVocabularyWriterIds = basicVocabularyRelevantIds(
  learningPaths,
  readinessTargets,
).filter((id) => writerIdSet.has(id));

const pathsPayload = JSON.stringify({
  paths: learningPaths.map((path) => ({ id: path.id, members: path.members })),
  basicVocabularyWriterIds,
}).replace(/</g, '\\u003c');
---

<BaseLayout title="学習ルート" description="Chabiko の学習ルート一覧です。" themeEnabled>
  <Fragment slot="header">
    <Header themeEnabled />
  </Fragment>

  <div class="paths-root" data-paths-root>
    <Breadcrumb
      crumbs={[
        { label: 'ホーム', href: '/' },
        { label: '学習ルート' },
      ]}
    />
    <section class="paths-page" aria-labelledby="paths-heading">
      <h1 id="paths-heading" class="paths-heading">ルートを選んで中国語を学ぼう</h1>
      <p class="paths-lead">目的に合ったルートを選んでください。</p>

      <ol class="paths-list">
        {learningPaths.map((path, index) => {
          const quiz = taiwanTravelQuizEntryForTrack(path.id);
          return (
            <li class="paths-list-item" data-path-id={path.id}>
              <LearningPathCard path={path} emphasized={index === 0} quiz={quiz} />
            </li>
          );
        })}
      </ol>
    </section>

    <section
      class="readiness-section"
      data-readiness-section
      aria-labelledby="readiness-heading"
    >
      <p class="readiness-kicker">Travel Quest</p>
      <h2 id="readiness-heading" class="readiness-heading">旅行の準備度</h2>
      <p class="readiness-lead">実際に台湾で使える場面ごとの準備度です。</p>
      <ol class="readiness-list">
        {initialReadiness.map((result) => {
          const target = readinessTargets.find(
            (t) => t.id === result.targetId,
          );
          return (
            <li
              class="readiness-list-item"
              data-readiness-target={result.targetId}
            >
              <div class="readiness-item">
                <div class="readiness-item__head">
                  <h3 class="readiness-item__label">{target?.labelJa}</h3>
                  <span
                    class="readiness-item__status"
                    data-readiness-status
                    data-status={result.status}
                  >未開始</span>
                </div>
                {target?.goalJa && (
                  <p class="readiness-item__goal">{target.goalJa}</p>
                )}
                <div class="readiness-item__meta">
                  <span class="readiness-item__count" data-readiness-count>
                    {result.numerator} / {result.denominator}
                  </span>
                </div>
                <p
                  class="readiness-item__note"
                  data-readiness-note
                  hidden={result.unavailableEvidence.length === 0}
                >
                  この準備度にはまだ利用できない項目があります。
                </p>
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  </div>

  <script is:inline type="application/json" id="paths-progress-data" set:html={pathsPayload}></script>
</BaseLayout>

<script>
  import { initPathsReadiness } from '../../client/pathsReadiness';

  const root = document.querySelector<HTMLElement>('[data-paths-root]');
  if (root) {
    const script = document.getElementById('paths-progress-data');
    let payload: Parameters<typeof initPathsReadiness>[1] | null = null;
    if (script?.textContent) {
      try {
        const parsed = JSON.parse(script.textContent) as unknown;
        if (
          parsed !== null &&
          typeof parsed === 'object' &&
          Array.isArray((parsed as { paths?: unknown }).paths)
        ) {
          payload = parsed as Parameters<typeof initPathsReadiness>[1];
        }
      } catch {
        /* malformed payload — leave readiness unhydrated, cards keep SSR */
      }
    }
    if (payload) {
      initPathsReadiness(root, payload);
    }
  }
</script>

<style>
  /* BaseLayout's global `*` reset is scoped to BaseLayout's own elements and
   * does not reach this page's rendered content, so restore border-box sizing
   * here (Issue #406: content-box cards overflowed the route at narrow widths). */
  * {
    box-sizing: border-box;
  }
  .paths-root {
    min-width: 0;
    /* Bound to the prior effective content width so the theme-enabled wider
     * shell (--max-w: 80rem) does not stretch the path/readiness cards. */
    max-width: 44rem;
    margin: 0 auto;
  }
  .paths-page {
    min-width: 0;
  }
  h1.paths-heading {
    font-family: var(--font-serif-ja);
    font-size: clamp(1.75rem, 7vw, 2rem);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: 0.01em;
    margin-bottom: var(--sp-4);
    overflow-wrap: anywhere;
  }
  .paths-lead {
    max-width: 44rem;
    font-size: 14px;
    color: var(--ink-secondary);
    margin-bottom: var(--sp-10);
  }
  .paths-list {
    list-style: none;
    display: grid;
    gap: var(--sp-4);
  }
  .paths-list-item {
    min-width: 0;
  }
  @media (width >= 768px) {
    .paths-list {
      gap: var(--sp-5);
    }
  }

  .readiness-section {
    min-width: 0;
    margin-top: var(--sp-12);
  }
  .readiness-kicker {
    color: var(--coral-deep);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin-bottom: var(--sp-2);
  }
  .readiness-heading {
    font-family: var(--font-serif-ja);
    font-size: clamp(1.25rem, 6vw, 1.5rem);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: 0.01em;
    margin-bottom: var(--sp-3);
  }
  .readiness-lead {
    max-width: 44rem;
    font-size: 13px;
    color: var(--ink-secondary);
    margin-bottom: var(--sp-6);
  }
  .readiness-list {
    list-style: none;
    display: grid;
    gap: var(--sp-3);
  }
  .readiness-list-item {
    min-width: 0;
  }
  .readiness-item {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    width: 100%;
    min-width: 0;
    background: var(--paper-deep);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-content);
    padding: var(--sp-5);
    overflow-wrap: anywhere;
  }
  .readiness-item__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .readiness-item__label {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    min-width: 0;
  }
  .readiness-item__status {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 var(--sp-3);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-chip);
    font-size: 11px;
    font-weight: 700;
    background: var(--paper);
    color: var(--ink-secondary);
  }
  .readiness-item__status[data-status='ready'] {
    background: var(--jade-soft);
    border-color: var(--jade-soft);
    color: var(--jade-ink);
  }
  .readiness-item__status[data-status='in-progress'] {
    background: var(--coral-soft);
    border-color: var(--coral-soft);
    color: var(--coral-deep);
  }
  .readiness-item__goal {
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink-secondary);
  }
  .readiness-item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    font-size: 12.5px;
    color: var(--ink-secondary);
    font-variant-numeric: tabular-nums;
  }
  .readiness-item__note {
    font-size: 12px;
    color: var(--ink-muted);
  }
  @media (width >= 768px) {
    .readiness-list {
      gap: var(--sp-4);
    }
  }
</style>
