---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  buildV2ReferenceBootstrap,
  loadV2ReferenceContent,
} from '../../content/v2Reference';

const content = loadV2ReferenceContent();
const bootstrap = buildV2ReferenceBootstrap(content);
const bootstrapJson = JSON.stringify(bootstrap).replace(/</g, '\\u003c');
---

<BaseLayout
  title="V2 台湾シーン Reference"
  description="Chabiko V2 の操作可能な台湾学習リファレンスです。"
  robots="noindex, nofollow"
>
  <div class="v2-reference" data-v2-reference-root data-v2-stage="today">
    <div class="v2-screen v2-screen--today">
      <header class="v2-brand-bar">
        <span class="v2-wordmark" aria-label="Chabiko">chabiko</span>
        <span class="v2-brand-context">きょうの中国語</span>
      </header>
      <div class="v2-screen-scroll v2-screen-scroll--with-nav">
        <figure class="v2-scene v2-scene--hero">
          <img
            src={bootstrap.today.scene.src}
            width={bootstrap.today.scene.width}
            height={bootstrap.today.scene.height}
            alt={bootstrap.today.scene.altJa}
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>{bootstrap.today.scene.locationJa}</figcaption>
        </figure>
        <section class="v2-today-content" aria-labelledby="v2-today-title">
          <p class="v2-context-line">{bootstrap.today.contextJa}</p>
          <h1 id="v2-today-title" data-screen-heading tabindex="-1">
            {bootstrap.today.titleJa}
          </h1>
          <div class="v2-phrase-moment">
            <p class="v2-phrase" lang="zh-Hant">{bootstrap.today.phrase}</p>
            <p class="v2-pinyin" lang="zh-Latn">{bootstrap.today.pinyin}</p>
            <p class="v2-meaning">{bootstrap.today.meaningJa}</p>
          </div>
          <button class="v2-primary-button" type="button" data-action="start-learning">
            <span>{bootstrap.today.primaryActionJa}</span>
            <span class="v2-button-arrow" aria-hidden="true">→</span>
          </button>
        </section>
      </div>
      <nav class="v2-bottom-nav" aria-label="メインナビゲーション">
        <button class="v2-nav-item" type="button" aria-current="page" disabled>
          <span class="v2-nav-shape v2-nav-shape--today" aria-hidden="true"></span>
          <span>今日</span>
        </button>
        <button class="v2-nav-item" type="button" data-action="start-learning">
          <span class="v2-nav-shape v2-nav-shape--learn" aria-hidden="true"></span>
          <span>学ぶ</span>
        </button>
        <button class="v2-nav-item" type="button" disabled aria-disabled="true">
          <span class="v2-nav-shape v2-nav-shape--record" aria-hidden="true"></span>
          <span>記録</span>
        </button>
      </nav>
    </div>
  </div>

  <script
    is:inline
    type="application/json"
    id="v2-reference-bootstrap"
    set:html={bootstrapJson}
  ></script>
  <noscript>
    <p class="v2-noscript">この操作リファレンスには JavaScript が必要です。</p>
  </noscript>
</BaseLayout>

<script>
  import { mountV2ReferenceFlow } from '../../client/v2ReferenceFlow';
  import type { V2ReferenceBootstrap } from '../../content/v2Reference';

  const root = document.querySelector<HTMLElement>('[data-v2-reference-root]');
  const bootstrapElement = document.getElementById('v2-reference-bootstrap');

  if (root && bootstrapElement?.textContent) {
    try {
      const bootstrap = JSON.parse(
        bootstrapElement.textContent,
      ) as V2ReferenceBootstrap;
      bootstrapElement.remove();
      mountV2ReferenceFlow(root, bootstrap);
    } catch {
      bootstrapElement.remove();
      root.innerHTML = `
        <div class="v2-load-failure" role="alert">
          <h1>リファレンスを読み込めませんでした</h1>
          <p>ページを再読み込みしてください。</p>
        </div>
      `;
    }
  }
</script>

<style is:global>
  body:has([data-v2-reference-root]) {
    background: #dfe5e2;
  }

  body:has([data-v2-reference-root]) .main-content {
    max-width: none;
    padding: 0;
  }

  [data-v2-reference-root] {
    --v2-shell: #f1f4f2;
    --v2-surface: #fbfcfb;
    --v2-surface-strong: #ffffff;
    --v2-ink: #14252d;
    --v2-muted: #59686e;
    --v2-soft: #dbe2df;
    --v2-blue: #2856d8;
    --v2-blue-deep: #173da9;
    --v2-blue-soft: #dfe7ff;
    --v2-yellow: #f3cb5e;
    --v2-yellow-deep: #b78316;
    --v2-good: #1c705d;
    --v2-good-soft: #dcefe8;
    --v2-error: #a83f4b;
    --v2-error-soft: #f5e1e3;
    position: relative;
    width: min(100%, 430px);
    min-height: 100dvh;
    margin: 0 auto;
    overflow: hidden;
    background: var(--v2-shell);
    color: var(--v2-ink);
    font-family: "Hiragino Sans", "Noto Sans JP", "Helvetica Neue", Arial, sans-serif;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  [data-v2-reference-root] *,
  [data-v2-reference-root] *::before,
  [data-v2-reference-root] *::after {
    box-sizing: border-box;
  }

  [data-v2-reference-root] button,
  [data-v2-reference-root] summary {
    font: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  [data-v2-reference-root] button:focus-visible,
  [data-v2-reference-root] summary:focus-visible,
  [data-v2-reference-root] [tabindex="-1"]:focus-visible {
    outline: 3px solid var(--v2-yellow-deep);
    outline-offset: 3px;
  }

  .v2-screen {
    position: relative;
    min-height: 100dvh;
    background: var(--v2-shell);
  }

  .v2-brand-bar,
  .v2-focused-bar {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    padding: 10px 18px;
    background: color-mix(in srgb, var(--v2-shell) 94%, transparent);
    backdrop-filter: blur(12px);
  }

  .v2-wordmark {
    color: var(--v2-ink);
    font-size: 19px;
    font-weight: 850;
    letter-spacing: -0.055em;
  }

  .v2-brand-context {
    color: var(--v2-muted);
    font-size: 12px;
    font-weight: 650;
  }

  .v2-focused-bar {
    justify-content: flex-start;
    gap: 10px;
    color: var(--v2-muted);
    font-size: 13px;
    font-weight: 700;
  }

  .v2-focused-mark {
    width: 22px;
    height: 10px;
    border: 2px solid var(--v2-blue);
    border-radius: 999px;
    background: var(--v2-blue-soft);
    box-shadow: inset 6px 0 0 var(--v2-blue);
  }

  .v2-screen-scroll {
    min-height: calc(100dvh - 60px);
  }

  .v2-screen-scroll--with-nav {
    padding-bottom: calc(86px + env(safe-area-inset-bottom));
  }

  .v2-screen-scroll--with-command {
    padding-bottom: calc(94px + env(safe-area-inset-bottom));
  }

  .v2-scene {
    margin: 0;
    background: var(--v2-soft);
  }

  .v2-scene img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 58%;
  }

  .v2-scene--hero img {
    height: clamp(208px, 28.5dvh, 246px);
  }

  .v2-scene--learning {
    margin: 0 16px;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 8px 22px rgb(25 48 58 / 0.13);
  }

  .v2-scene--learning img {
    height: clamp(174px, 23dvh, 205px);
  }

  .v2-scene figcaption {
    padding: 7px 18px 0;
    color: #43565e;
    font-size: 11px;
    font-weight: 650;
  }

  .v2-scene--learning figcaption {
    padding: 7px 12px 9px;
    background: var(--v2-surface);
  }

  .v2-today-content,
  .v2-learning-content,
  .v2-retrieval-content,
  .v2-repair-content,
  .v2-correct-content,
  .v2-result-content {
    padding: 12px 18px 24px;
  }

  .v2-context-line {
    color: var(--v2-muted);
    font-size: 13px;
    font-weight: 600;
  }

  .v2-today-content h1 {
    max-width: 16ch;
    margin-top: 3px;
    font-size: clamp(24px, 7.2vw, 30px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .v2-phrase-moment {
    position: relative;
    margin: 13px 0 15px;
    padding: 12px 14px 12px 18px;
    border-left: 6px solid var(--v2-yellow);
    background: var(--v2-surface-strong);
  }

  .v2-phrase,
  .v2-learning-phrase,
  .v2-correct-phrase,
  .v2-reveal-phrase,
  .v2-result-phrase > p {
    color: var(--v2-ink);
    font-family: "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
    font-size: clamp(32px, 10.5vw, 42px);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: 0.015em;
  }

  .v2-pinyin {
    margin-top: 4px;
    color: var(--v2-blue-deep);
    font-size: 13px;
    font-weight: 720;
    letter-spacing: 0.025em;
  }

  .v2-meaning {
    margin-top: 2px;
    color: var(--v2-muted);
    font-size: 13px;
    font-weight: 650;
  }

  .v2-primary-button,
  .v2-secondary-button,
  .v2-support-button,
  .v2-audio-button,
  .v2-chunk-button,
  .v2-selected-chunk {
    min-height: 48px;
    border-radius: 14px;
    cursor: pointer;
    transition: transform 140ms ease, box-shadow 140ms ease, background 140ms ease;
  }

  .v2-primary-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 54px;
    padding: 11px 16px;
    border: 2px solid var(--v2-blue-deep);
    background: var(--v2-blue);
    box-shadow: 0 4px 0 var(--v2-blue-deep);
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    text-align: left;
  }

  .v2-primary-button:hover:not(:disabled) {
    background: #214dcb;
  }

  .v2-primary-button:active:not(:disabled),
  .v2-secondary-button:active:not(:disabled),
  .v2-support-button:active:not(:disabled),
  .v2-audio-button:active:not(:disabled),
  .v2-chunk-button:active:not(:disabled),
  .v2-selected-chunk:active:not(:disabled) {
    transform: translateY(3px);
    box-shadow: 0 1px 0 var(--v2-blue-deep);
  }

  .v2-primary-button:disabled {
    border-color: #99a4aa;
    background: #aeb8bc;
    box-shadow: none;
    color: #f7f8f8;
    cursor: default;
  }

  .v2-button-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.17);
    font-size: 18px;
  }

  .v2-bottom-nav,
  .v2-command-area {
    position: fixed;
    z-index: 20;
    right: 0;
    bottom: 0;
    left: 50%;
    width: min(100%, 430px);
    transform: translateX(-50%);
  }

  .v2-bottom-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    min-height: 74px;
    padding: 6px 10px max(6px, env(safe-area-inset-bottom));
    border-top: 1px solid #cfd8d4;
    background: rgb(251 252 251 / 0.97);
    box-shadow: 0 -10px 24px rgb(22 38 46 / 0.06);
    backdrop-filter: blur(14px);
  }

  .v2-nav-item {
    display: flex;
    min-width: 0;
    min-height: 58px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--v2-muted);
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
  }

  .v2-nav-item[aria-current="page"] {
    color: var(--v2-blue-deep);
  }

  .v2-nav-item:disabled:not([aria-current="page"]) {
    color: #9aa4a7;
    cursor: default;
  }

  .v2-nav-shape {
    position: relative;
    display: block;
    width: 22px;
    height: 16px;
  }

  .v2-nav-shape--today {
    border: 2px solid currentColor;
    border-radius: 5px;
  }

  .v2-nav-shape--today::before {
    position: absolute;
    right: 4px;
    bottom: 3px;
    left: 4px;
    height: 2px;
    background: currentColor;
    content: "";
  }

  .v2-nav-shape--learn {
    border: 2px solid currentColor;
    border-radius: 2px 8px 8px 2px;
    transform: skewY(-5deg);
  }

  .v2-nav-shape--record {
    border: 2px solid currentColor;
    border-radius: 50%;
  }

  .v2-nav-shape--record::after {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: currentColor;
    content: "";
  }

  .v2-command-area {
    padding: 12px 16px max(14px, env(safe-area-inset-bottom));
    border-top: 1px solid #d4dcda;
    background: rgb(241 244 242 / 0.97);
    box-shadow: 0 -12px 28px rgb(22 38 46 / 0.07);
    backdrop-filter: blur(14px);
  }

  .v2-learning-content {
    padding-top: 16px;
  }

  .v2-learning-phrase {
    margin-top: 2px;
    font-size: clamp(39px, 12.5vw, 50px);
  }

  .v2-pinyin--learning {
    font-size: 14px;
  }

  .v2-audio-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    margin: 14px 0 12px;
  }

  .v2-audio-button {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 46px;
    padding: 8px 13px;
    border: 2px solid var(--v2-blue-deep);
    background: var(--v2-surface-strong);
    box-shadow: 0 3px 0 var(--v2-blue-deep);
    color: var(--v2-blue-deep);
    font-size: 13px;
    font-weight: 800;
  }

  .v2-wave {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 18px;
  }

  .v2-wave i {
    display: block;
    width: 3px;
    border-radius: 3px;
    background: currentColor;
  }

  .v2-wave i:nth-child(1) { height: 8px; }
  .v2-wave i:nth-child(2) { height: 16px; }
  .v2-wave i:nth-child(3) { height: 11px; }

  .v2-audio-status {
    min-width: 0;
    color: var(--v2-muted);
    font-size: 11px;
    line-height: 1.45;
  }

  .v2-support-disclosure {
    margin-top: 9px;
    border: 1px solid #cfd8d4;
    border-radius: 14px;
    background: var(--v2-surface);
  }

  .v2-support-disclosure summary {
    display: flex;
    min-height: 46px;
    align-items: center;
    justify-content: space-between;
    padding: 9px 13px;
    color: var(--v2-ink);
    font-size: 13px;
    font-weight: 750;
    cursor: pointer;
    list-style: none;
  }

  .v2-support-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .v2-support-disclosure summary::after {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex: 0 0 auto;
    border: 1px solid #aeb9b5;
    border-radius: 8px;
    color: var(--v2-blue-deep);
    content: "+";
    font-size: 18px;
  }

  .v2-support-disclosure[open] summary::after {
    content: "−";
  }

  .v2-support-body {
    padding: 2px 13px 14px;
    color: var(--v2-muted);
    font-size: 12px;
  }

  .v2-support-meaning {
    color: var(--v2-ink);
    font-size: 16px;
    font-weight: 750;
  }

  .v2-support-list {
    margin: 0;
  }

  .v2-support-row {
    display: grid;
    grid-template-columns: minmax(56px, auto) 1fr;
    gap: 12px;
    padding: 7px 0;
  }

  .v2-support-row dt {
    color: var(--v2-ink);
    font-family: "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
    font-size: 17px;
    font-weight: 800;
  }

  .v2-support-row dd {
    display: grid;
    gap: 3px;
    margin: 0;
  }

  .v2-support-note {
    color: #50626a;
    font-size: 11px;
    line-height: 1.5;
  }

  .v2-kanji-bridge {
    margin-top: 6px;
    padding-top: 10px;
    border-top: 1px solid #dbe2df;
  }

  .v2-kanji-bridge h2 {
    margin: 0 0 5px;
    color: var(--v2-ink);
    font-size: 12px;
  }

  .v2-kanji-bridge-item {
    display: grid;
    grid-template-columns: 66px minmax(0, 1fr);
    gap: 10px;
    padding: 6px 0;
  }

  .v2-kanji-bridge-item p {
    margin: 0;
  }

  .v2-kanji-bridge-term {
    display: grid;
    align-content: start;
    gap: 1px;
  }

  .v2-kanji-bridge-term strong {
    color: var(--v2-blue-deep);
    font-family: "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
    font-size: 19px;
  }

  .v2-kanji-bridge-term span {
    color: #5d6b70;
    font-size: 9px;
    white-space: nowrap;
  }

  .v2-sound-note {
    margin-top: 5px;
    padding-top: 9px;
    border-top: 1px solid #dbe2df;
  }

  .v2-sound-note p {
    display: grid;
    gap: 2px;
  }

  .v2-sound-note strong {
    color: var(--v2-blue-deep);
  }

  .v2-retrieval-content,
  .v2-repair-content {
    padding-top: 12px;
  }

  .v2-situation-cue {
    display: grid;
    grid-template-columns: 94px 1fr;
    align-items: center;
    gap: 13px;
    overflow: hidden;
    border-radius: 16px;
    background: var(--v2-surface);
  }

  .v2-situation-cue img {
    display: block;
    width: 94px;
    height: 78px;
    object-fit: cover;
    object-position: 52% 58%;
  }

  .v2-situation-cue p {
    padding-right: 13px;
    color: var(--v2-muted);
    font-size: 12px;
    font-weight: 650;
  }

  .v2-retrieval-content h1 {
    max-width: 20ch;
    margin-top: 19px;
    font-size: clamp(21px, 6.2vw, 25px);
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .v2-answer-builder {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    min-height: 74px;
    margin-top: 20px;
    padding: 11px;
    border: 2px dashed #aeb9b5;
    border-radius: 18px;
    background: var(--v2-surface);
  }

  .v2-answer-slot {
    min-width: 0;
    min-height: 48px;
    border-radius: 12px;
    background: #e5eae8;
    box-shadow: inset 0 2px 4px rgb(38 59 66 / 0.08);
  }

  .v2-selected-chunk,
  .v2-chunk-button {
    min-width: 0;
    padding: 8px 10px;
    border: 2px solid var(--v2-yellow-deep);
    background: var(--v2-yellow);
    box-shadow: 0 3px 0 var(--v2-yellow-deep);
    color: var(--v2-ink);
    font-family: "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
    font-size: 22px;
    font-weight: 850;
  }

  .v2-selected-chunk:active:not(:disabled),
  .v2-chunk-button:active:not(:disabled) {
    box-shadow: 0 1px 0 var(--v2-yellow-deep);
  }

  .v2-builder-help,
  .v2-retrieval-status {
    margin-top: 7px;
    color: var(--v2-muted);
    font-size: 11px;
  }

  .v2-chunk-bank {
    display: flex;
    min-height: 54px;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 20px;
  }

  .v2-chunk-bank .v2-chunk-button {
    min-width: 74px;
  }

  .v2-retrieval-status {
    margin-top: 14px;
    color: var(--v2-blue-deep);
    font-weight: 700;
  }

  .v2-repair-context {
    color: var(--v2-muted);
    font-size: 12px;
    font-weight: 650;
  }

  .v2-submitted-attempt {
    display: flex;
    gap: 7px;
    margin-top: 8px;
  }

  .v2-submitted-attempt span {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 7px 12px;
    border: 1px solid #c7d0cd;
    border-radius: 12px;
    background: var(--v2-surface);
    color: var(--v2-ink);
    font-family: "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
    font-size: 22px;
    font-weight: 800;
  }

  .v2-repair-message {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 13px;
    margin-top: 24px;
    padding: 16px;
    border-radius: 18px;
    background: var(--v2-error-soft);
  }

  .v2-repair-mark {
    display: inline-flex;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    background: var(--v2-error);
    color: #ffffff;
    font-size: 20px;
    font-weight: 850;
  }

  .v2-repair-message h1 {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.35;
  }

  .v2-repair-message p {
