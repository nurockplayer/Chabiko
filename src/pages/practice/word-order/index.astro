---
import Header from '../../../components/Header.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import WordOrderPractice from '../../../components/WordOrderPractice.astro';
import { loadWordOrderPractice } from '../../../content/loadWordOrderPractice';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const items = loadWordOrderPractice();
---

<BaseLayout title="語順練習" themeEnabled>
  <Fragment slot="header">
    <Header themeEnabled />
  </Fragment>

  <div class="word-order-page">
    <Breadcrumb
      crumbs={[
        { label: 'ホーム', href: '/' },
        { label: '語順練習' },
      ]}
    />
    <h1 class="page-title">語順練習</h1>
    <p class="page-subtitle">チャンクを選んで、正しい中国語の語順に並べ替えましょう。</p>

    {
      items.length > 0 ? (
        <WordOrderPractice items={items} />
      ) : (
        <div class="empty-fallback" role="alert">
          <p>現在利用できる語順練習がありません。データが準備できるまでお待ちください。</p>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .word-order-page {
    max-width: 40rem;
    margin: 0 auto;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .page-title {
    margin: 0 0 var(--sp-3);
    font-family: var(--font-serif-ja);
    font-size: 28px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }
  .page-subtitle {
    margin: 0 0 var(--sp-10);
    color: var(--ink-secondary);
    font-size: 13.5px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .empty-fallback {
    background: var(--paper-deep);
    border-radius: var(--radius-content);
    padding: var(--sp-5);
    text-align: center;
    color: var(--ink-secondary);
    font-size: 13.5px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .empty-fallback p {
    margin: 0;
  }
</style>
