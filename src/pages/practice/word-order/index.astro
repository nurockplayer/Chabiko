---
import Header from '../../../components/Header.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import WordOrderPractice from '../../../components/WordOrderPractice.astro';
import { loadWordOrderPractice } from '../../../content/loadWordOrderPractice';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const items = loadWordOrderPractice();
---

<BaseLayout title="語順練習" description="日本語の意味をヒントに中国語の文を組み立て、台湾旅行で使う表現の語順を練習しましょう。" themeEnabled>
  <Fragment slot="header">
    <Header themeEnabled />
  </Fragment>

  <div class="word-order-page">
    <Breadcrumb
      crumbs={[
        { label: 'ホーム', href: '/' },
        { label: '語順練習' },
      ]}
    />
    <h1 class="page-title">語順練習</h1>
    <p class="page-subtitle">日本語の意味に合うように、文字を選んで中国語の文を作りましょう。</p>

    <p class="provisional-note">日本語のヒントと許容する語順は AI が整理した暫定版で、教師による確認はまだ済んでいません。自然な別の言い方をすべて判定できるわけではありません。</p>

    {
      items.length > 0 ? (
        <WordOrderPractice items={items} />
      ) : (
        <div class="empty-fallback" role="alert">
          <p>現在利用できる語順練習がありません。データが準備できるまでお待ちください。</p>
        </div>
      )
    }
    <p><a href="/paths/taiwan-travel/">台湾旅行のレッスンで使ってみる →</a></p>
  </div>
</BaseLayout>

<style>
  .word-order-page {
    max-width: 40rem;
    margin: 0 auto;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .page-title {
    margin: 0 0 var(--sp-3);
    font-family: var(--font-serif-ja);
    font-size: 28px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }
  .page-subtitle {
    margin: 0 0 var(--sp-10);
    color: var(--ink-secondary);
    font-size: 13.5px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .provisional-note {
    margin: 0 0 var(--sp-5);
    color: var(--ink-secondary);
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  .page-subtitle { margin-bottom: var(--sp-3); }
  .empty-fallback {
    background: var(--paper-deep);
    border-radius: var(--radius-content);
    padding: var(--sp-5);
    text-align: center;
    color: var(--ink-secondary);
    font-size: 13.5px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .empty-fallback p {
    margin: 0;
  }
</style>
