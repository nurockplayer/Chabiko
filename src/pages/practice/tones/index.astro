---
import Header from '../../../components/Header.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import TonePractice from '../../../components/TonePractice.astro';
import { loadTonePractice } from '../../../content/loadTonePractice';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const items = loadTonePractice();
---

<BaseLayout title="声調練習" themeEnabled>
  <Fragment slot="header">
    <Header themeEnabled />
  </Fragment>

  <div class="tone-page">
    <Breadcrumb
      crumbs={[
        { label: 'ホーム', href: '/' },
        { label: '声調練習' },
      ]}
    />
    <h1 class="page-title">声調練習</h1>
    <p class="page-subtitle">声調の形を見て、正しい声調を選びましょう。</p>

    {
      items.length > 0 ? (
        <TonePractice items={items} />
      ) : (
        <div class="empty-fallback" role="alert">
          <p>現在利用できる声調練習がありません。データが準備できるまでお待ちください。</p>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .tone-page {
    max-width: 40rem;
    margin: 0 auto;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .page-title {
    margin: 0 0 var(--space-md);
    font-size: clamp(1.5rem, 6vw, 2rem);
    overflow-wrap: anywhere;
  }
  .page-subtitle {
    margin: 0 0 var(--space-xl);
    color: var(--c-text-secondary);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .empty-fallback {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: var(--space-xl);
    text-align: center;
    color: var(--c-text-secondary);
    overflow-wrap: anywhere;
  }
</style>
