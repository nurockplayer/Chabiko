---
import type { GetStaticPaths } from 'astro';
import Header from '../../components/Header.astro';
import LessonPractice from '../../components/LessonPractice.astro';
import {
  lessonPhrasebookDestination,
  loadProductionPhrasebookScenarios,
} from '../../content/lessonPhrasebook';
import { loadAllRenderableLessons } from '../../content/loadLessons';
import type { PhrasebookScenario } from '../../content/loadPhrasebook';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lesson } from '../../types/lesson';

interface NavLesson {
  id: string;
  titleJa: string;
}

export const getStaticPaths = (() => {
  const lessons = loadAllRenderableLessons();
  // Production-eligible phrasebook scenarios (#239): computed once at build time
  // from the same eligible surface as /phrasebook/ (loadEligiblePhrasebook +
  // groupPhrasebookByScenario), so a lesson links ONLY to a scenario with real
  // learner-visible content — never to a draft/pending-only scenario.
  const productionPhrasebookScenarios = loadProductionPhrasebookScenarios();
  return lessons.map((lesson, index) => ({
    params: { id: lesson.id },
    props: {
      lesson,
      lessonNumber: index + 1,
      lessonCount: lessons.length,
      prevLesson: index > 0 ? ({ id: lessons[index - 1].id, titleJa: lessons[index - 1].titleJa } satisfies NavLesson) : null,
      nextLesson: index < lessons.length - 1 ? ({ id: lessons[index + 1].id, titleJa: lessons[index + 1].titleJa } satisfies NavLesson) : null,
      phrasebookScenario: lessonPhrasebookDestination(
        lesson.travelScenario,
        productionPhrasebookScenarios,
      ),
    },
  }));
}) satisfies GetStaticPaths;

const { lesson, lessonNumber, lessonCount, prevLesson, nextLesson, phrasebookScenario } = Astro.props as {
  lesson?: Lesson;
  lessonNumber?: number;
  lessonCount?: number;
  prevLesson?: NavLesson | null;
  nextLesson?: NavLesson | null;
  phrasebookScenario?: PhrasebookScenario | null;
};
const hasText = (value: unknown): value is string =>
  typeof value === 'string' && value.trim().length > 0;
const sections = (lesson?.sections ?? []).filter(
  (section) => section && hasText(section.headingJa) && hasText(section.contentJa),
);
const chunks = (lesson?.chunks ?? []).filter(
  (chunk) => chunk && hasText(chunk.chunk) && hasText(chunk.meaning),
);
const kanjiBridgeNotes = (lesson?.kanjiBridgeNotes ?? []).filter(
  (note) => note && hasText(note.kanji) && hasText(note.jpReading) && hasText(note.noteJa),
);
const soundFocus = (lesson?.soundFocus ?? []).filter(
  (focus) => focus && hasText(focus.item) && hasText(focus.noteJa),
);
const examples = (lesson?.examples ?? []).filter(
  (example) => example && hasText(example.traditional) && hasText(example.japanese),
);
const coreExample = examples.find((example) => example.traditional === lesson?.coreSentence) ?? examples[0];

// Script-preference provenance (#253): the lesson schema does not yet expose
// per-form status, so it is read permissively from the loaded data. Every
// reading field below carries `data-script-*` attributes describing its
// authored path-default Traditional form and any simplified form. Fields
// without provenance (core sentence, chunks, kanji bridge notes) are the
// path-default Traditional form and stay eligible.
const scriptStatusAttr = (value: unknown): string | undefined =>
  value === 'authored' ||
  value === 'verified' ||
  value === 'generated' ||
  value === 'unavailable'
    ? value
    : undefined;
const exampleScriptAttrs = (example: {
  traditional: string;
  simplified?: string;
  traditionalStatus?: unknown;
  simplifiedStatus?: unknown;
}) => ({
  'data-script-path-default': example.traditional,
  'data-script-path-default-status': scriptStatusAttr(example.traditionalStatus),
  ...(typeof example.simplified === 'string'
    ? { 'data-script-simplified': example.simplified }
    : {}),
  ...(scriptStatusAttr(example.simplifiedStatus)
    ? { 'data-script-simplified-status': scriptStatusAttr(example.simplifiedStatus) }
    : {}),
});
---

<BaseLayout title={lesson?.titleJa ?? 'レッスンを読み込めませんでした'} themeEnabled>
  <Fragment slot="header">
    <Header themeEnabled />
  </Fragment>

  {
    lesson ? (
      <div class="lesson-journey">
        <aside class="lesson-route" aria-labelledby="lesson-route-heading">
          <a class="back-link" href="/">← 台湾旅行パスに戻る</a>
          <h2 id="lesson-route-heading" class="route-heading">台湾旅行で使える中国語</h2>
          <div class="route-station" aria-current="step">
            <span class="route-station-dot" aria-hidden="true"></span>
            <p class="route-position">レッスン {lessonNumber} / {lessonCount}</p>
            <p class="route-title">{lesson.titleJa}</p>
            <p class="route-can-do">{lesson.canDoJa}</p>
            <p class="route-example" lang="zh-Hant" data-script-path-default={lesson.coreSentence}>{lesson.coreSentence}</p>
            <span class="route-status">進行中</span>
          </div>
          <div class="pending-path">
            <span class="pending-dot" aria-hidden="true"></span>
            <span>HSK対策</span>
            <span class="pending-status">準備中</span>
          </div>
        </aside>

        <article class="lesson-page">
          <header class="lesson-intro">
            <p class="lesson-label">台湾旅行の中国語</p>
            <h1>{lesson.titleJa}</h1>
            <p class="hook">{lesson.hookJa}</p>
            <p id="lesson-completion-badge" class="completion-badge" aria-live="polite" data-lesson-id={lesson.id}></p>
          </header>

          <section class="can-do-section" aria-labelledby="can-do-heading">
            <h2 id="can-do-heading">できるようになること</h2>
            <p>{lesson.canDoJa}</p>
          </section>

          <section class="core-section" aria-labelledby="core-heading">
            <h2 id="core-heading" class="section-label">今日のコア表現</h2>
            <div class="core-card">
              <p class="core-sentence" lang="zh-Hant" data-script-path-default={lesson.coreSentence}>{lesson.coreSentence}</p>
              {coreExample && hasText(coreExample.pinyin) && (
                <p class="core-pinyin" lang="zh-Latn">{coreExample.pinyin}</p>
              )}
              {coreExample && <p class="core-meaning">{coreExample.japanese}</p>}
            </div>
          </section>

          {sections.map((section) => (
            <section class="reading-section" aria-label={section.headingJa}>
              <h2>{section.headingJa}</h2>
              <p>{section.contentJa}</p>
            </section>
          ))}

          {chunks.length > 0 && (
            <section class="reading-section" aria-labelledby="chunks-heading">
              <h2 id="chunks-heading">フレーズを分けてみよう</h2>
              <dl class="detail-list">
                {chunks.map((chunk) => (
                  <div>
                    <dt lang="zh-Hant" data-script-path-default={chunk.chunk}>{chunk.chunk}</dt>
                    <dd>{chunk.meaning}</dd>
                    {hasText(chunk.notesJa) && <dd class="note">{chunk.notesJa}</dd>}
                  </div>
                ))}
              </dl>
            </section>
          )}

          {kanjiBridgeNotes.length > 0 && (
            <section class="reading-section bridge-section" aria-labelledby="kanji-heading">
              <h2 id="kanji-heading">漢字からつなげよう</h2>
              <div class="bridge-list">
                {kanjiBridgeNotes.map((note) => (
                  <p><strong lang="zh-Hant" data-script-path-default={note.kanji}>{note.kanji}</strong>（{note.jpReading}）：{note.noteJa}</p>
                ))}
              </div>
            </section>
          )}

          {soundFocus.length > 0 && (
            <section class="reading-section" aria-labelledby="sound-heading">
              <h2 id="sound-heading">音のポイント</h2>
              <div class="sound-list">
                {soundFocus.map((focus) => (
                  <p><strong>{focus.item}</strong>：{focus.noteJa}</p>
                ))}
              </div>
            </section>
          )}

          {examples.length > 0 && (
            <section class="reading-section" aria-labelledby="examples-heading">
              <h2 id="examples-heading">例文</h2>
              <div class="example-list">
                {examples.map((example) => (
                  <div>
                    <p class="example-sentence" lang="zh-Hant" {...exampleScriptAttrs(example)}>{example.traditional}</p>
                    {hasText(example.pinyin) && <p class="pinyin" lang="zh-Latn">{example.pinyin}</p>}
                    <p>{example.japanese}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          <LessonPractice lesson={lesson} />

          <section class="travel-task" aria-labelledby="task-heading">
            <h2 id="task-heading">旅先でやってみよう</h2>
            <p>{lesson.travelTask}</p>
          </section>

          {phrasebookScenario && (
            <section class="related-phrasebook" aria-label="関連フレーズ">
              <a
                class="related-phrasebook__link"
                data-phrasebook-link
                href={`/phrasebook/?scenario=${phrasebookScenario}`}
              >
                関連フレーズを見る
              </a>
            </section>
          )}

          <nav class="lesson-nav" aria-label="レッスンナビゲーション">
            {prevLesson && (
              <a class="nav-link nav-prev" href={`/lessons/${prevLesson.id}/`}>
                <span aria-hidden="true">←</span> {prevLesson.titleJa}
              </a>
            )}
            {nextLesson ? (
              <a class="nav-link nav-next" href={`/lessons/${nextLesson.id}/`}>
                {nextLesson.titleJa} <span aria-hidden="true">→</span>
              </a>
            ) : (
              <a class="nav-link nav-complete" href="/">
                台湾旅行パスを完了 <span aria-hidden="true">→</span> 一覧に戻る
              </a>
            )}
          </nav>
        </article>
      </div>
    ) : (
      <article class="fallback-message">
        <h1>レッスンを読み込めませんでした</h1>
        <p>現在このレッスンは利用できません。ホームから別の内容を確認してください。</p>
        <a href="/">ホームに戻る</a>
      </article>
    )
  }
</BaseLayout>

<script>
  import { ProgressStore } from '../../lib/progress';
  import { initLessonScriptPreference } from '../../client/lessonScriptPreference';

  (function () {
    initLessonScriptPreference();
  })();

  (function () {
  const badge = document.getElementById('lesson-completion-badge');
  if (!badge) return;
  const bid = badge.getAttribute('data-lesson-id') ?? '';
  function refreshBadge() {
    const store = new ProgressStore();
    if (store.isComplete(bid)) {
      badge!.textContent = '✔ 完了済み';
      badge!.className = 'completion-badge completion-badge--done';
    } else {
      badge!.textContent = '';
      badge!.className = 'completion-badge';
    }
  }
  refreshBadge();
  window.addEventListener('pageshow', refreshBadge);
  })();
</script>

<style>
  .lesson-journey {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }
  .lesson-route {
    min-width: 0;
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--c-border);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: var(--space-sm);
    color: var(--c-primary);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .route-heading {
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid var(--c-border);
    color: var(--c-text-secondary);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }
  .route-station {
    position: relative;
    margin-left: 15px;
    padding: 0 0 var(--space-lg) 32px;
    border-left: 2px solid var(--c-route-line);
  }
  .route-station-dot {
    position: absolute;
    left: -10px;
    top: 4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--c-primary);
    border: 2px solid var(--c-primary);
    box-shadow: 0 0 0 4px var(--c-accent-light);
  }
  .route-station-dot::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--c-accent);
  }
  .route-position {
    color: var(--c-primary);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .route-title {
    color: var(--c-primary);
    font-size: 0.875rem;
    font-weight: 700;
  }
  .route-can-do {
    margin-top: 2px;
    color: var(--c-text-secondary);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .route-example {
    margin-top: var(--space-xs);
    font-family: var(--font-zh);
    font-size: 0.875rem;
    font-weight: 700;
  }
  .route-status,
  .pending-status {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    margin-top: var(--space-xs);
    padding: 0 var(--space-sm);
    background: var(--c-accent-light);
    color: var(--color-status-current);
    font-size: 0.6875rem;
    font-weight: 700;
  }
  .pending-path {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--c-border);
    color: var(--c-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .pending-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--c-route-line);
    background: var(--c-surface);
    flex: 0 0 auto;
  }
  .pending-status {
    margin: 0;
    background: var(--c-primary-light);
    color: var(--c-text-secondary);
  }
  .lesson-page {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .lesson-intro {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--c-border);
  }
  .lesson-label {
    color: var(--c-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xs);
  }
  .completion-badge {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    margin-top: var(--space-sm);
    padding: 0 var(--space-sm);
    font-size: 0.75rem;
  }
  .completion-badge:empty {
    display: none;
  }
  .completion-badge--done {
    color: var(--color-status-success);
    background: var(--c-success-bg);
    font-weight: 700;
  }
  h1 {
    max-width: 22ch;
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    line-height: 1.25;
  }
  h2 {
    font-size: 1.0625rem;
    line-height: 1.4;
    margin-bottom: var(--space-sm);
  }
  .hook,
  .pinyin,
  .note {
    color: var(--c-text-secondary);
  }
  .hook {
    max-width: 48rem;
    margin-top: var(--space-md);
    font-size: 0.9375rem;
  }
  .can-do-section {
    margin-bottom: var(--space-2xl);
    padding: var(--space-md) var(--space-lg);
    border-left: 4px solid var(--c-accent);
    background: var(--c-accent-light);
  }
  .can-do-section h2 {
    color: var(--color-status-current);
    font-size: 0.8125rem;
  }
  .can-do-section p {
    font-weight: 600;
  }
  .core-section,
  .reading-section,
  .travel-task {
    margin-top: var(--space-2xl);
  }
  .section-label {
    color: var(--c-text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }
  .core-card {
    background: var(--c-surface);
    border-top: 4px solid var(--c-primary);
    padding: var(--space-xl) var(--space-lg);
  }
  .core-sentence {
    font-family: var(--font-zh);
    color: var(--c-text);
    font-size: clamp(2.25rem, 11vw, 2.75rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.2;
    word-break: break-word;
  }
  .core-pinyin {
    margin-top: var(--space-sm);
    color: var(--c-text-muted);
    font-family: var(--font-pinyin);
    font-size: 1rem;
    letter-spacing: 0.04em;
  }
  .core-meaning {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--c-border);
  }
  .reading-section {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--c-border);
  }
  .reading-section > p,
  .sound-list,
  .bridge-list {
    max-width: 48rem;
  }
  .detail-list,
  .example-list,
  .sound-list,
  .bridge-list {
    display: grid;
    gap: var(--space-md);
  }
  .detail-list > div {
    display: grid;
    grid-template-columns: minmax(4.5rem, auto) 1fr;
    column-gap: var(--space-md);
    padding: var(--space-md) 0;
  }
  .detail-list > div + div {
    border-top: 1px solid var(--c-border);
  }
  dt {
    grid-row: 1 / span 3;
    font-family: var(--font-zh);
    font-size: 1.125rem;
    font-weight: 700;
  }
  dd {
    margin: 0;
  }
  .note {
    margin-top: var(--space-xs);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .bridge-section {
    padding: var(--space-lg);
    border-top: 4px solid var(--c-primary);
    background: var(--c-surface);
  }
  .bridge-list strong {
    font-family: var(--font-zh);
    font-size: 1.125rem;
  }
  .example-list > div {
    padding: var(--space-md) 0;
  }
  .example-list > div + div {
    border-top: 1px solid var(--c-border);
  }
  .example-sentence {
    font-family: var(--font-zh);
    color: var(--c-text);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .script-fallback {
    display: block;
    margin-top: var(--space-xs);
    color: var(--c-text-secondary);
    font-family: var(--font-ja);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .pinyin {
    font-family: var(--font-pinyin);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
  }
  .travel-task {
    padding: var(--space-lg);
    border-left: 4px solid var(--c-accent);
    background: var(--c-accent-light);
  }
  .travel-task h2 {
    color: var(--color-status-current);
  }
  .related-phrasebook {
    margin-top: var(--space-2xl);
    padding: var(--space-lg);
    border: 1px solid var(--c-border);
    border-top: 4px solid var(--c-primary);
    background: var(--c-surface);
  }
  .related-phrasebook__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--c-primary);
    border-radius: var(--radius);
    background: var(--c-surface);
    color: var(--c-primary);
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
  }
  .related-phrasebook__link:hover {
    background: var(--c-primary-light);
    text-decoration: none;
  }
  .lesson-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: stretch;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--c-border);
  }
  .nav-link {
    display: flex;
    align-items: center;
    min-height: 52px;
    flex: 1 1 100%;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--c-border);
    background: var(--c-surface);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--c-text);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .nav-link:hover {
    background: var(--c-primary-light);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .nav-prev {
    justify-content: flex-start;
  }
  .nav-next {
    justify-content: flex-end;
  }
  .nav-complete {
    color: var(--c-primary);
    border-color: var(--c-primary);
  }
  .fallback-message {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    padding: var(--space-xl);
    text-align: center;
  }
  .fallback-message p {
    color: var(--c-text-secondary);
    margin: var(--space-md) 0;
  }
  @media (width <= 374px) {
    .core-card {
      padding: var(--space-lg) var(--space-md);
    }
    .core-sentence {
      font-size: 2.25rem;
    }
    .detail-list > div {
      grid-template-columns: 1fr;
    }
    dt {
      grid-row: auto;
    }
  }
  @media (width >= 640px) {
    .nav-link {
      flex: 1 1 0;
    }
  }
  @media (width >= 1024px) {
    .lesson-journey {
      grid-template-columns: 300px minmax(0, 720px);
    }
    .lesson-route {
      position: sticky;
      top: 88px;
      padding: 0 var(--space-lg) var(--space-xl) 0;
      border: 0;
      border-right: 1px solid var(--c-border);
      min-height: calc(100dvh - 136px);
    }
    .lesson-page {
      padding-left: 0;
    }
    .core-sentence {
      font-size: 3rem;
    }
  }
</style>
