---
import type { GetStaticPaths } from 'astro';
import Header from '../../components/Header.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LessonPractice from '../../components/LessonPractice.astro';
import {
  lessonPhrasebookDestination,
  loadProductionPhrasebookScenarios,
} from '../../content/lessonPhrasebook';
import { loadAllRenderableLessons } from '../../content/loadLessons';
import type { PhrasebookScenario } from '../../content/loadPhrasebook';
import { TAIWAN_TRAVEL_PATH_ROUTE } from '../../domain/taiwanTravelQuizNavigation';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lesson } from '../../types/lesson';

interface NavLesson {
  id: string;
  titleJa: string;
}

export const getStaticPaths = (() => {
  const lessons = loadAllRenderableLessons();
  // Production-eligible phrasebook scenarios (#239): computed once at build time
  // from the same eligible surface as /phrasebook/ (loadEligiblePhrasebook +
  // groupPhrasebookByScenario), so a lesson links ONLY to a scenario with real
  // learner-visible content — never to a draft/pending-only scenario.
  const productionPhrasebookScenarios = loadProductionPhrasebookScenarios();
  return lessons.map((lesson, index) => ({
    params: { id: lesson.id },
    props: {
      lesson,
      lessonNumber: index + 1,
      prevLesson: index > 0 ? ({ id: lessons[index - 1].id, titleJa: lessons[index - 1].titleJa } satisfies NavLesson) : null,
      nextLesson: index < lessons.length - 1 ? ({ id: lessons[index + 1].id, titleJa: lessons[index + 1].titleJa } satisfies NavLesson) : null,
      phrasebookScenario: lessonPhrasebookDestination(
        lesson.travelScenario,
        productionPhrasebookScenarios,
      ),
    },
  }));
}) satisfies GetStaticPaths;

const { lesson, lessonNumber, prevLesson, nextLesson, phrasebookScenario } = Astro.props as {
  lesson?: Lesson;
  lessonNumber?: number;
  prevLesson?: NavLesson | null;
  nextLesson?: NavLesson | null;
  phrasebookScenario?: PhrasebookScenario | null;
};
const hasText = (value: unknown): value is string =>
  typeof value === 'string' && value.trim().length > 0;
const sections = (lesson?.sections ?? []).filter(
  (section) => section && hasText(section.headingJa) && hasText(section.contentJa),
);
const chunks = (lesson?.chunks ?? []).filter(
  (chunk) => chunk && hasText(chunk.chunk) && hasText(chunk.meaning),
);
const kanjiBridgeNotes = (lesson?.kanjiBridgeNotes ?? []).filter(
  (note) => note && hasText(note.kanji) && hasText(note.jpReading) && hasText(note.noteJa),
);
const soundFocus = (lesson?.soundFocus ?? []).filter(
  (focus) => focus && hasText(focus.item) && hasText(focus.noteJa),
);
const examples = (lesson?.examples ?? []).filter(
  (example) => example && hasText(example.traditional) && hasText(example.japanese),
);
const coreExample = examples.find((example) => example.traditional === lesson?.coreSentence) ?? examples[0];

// Script-preference provenance (#253): the lesson schema does not yet expose
// per-form status, so it is read permissively from the loaded data. Every
// reading field below carries `data-script-*` attributes describing its
// authored path-default Traditional form and any simplified form. Fields
// without provenance (core sentence, chunks, kanji bridge notes) are the
// path-default Traditional form and stay eligible.
const scriptStatusAttr = (value: unknown): string | undefined =>
  value === 'authored' ||
  value === 'verified' ||
  value === 'generated' ||
  value === 'unavailable'
    ? value
    : undefined;
const exampleScriptAttrs = (example: {
  traditional: string;
  simplified?: string;
  traditionalStatus?: unknown;
  simplifiedStatus?: unknown;
}) => ({
  'data-script-path-default': example.traditional,
  'data-script-path-default-status': scriptStatusAttr(example.traditionalStatus),
  ...(typeof example.simplified === 'string'
    ? { 'data-script-simplified': example.simplified }
    : {}),
  ...(scriptStatusAttr(example.simplifiedStatus)
    ? { 'data-script-simplified-status': scriptStatusAttr(example.simplifiedStatus) }
    : {}),
});
---

<BaseLayout title={lesson?.titleJa ?? 'レッスンを読み込めませんでした'} themeEnabled>
  <Fragment slot="header">
    <Header themeEnabled />
  </Fragment>

  {
    lesson ? (
      <>
        <div class="lesson-page-shell">
        <Breadcrumb
          crumbs={[
            { label: 'ホーム', href: '/' },
            { label: '台湾旅行', href: TAIWAN_TRAVEL_PATH_ROUTE },
            { label: `第${lessonNumber}課` },
          ]}
        />
        <article class="lesson-page">
          <header class="lesson-intro">
            <p class="lesson-label">台湾旅行の中国語</p>
            <h1>{lesson.titleJa}</h1>
            <p class="hook">{lesson.hookJa}</p>
            <p id="lesson-completion-badge" class="completion-badge" aria-live="polite" data-lesson-id={lesson.id}></p>
          </header>

          <section class="can-do-section" aria-labelledby="can-do-heading">
            <h2 id="can-do-heading">できるようになること</h2>
            <p>{lesson.canDoJa}</p>
          </section>

          <section class="core-section" aria-labelledby="core-heading">
            <div class="core-block">
              <p class="core-kicker">
                <span id="core-heading">今日のコア表現</span>
                <span class="core-kicker__sub" aria-current="step">レッスン {lessonNumber}</span>
              </p>
              <p class="core-sentence" lang="zh-Hant" data-script-path-default={lesson.coreSentence}>{lesson.coreSentence}</p>
              {coreExample && hasText(coreExample.pinyin) && (
                <p class="core-pinyin" lang="zh-Latn">{coreExample.pinyin}</p>
              )}
              {coreExample && <p class="core-meaning">{coreExample.japanese}</p>}
            </div>
          </section>

          {sections.map((section) => (
            <section class="reading-section" aria-label={section.headingJa}>
              <h2>{section.headingJa}</h2>
              <p>{section.contentJa}</p>
            </section>
          ))}

          {chunks.length > 0 && (
            <section class="reading-section" aria-labelledby="chunks-heading">
              <h2 id="chunks-heading">フレーズを分けてみよう</h2>
              <dl class="detail-list">
                {chunks.map((chunk) => (
                  <div>
                    <dt lang="zh-Hant" data-script-path-default={chunk.chunk}>{chunk.chunk}</dt>
                    <dd>{chunk.meaning}</dd>
                    {hasText(chunk.notesJa) && <dd class="note">{chunk.notesJa}</dd>}
                  </div>
                ))}
              </dl>
            </section>
          )}

          {kanjiBridgeNotes.length > 0 && (
            <section class="reading-section bridge-section" aria-labelledby="kanji-heading">
              <h2 id="kanji-heading">漢字からつなげよう</h2>
              <div class="bridge-list">
                {kanjiBridgeNotes.map((note) => (
                  <p><strong lang="zh-Hant" data-script-path-default={note.kanji}>{note.kanji}</strong>（{note.jpReading}）：{note.noteJa}</p>
                ))}
              </div>
            </section>
          )}

          {soundFocus.length > 0 && (
            <section class="reading-section" aria-labelledby="sound-heading">
              <h2 id="sound-heading">音のポイント</h2>
              <div class="sound-list">
                {soundFocus.map((focus) => (
                  <p><strong>{focus.item}</strong>：{focus.noteJa}</p>
                ))}
              </div>
            </section>
          )}

          {examples.length > 0 && (
            <section class="reading-section" aria-labelledby="examples-heading">
              <h2 id="examples-heading">例文</h2>
              <div class="example-list">
                {examples.map((example) => (
                  <div>
                    <p class="example-sentence" lang="zh-Hant" {...exampleScriptAttrs(example)}>{example.traditional}</p>
                    {hasText(example.pinyin) && <p class="pinyin" lang="zh-Latn">{example.pinyin}</p>}
                    <p>{example.japanese}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

          <LessonPractice lesson={lesson} />

          <section class="travel-task" aria-labelledby="task-heading">
            <h2 id="task-heading">旅先でやってみよう</h2>
            <p>{lesson.travelTask}</p>
          </section>

          {phrasebookScenario && (
            <section class="related-phrasebook" aria-label="関連フレーズ">
              <a
                class="related-phrasebook__link"
                data-phrasebook-link
                href={`/phrasebook/?scenario=${phrasebookScenario}`}
              >
                関連フレーズを見る
              </a>
            </section>
          )}

          <nav class="lesson-nav" aria-label="レッスンナビゲーション">
            {prevLesson && (
              <a class="nav-link nav-prev" href={`/lessons/${prevLesson.id}/`}>
                <span class="nav-direction">前のレッスン</span>
                <span class="nav-title">
                  <span class="nav-arrow" aria-hidden="true">←</span>
                  <span class="nav-title-text">{prevLesson.titleJa}</span>
                </span>
              </a>
            )}
            {nextLesson ? (
              <a class="nav-link nav-next" href={`/lessons/${nextLesson.id}/`}>
                <span class="nav-direction">次のレッスン</span>
                <span class="nav-title">
                  <span class="nav-title-text">{nextLesson.titleJa}</span>
                  <span class="nav-arrow" aria-hidden="true">→</span>
                </span>
              </a>
            ) : (
              <a class="nav-link nav-complete" href={TAIWAN_TRAVEL_PATH_ROUTE}>
                <span class="nav-direction">台湾旅行パスを完了</span>
                <span class="nav-title">
                  <span class="nav-title-text">一覧に戻る</span>
                  <span class="nav-arrow" aria-hidden="true">→</span>
                </span>
              </a>
            )}
          </nav>
        </article>
        </div>
      </>
    ) : (
      <article class="fallback-message">
        <h1>レッスンを読み込めませんでした</h1>
        <p>現在このレッスンは利用できません。ホームから別の内容を確認してください。</p>
        <a href="/">ホームに戻る</a>
      </article>
    )
  }
</BaseLayout>

<script>
  import { ProgressStore } from '../../lib/progress';
  import { initLessonScriptPreference } from '../../client/lessonScriptPreference';

  (function () {
    initLessonScriptPreference();
  })();

  (function () {
  const badge = document.getElementById('lesson-completion-badge');
  if (!badge) return;
  const bid = badge.getAttribute('data-lesson-id') ?? '';
  function refreshBadge() {
    const store = new ProgressStore();
    if (store.isComplete(bid)) {
      badge!.textContent = '✔ 完了済み';
      badge!.className = 'completion-badge completion-badge--done';
    } else {
      badge!.textContent = '';
      badge!.className = 'completion-badge';
    }
  }
  refreshBadge();
  window.addEventListener('pageshow', refreshBadge);
  })();
</script>

<style>
  .lesson-page-shell {
    min-width: 0;
  }
  .lesson-page {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .lesson-label {
    margin-bottom: var(--sp-2);
    color: var(--coral-deep);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .lesson-page h1 {
    font-family: var(--font-serif-ja);
    font-size: 30px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }
  .hook {
    max-width: 48rem;
    margin-top: var(--sp-4);
    font-size: 13px;
    line-height: 1.8;
    color: var(--ink-secondary);
  }
  .completion-badge {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    margin-top: var(--sp-3);
    padding: 0 var(--sp-3);
    border-radius: var(--radius-chip);
    font-size: 12px;
  }
  .completion-badge:empty {
    display: none;
  }
  .completion-badge--done {
    color: var(--jade-ink);
    background: var(--jade-soft);
    font-weight: 700;
  }
  .can-do-section {
    margin-top: var(--sp-10);
    padding: var(--sp-5);
    border-radius: var(--radius-content);
    background: var(--paper-deep);
  }
  .can-do-section h2 {
    margin-bottom: var(--sp-1);
    color: var(--jade-ink);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .can-do-section p {
    font-size: 13.5px;
    line-height: 1.8;
    font-weight: 600;
  }
  .core-section {
    margin-top: var(--sp-10);
  }
  .core-block {
    padding-top: 20px;
    border-top: 2px solid var(--coral);
  }
  .core-kicker {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--jade-ink);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }
  .core-kicker__sub {
    color: var(--ink-muted);
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  .core-sentence {
    margin-top: var(--sp-4);
    font-family: var(--font-serif-zh);
    font-size: 46px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .core-pinyin {
    margin-top: var(--sp-2);
    color: var(--ink-muted);
    font-size: 14px;
    letter-spacing: 0.04em;
  }
  .core-meaning {
    margin-top: var(--sp-4);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-secondary);
  }
  .reading-section {
    margin-top: var(--sp-10);
  }
  .reading-section h2 {
    margin-bottom: var(--sp-3);
    font-family: var(--font-serif-ja);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
  }
  .reading-section > p {
    max-width: 48rem;
    font-size: 14px;
    line-height: 1.8;
    color: var(--ink-secondary);
  }
  .detail-list,
  .example-list,
  .sound-list {
    border-top: 1px solid var(--hairline);
  }
  .detail-list > div {
    display: grid;
    grid-template-columns: minmax(72px, auto) 1fr;
    column-gap: var(--sp-4);
    padding: var(--sp-4) 0;
  }
  .detail-list > div + div {
    border-top: 1px solid var(--hairline);
  }
  dt {
    grid-row: 1 / span 2;
    font-family: var(--font-serif-zh);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  dd {
    margin: 0;
    min-width: 0;
  }
  .note {
    margin-top: var(--sp-1);
    font-size: 12px;
    line-height: 1.6;
    color: var(--ink-muted);
  }
  .bridge-section {
    margin-top: var(--sp-10);
    padding: var(--sp-5);
    border-radius: var(--radius-content);
    background: var(--jade-soft);
  }
  .bridge-list {
    display: grid;
    gap: var(--sp-3);
  }
  .bridge-list p {
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--ink-secondary);
  }
  .bridge-list strong {
    font-family: var(--font-serif-zh);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
  }
  .sound-list > p {
    padding: var(--sp-3) 0;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--ink-secondary);
  }
  .sound-list > p + p {
    border-top: 1px solid var(--hairline);
  }
  .sound-list strong {
    color: var(--jade-ink);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .example-list > div {
    padding: var(--sp-4) 0;
  }
  .example-list > div + div {
    border-top: 1px solid var(--hairline);
  }
  .example-sentence {
    font-family: var(--font-serif-zh);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  .example-list .pinyin {
    margin-top: var(--sp-1);
    color: var(--ink-muted);
    font-size: 12.5px;
    letter-spacing: 0.03em;
  }
  .example-list > div > p:last-child {
    margin-top: var(--sp-1);
    font-size: 13px;
    color: var(--ink-secondary);
  }
  .script-fallback {
    display: block;
    margin-top: var(--sp-1);
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-secondary);
    overflow-wrap: anywhere;
  }
  .travel-task {
    margin-top: var(--sp-10);
    padding: var(--sp-5);
    border-radius: var(--radius-content);
    background: var(--coral-soft);
  }
  .travel-task h2 {
    margin-bottom: var(--sp-1);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  :global(html[data-theme='dark']) .travel-task h2 {
    color: var(--coral-deep);
  }
  .travel-task p {
    font-size: 13.5px;
    line-height: 1.8;
  }
  .related-phrasebook {
    margin-top: var(--sp-10);
    padding: var(--sp-5);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-content);
    background: var(--paper-deep);
  }
  .related-phrasebook__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--coral);
    border-radius: var(--radius-control);
    background: var(--coral-soft);
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }
  .related-phrasebook__link:hover {
    background: var(--coral-soft);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .lesson-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
    margin-top: var(--sp-10);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--hairline);
  }
  .nav-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 44px;
    flex: 1 1 100%;
    padding: var(--sp-2) 0;
    color: var(--jade-ink);
    text-decoration: none;
  }
  .nav-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .nav-prev {
    align-items: flex-start;
  }
  .nav-next,
  .nav-complete {
    align-items: flex-end;
  }
  .nav-direction {
    margin-bottom: 2px;
    color: var(--ink-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .nav-title {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-width: 0;
    max-width: 100%;
    font-size: 12.5px;
    font-weight: 700;
  }
  .nav-next .nav-title,
  .nav-complete .nav-title {
    justify-content: flex-end;
  }
  .nav-title-text {
    overflow-wrap: anywhere;
  }
  .nav-arrow {
    flex: 0 0 auto;
    color: var(--ink-muted);
  }
  .fallback-message {
    padding: var(--sp-8) var(--sp-6);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-content);
    background: var(--paper-deep);
    text-align: center;
  }
  .fallback-message h1 {
    font-family: var(--font-serif-ja);
    font-size: 30px;
    line-height: 1.3;
  }
  .fallback-message p {
    margin: var(--sp-4) 0;
    color: var(--ink-secondary);
  }
  .fallback-message a {
    color: var(--jade-ink);
    font-weight: 700;
  }
  @media (width <= 374px) {
    .lesson-page h1 {
      font-size: 28px;
    }
    .core-block {
      padding-top: 16px;
    }
    .core-sentence {
      font-size: 40px;
    }
    .detail-list > div {
      column-gap: var(--sp-3);
    }
    dt {
      min-width: 60px;
      font-size: 19px;
    }
    .example-sentence {
      font-size: 19px;
    }
  }
  @media (width >= 640px) {
    .nav-link {
      flex: 1 1 0;
    }
  }
  @media (width >= 1024px) {
    .lesson-page-shell {
      max-width: 760px;
      margin: 0 auto;
    }
    .lesson-page h1 {
      font-size: 32px;
    }
    .core-sentence {
      font-size: 50px;
    }
    .can-do-section,
    .travel-task {
      padding: var(--sp-6) 24px;
    }
  }
</style>
