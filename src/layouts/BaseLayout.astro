---

export interface Props {
  title: string;
  description?: string;
  robots?: string;
  referrerPolicy?: 'no-referrer';
  themeEnabled?: boolean;
}

const { title, description, robots, referrerPolicy, themeEnabled = false } = Astro.props;
const metaDescription = description ?? 'Chabiko | チャビコ — 日本人のための中国語学習';
const url = new URL(Astro.url.pathname, Astro.site);
const canonical = url.href;
---

<!doctype html>
<html lang="ja" data-theme-enabled={themeEnabled ? 'true' : undefined}>
  <head>
    <meta charset="utf-8" />
    {referrerPolicy && <meta name="referrer" content={referrerPolicy} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    {robots && <meta name="robots" content={robots} />}
    <title>{title} | Chabiko</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={`${title} | Chabiko`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Chabiko" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (root.dataset.themeEnabled !== 'true') return;
        const themeKey = 'chabiko_theme';
        let storedTheme = null;
        try {
          storedTheme = localStorage.getItem(themeKey);
        } catch {
          // Storage can be unavailable; system preference remains the fallback.
        }
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        root.dataset.theme =
          storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : systemTheme;
      })();
    </script>
    <script is:inline>
      // Frozen script-preference bootstrap (Issue #252): runs before rendered
      // content. Reads only `chabiko.script-preference.v1`, accepts only
      // version 1 and the three controlled values, and exposes the validated
      // preference on the root dataset. Missing/malformed/inaccessible storage
      // falls back to `path-default`. Never writes storage, modifies content,
      // converts script, or throws.
      (() => {
        const key = 'chabiko.script-preference.v1';
        let stored = 'path-default';
        try {
          const raw = window.localStorage.getItem(key);
          if (raw !== null) {
            const parsed = JSON.parse(raw);
            if (
              parsed &&
              typeof parsed === 'object' &&
              !Array.isArray(parsed) &&
              parsed.version === 1 &&
              (parsed.preference === 'path-default' ||
                parsed.preference === 'traditional' ||
                parsed.preference === 'simplified')
            ) {
              stored = parsed.preference;
            }
          }
        } catch {
          // Missing, malformed, or inaccessible storage → path-default.
        }
        document.documentElement.dataset.scriptPreference = stored;
      })();
    </script>
    <style>
      :root {
        /* ── A1 Editorial Calm semantic tokens · Issue #389 (frozen) ── */
        --paper: #FAF8F4;
        --paper-deep: #F4F0E9;
        --ink: #272522;
        --ink-secondary: #5E5A53;
        --ink-muted: #736C66;
        --hairline: #E6E1D8;
        --hairline-strong: #D6D0C5;
        --jade: #536B62;
        --jade-ink: #3E554D;
        --jade-soft: #E7ECE8;
        --coral: #E87961;
        --coral-deep: #B84C38;
        --coral-soft: #F6E6E1;
        --font-sans: 'Hiragino Sans', 'Noto Sans JP', 'Helvetica Neue', Arial, sans-serif;
        --font-serif-ja: 'Hiragino Mincho ProN', 'Yu Mincho', serif;
        --font-serif-zh: 'Songti TC', 'Songti SC', 'Hiragino Mincho ProN', serif;
        --sp-1: 4px;
        --sp-2: 8px;
        --sp-3: 12px;
        --sp-4: 16px;
        --sp-5: 20px;
        --sp-6: 24px;
        --sp-7: 28px;
        --sp-8: 32px;
        --sp-10: 40px;
        --sp-12: 48px;
        --radius-chip: 6px;
        --radius-control: 8px;
        --radius-content: 10px;
        --radius-card: 12px;
        --radius-hero: 16px;
        /* ── Transitional legacy aliases · Issue #393 ──────────────
         * Role-mapped to A1 values so not-yet-migrated surfaces keep
         * functioning with the A1 visual language. Removed surface by
         * surface as they adopt semantic A1 tokens. */
        --color-page: var(--paper);
        --color-surface: #ffffff;
        --color-text: var(--ink);
        --color-text-secondary: var(--ink-secondary);
        --color-text-muted: var(--ink-muted);
        --color-primary: var(--jade);
        --color-primary-soft: var(--jade-soft);
        --color-accent: var(--coral);
        --color-accent-soft: var(--coral-soft);
        --color-route: var(--hairline-strong);
        --color-border: var(--hairline);
        --color-success: var(--jade);
        --color-success-soft: var(--jade-soft);
        --color-error: #b04435;
        --color-error-soft: #f5e8e4;
        --color-header: var(--paper);
        --color-header-text: var(--ink);
        --color-header-muted: var(--ink-muted);
        --color-on-primary: #ffffff;
        --color-on-status: #ffffff;
        --color-status-current: var(--jade-ink);
        --color-status-success: var(--jade-ink);
        --color-focus: var(--jade);
        --c-bg: var(--color-page);
        --c-surface: var(--color-surface);
        --c-text: var(--color-text);
        --c-text-secondary: var(--color-text-secondary);
        --c-text-muted: var(--color-text-muted);
        --c-primary: var(--color-primary);
        --c-primary-light: var(--color-primary-soft);
        --c-accent: var(--color-accent);
        --c-accent-hover: var(--c-accent);
        --c-accent-light: var(--color-accent-soft);
        --c-route-line: var(--color-route);
        --c-border: var(--color-border);
        --c-success: var(--color-success);
        --c-success-bg: var(--color-success-soft);
        --c-error: var(--color-error);
        --c-error-bg: var(--color-error-soft);
        --c-slot-bg: var(--c-primary-light);
        --font-ja: var(--font-sans);
        --font-zh: var(--font-serif-zh);
        --font-pinyin: var(--font-sans);
        /* Legacy micro-radius (#365/#366) retained as a documented
         * transitional value; superseded by the semantic A1 radius scale. */
        --radius: 4px;
        --space-xs: 0.25rem;
        --space-sm: 0.5rem;
        --space-md: 1rem;
        --space-lg: 1.5rem;
        --space-xl: 2rem;
        --space-2xl: 3rem;
        --space-3xl: 4rem;
        --max-w: 48rem;
      }
      :root[data-theme-enabled='true'] {
        color-scheme: light;
        --paper: #FAF8F4;
        --paper-deep: #F4F0E9;
        --ink: #272522;
        --ink-secondary: #5E5A53;
        --ink-muted: #736C66;
        --hairline: #E6E1D8;
        --hairline-strong: #D6D0C5;
        --jade: #536B62;
        --jade-ink: #3E554D;
        --jade-soft: #E7ECE8;
        --coral: #E87961;
        --coral-deep: #B84C38;
        --coral-soft: #F6E6E1;
        --font-sans: 'Hiragino Sans', 'Noto Sans JP', 'Helvetica Neue', Arial, sans-serif;
        --font-serif-ja: 'Hiragino Mincho ProN', 'Yu Mincho', serif;
        --font-serif-zh: 'Songti TC', 'Songti SC', 'Hiragino Mincho ProN', serif;
        --sp-1: 4px;
        --sp-2: 8px;
        --sp-3: 12px;
        --sp-4: 16px;
        --sp-5: 20px;
        --sp-6: 24px;
        --sp-7: 28px;
        --sp-8: 32px;
        --sp-10: 40px;
        --sp-12: 48px;
        --radius-chip: 6px;
        --radius-control: 8px;
        --radius-content: 10px;
        --radius-card: 12px;
        --radius-hero: 16px;
        --color-page: var(--paper);
        --color-surface: #ffffff;
        --color-text: var(--ink);
        --color-text-secondary: var(--ink-secondary);
        --color-text-muted: var(--ink-muted);
        --color-primary: var(--jade);
        --color-primary-soft: var(--jade-soft);
        --color-accent: var(--coral);
        --color-accent-soft: var(--coral-soft);
        --color-route: var(--hairline-strong);
        --color-border: var(--hairline);
        --color-success: var(--jade);
        --color-success-soft: var(--jade-soft);
        --color-error: #b04435;
        --color-error-soft: #f5e8e4;
        --color-header: var(--paper);
        --color-header-text: var(--ink);
        --color-header-muted: var(--ink-muted);
        --color-on-primary: #ffffff;
        --color-on-status: #ffffff;
        --color-status-current: var(--jade-ink);
        --color-status-success: var(--jade-ink);
        --color-focus: var(--jade);
        --c-bg: var(--color-page);
        --c-surface: var(--color-surface);
        --c-text: var(--color-text);
        --c-text-secondary: var(--color-text-secondary);
        --c-text-muted: var(--color-text-muted);
        --c-primary: var(--color-primary);
        --c-primary-light: var(--color-primary-soft);
        --c-accent: var(--color-accent);
        --c-accent-hover: var(--c-accent);
        --c-accent-light: var(--color-accent-soft);
        --c-route-line: var(--color-route);
        --c-border: var(--color-border);
        --c-success: var(--color-success);
        --c-success-bg: var(--color-success-soft);
        --c-error: var(--color-error);
        --c-error-bg: var(--color-error-soft);
        --c-slot-bg: var(--c-primary-light);
        --font-ja: var(--font-sans);
        --font-zh: var(--font-serif-zh);
        --font-pinyin: var(--font-sans);
        --radius: 4px;
        --space-xs: 0.25rem;
        --space-sm: 0.5rem;
        --space-md: 1rem;
        --space-lg: 1.5rem;
        --space-xl: 2rem;
        --space-2xl: 3rem;
        --space-3xl: 4rem;
        --max-w: 80rem;
      }
      :root[data-theme-enabled='true'][data-theme='dark'] {
        color-scheme: dark;
        --paper: #1E1C19;
        --paper-deep: #2A2723;
        --ink: #EFE9E0;
        --ink-secondary: #C6BFB4;
        --ink-muted: #A29A8E;
        --hairline: #3A352D;
        --hairline-strong: #4C463D;
        --jade: #7FA093;
        --jade-ink: #A5C0B5;
        --jade-soft: #27302B;
        --coral: #F09380;
        --coral-deep: #EB8D74;
        --coral-soft: #352621;
        --color-page: var(--paper);
        --color-surface: var(--paper-deep);
        --color-text: var(--ink);
        --color-text-secondary: var(--ink-secondary);
        --color-text-muted: var(--ink-muted);
        --color-primary: var(--jade);
        --color-primary-soft: var(--jade-soft);
        --color-accent: var(--coral);
        --color-accent-soft: var(--coral-soft);
        --color-route: var(--hairline-strong);
        --color-border: var(--hairline);
        --color-success: var(--jade);
        --color-success-soft: var(--jade-soft);
        --color-error: #ee8d7d;
        --color-error-soft: #3a2222;
        --color-header: var(--paper);
        --color-header-text: var(--ink);
        --color-header-muted: var(--ink-muted);
        --color-on-primary: #11141c;
        --color-on-status: #11141c;
        --color-status-current: var(--jade-ink);
        --color-status-success: var(--jade-ink);
        --color-focus: var(--coral);
        --c-accent-hover: var(--color-accent);
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: var(--font-ja);
        background: var(--c-bg);
        color: var(--c-text);
        line-height: 1.7;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        overflow-wrap: anywhere;
      }
      a {
        color: var(--c-primary);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }
      button {
        font: inherit;
      }
      .skip-link {
        position: absolute;
        left: -9999px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        z-index: 100;
        background: var(--c-surface);
        color: var(--c-text);
        padding: 0.5rem 0.75rem;
        border: 2px solid var(--color-focus);
      }
      .skip-link:focus {
        position: fixed;
        left: var(--space-md);
        top: var(--space-md);
        width: auto;
        height: auto;
        overflow: visible;
        clip-path: none;
        white-space: normal;
      }
      :focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: 3px;
      }
      .wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
      }
      .main-content {
        flex: 1;
        padding: var(--sp-6) var(--sp-7) var(--sp-10);
        max-width: var(--max-w);
        width: 100%;
        margin: 0 auto;
      }
      @media (width <= 374px) {
        .main-content {
          padding-inline: var(--sp-5);
        }
      }
      @media (width >= 768px) {
        .main-content {
          padding: var(--space-xl);
        }
      }
      @media (width >= 1024px) {
        .main-content {
          padding-block: var(--space-2xl) var(--space-3xl);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">メインコンテンツへスキップ</a>
    <div class="wrapper">
      <slot name="header" />
      <main class="main-content" id="main-content" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>
