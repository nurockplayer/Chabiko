---

export interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
const metaDescription = description ?? 'Chabiko | チャビコ — 日本人のための中国語学習';
const url = new URL(Astro.url.pathname, Astro.site);
const canonical = url.href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    {robots && <meta name="robots" content={robots} />}
    <title>{title} | Chabiko</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={`${title} | Chabiko`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Chabiko" />
    <style>
      :root {
        --c-bg: #f4f1ec;
        --c-surface: #ffffff;
        --c-text: #1a1a2e;
        --c-text-secondary: #555570;
        --c-text-muted: #6a6a7d;
        --c-primary: #1a2744;
        --c-primary-light: #e8ecf3;
        --c-accent: #d48c2b;
        --c-accent-light: #f5e8d0;
        --c-route-line: #d0ccc4;
        --c-border: #e0dcd4;
        --c-success: #3d7b80;
        --c-success-bg: #e8f0f0;
        --c-error: #b84a3a;
        --c-error-bg: #f5e8e4;
        --c-slot-bg: var(--c-primary-light);
        --font-zh: 'PingFang TC', 'Noto Sans TC', 'Hiragino Sans', sans-serif;
        --font-ja: 'Hiragino Sans', 'Noto Sans JP', 'Helvetica Neue', Arial, sans-serif;
        --font-pinyin: 'Hiragino Sans', 'Noto Sans', 'Helvetica Neue', Arial, sans-serif;
        --radius: 0;
        --space-xs: 0.25rem;
        --space-sm: 0.5rem;
        --space-md: 1rem;
        --space-lg: 1.5rem;
        --space-xl: 2rem;
        --space-2xl: 3rem;
        --space-3xl: 4rem;
        --max-w: 80rem;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: var(--font-ja);
        background: var(--c-bg);
        color: var(--c-text);
        line-height: 1.7;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        overflow-wrap: anywhere;
      }
      a {
        color: var(--c-primary);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }
      button {
        font: inherit;
      }
      :focus-visible {
        outline: 2px solid var(--c-primary);
        outline-offset: 3px;
      }
      .wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
      }
      .main-content {
        flex: 1;
        padding: var(--space-lg) var(--space-md) var(--space-3xl);
        max-width: var(--max-w);
        width: 100%;
        margin: 0 auto;
      }
      @media (width <= 374px) {
        .main-content {
          padding-inline: var(--space-md);
        }
      }
      @media (width >= 768px) {
        .main-content {
          padding: var(--space-xl);
        }
      }
      @media (width >= 1024px) {
        .main-content {
          padding-block: var(--space-2xl) var(--space-3xl);
        }
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <slot name="header" />
      <main class="main-content">
        <slot />
      </main>
    </div>
  </body>
</html>
