---
import type { TaiwanTravelAssessmentPayload } from '../content/taiwanTravelAssessmentPayload';

export interface Props {
  payload: TaiwanTravelAssessmentPayload;
  payloadJson: string;
}

const { payload, payloadJson } = Astro.props;
const { lessonIds } = payload;
const total = lessonIds.length;
---

<section
  class="taiwan-travel-quiz"
  data-taiwan-travel-quiz
>
  <nav class="taiwan-travel-quiz-back">
    <a href="/">← 台湾旅行に戻る</a>
  </nav>

  <p class="taiwan-travel-quiz-total" data-quiz-total>対象 {total}レッスン</p>
  <p class="taiwan-travel-quiz-progress" data-quiz-progress aria-live="polite">0 / {total}</p>
  <p class="taiwan-travel-quiz-score" data-quiz-score>正解 0 / {total}</p>

  <div class="taiwan-travel-quiz-card" data-quiz-card></div>

  <script type="application/json" id="taiwan-travel-quiz-data" set:html={payloadJson} is:inline></script>
</section>

<script>
  import { initTaiwanTravelQuiz } from '../client/taiwanTravelQuiz';

  function initialiseQuiz(): void {
    document.querySelectorAll<HTMLElement>('[data-taiwan-travel-quiz]').forEach((root) => {
      initTaiwanTravelQuiz(root);
    });
  }

  initialiseQuiz();
  document.addEventListener('astro:page-load', initialiseQuiz);
</script>

<style is:global>
  .taiwan-travel-quiz {
    width: 100%;
    min-width: 0;
  }

  .taiwan-travel-quiz-back {
    margin: 0 0 var(--space-lg);
  }

  .taiwan-travel-quiz-back a {
    display: inline-block;
    min-height: 2.75rem;
    padding: var(--space-sm) 0;
    font-weight: 600;
  }

  .taiwan-travel-quiz-total {
    margin: 0 0 var(--space-xs);
    color: var(--c-text-secondary);
    font-size: 0.8125rem;
    text-align: right;
  }

  .taiwan-travel-quiz-progress,
  .taiwan-travel-quiz-score {
    margin: 0 0 var(--space-sm);
    color: var(--c-text-secondary);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .taiwan-travel-quiz-card {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 3vw, 1.25rem);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-surface);
    padding: clamp(1rem, 5vw, 2rem);
    text-align: center;
  }

  .taiwan-travel-quiz-prompt {
    max-width: 100%;
    margin: 0;
    color: var(--c-text);
    font-size: clamp(1.125rem, 5vw, 1.5rem);
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .taiwan-travel-quiz-options {
    display: grid;
    gap: var(--space-sm);
    width: min(100%, 22rem);
  }

  .taiwan-travel-quiz-option,
  .taiwan-travel-quiz-action {
    box-sizing: border-box;
    min-height: 2.75rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-surface);
    color: var(--c-text);
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }

  .taiwan-travel-quiz-option {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    overflow-wrap: anywhere;
  }

  .taiwan-travel-quiz-option:hover:not(:disabled) {
    background: var(--c-slot-bg);
  }

  .taiwan-travel-quiz-option:focus-visible,
  .taiwan-travel-quiz-action:focus-visible {
    outline: 3px solid var(--c-accent);
    outline-offset: 3px;
  }

  .taiwan-travel-quiz-option[aria-pressed='true'] {
    border-color: var(--c-accent);
    background: var(--c-accent-light);
    color: var(--c-primary);
  }

  .taiwan-travel-quiz-option[data-correct='true'] {
    border-color: #166534;
    background: #dcfce7;
    color: #166534;
  }

  .taiwan-travel-quiz-option[data-wrong='true'] {
    border-color: #991b1b;
    background: #fee2e2;
    color: #991b1b;
  }

  .taiwan-travel-quiz-option:disabled {
    cursor: default;
    opacity: 0.75;
  }

  .taiwan-travel-quiz-action {
    width: min(100%, 22rem);
    padding: var(--space-sm) var(--space-md);
  }

  .taiwan-travel-quiz-submit,
  .taiwan-travel-quiz-next {
    border-color: var(--c-accent);
    background: var(--c-accent);
    color: #fff;
  }

  .taiwan-travel-quiz-submit:hover:not(:disabled),
  .taiwan-travel-quiz-next:hover {
    background: var(--c-accent-hover);
  }

  .taiwan-travel-quiz-submit:disabled {
    cursor: default;
    opacity: 0.55;
    background: var(--c-slot-bg);
    border-color: var(--c-border);
    color: var(--c-text-muted);
  }

  .taiwan-travel-quiz-restart {
    background: var(--c-surface);
    color: var(--c-accent);
    border-color: var(--c-accent);
  }

  .taiwan-travel-quiz-feedback {
    margin: 0;
    color: var(--c-text);
    font-size: clamp(1rem, 4.5vw, 1.2rem);
    font-weight: 600;
  }

  .taiwan-travel-quiz-answer {
    margin: 0;
    color: var(--c-text-secondary);
    font-size: clamp(0.9375rem, 4vw, 1.0625rem);
    overflow-wrap: anywhere;
  }

  .taiwan-travel-quiz-completion {
    gap: clamp(0.75rem, 3vw, 1.25rem);
  }

  .taiwan-travel-quiz-completion-title {
    margin: 0;
    color: var(--c-text);
    font-size: clamp(1.25rem, 6vw, 1.75rem);
    overflow-wrap: anywhere;
  }

  .taiwan-travel-quiz-completion-score {
    margin: 0;
    color: var(--c-text);
    font-size: clamp(1.125rem, 5vw, 1.375rem);
    font-variant-numeric: tabular-nums;
  }

  .taiwan-travel-quiz-completion-best {
    margin: 0;
    color: var(--c-text-secondary);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  .taiwan-travel-quiz-unavailable {
    margin: 0;
    color: var(--c-text-secondary);
    font-size: 0.9375rem;
  }
</style>
