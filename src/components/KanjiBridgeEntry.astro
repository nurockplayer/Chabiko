---
import type { KanjiBridgeEntry } from '../content/loadKanjiBridge';

interface Props {
  entry: KanjiBridgeEntry;
}

const { entry } = Astro.props;

const RELATION_LABELS: Record<KanjiBridgeEntry['similarityType'], string> = {
  'same-meaning': '同じ意味',
  'partial-overlap': '一部が重なる',
  'false-friend': '見せかけの同義語',
};

const REVIEW_STATUS_LABELS: Record<KanjiBridgeEntry['reviewStatus'], string> = {
  draft: '未レビュー',
  reviewed: 'レビュー済み',
  published: '公開済み',
};

const relationLabel = RELATION_LABELS[entry.similarityType];
const reviewLabel = REVIEW_STATUS_LABELS[entry.reviewStatus];
const sourceLabel = entry.source.type === 'generated' ? 'AI生成・未検証' : '学習用データ';
const provenance = `${sourceLabel}（${reviewLabel}）`;
const example = entry.examples[0];
---

<li
  class="kanji-bridge-entry"
  data-kanji-bridge-entry
  data-relation={entry.similarityType}
>
  <div class="kanji-bridge-entry__head">
    <h2
      class="kanji-bridge-entry__headword"
      lang="zh-Hant"
      data-script-path-default={entry.traditional}
      data-script-path-default-status={entry.traditionalStatus}
      data-script-traditional={entry.traditional}
      data-script-traditional-status={entry.traditionalStatus}
      data-script-simplified={entry.simplified}
      data-script-simplified-status={entry.simplifiedStatus}
    >
      {entry.traditional}
      <span class="script-fallback" lang="ja">この表記は未収録のため、コース標準を表示しています。</span>
    </h2>
    <p class="kanji-bridge-entry__pinyin" lang="zh-Latn">{entry.pinyin}</p>
  </div>

  <dl class="kanji-bridge-entry__meta">
    <div class="kanji-bridge-entry__meta-row">
      <dt lang="ja">意味</dt>
      <dd lang="ja">
        <span class="kanji-bridge-entry__japanese">{entry.japanese}</span>
        <span class="kanji-bridge-entry__kana">（{entry.kana}）</span>
      </dd>
    </div>
    <div class="kanji-bridge-entry__meta-row">
      <dt lang="ja">関係</dt>
      <dd lang="ja" class="kanji-bridge-entry__relation">{relationLabel}</dd>
    </div>
  </dl>

  <p class="kanji-bridge-entry__tone-note" lang="ja">
    <span class="kanji-bridge-entry__note-label">声調メモ：</span>
    {entry.toneNote}
  </p>

  {
    entry.caution && (
      <p class="kanji-bridge-entry__caution" lang="ja">
        <span class="kanji-bridge-entry__note-label">注意：</span>
        {entry.caution}
      </p>
    )
  }

  <div class="kanji-bridge-entry__example">
    <p class="kanji-bridge-entry__example-label" lang="ja">例文</p>
    <p class="kanji-bridge-entry__example-text" lang="zh-Hant">{example.traditional}</p>
    <p class="kanji-bridge-entry__example-pinyin" lang="zh-Latn">{example.pinyin}</p>
    <p class="kanji-bridge-entry__example-japanese" lang="ja">{example.japanese}</p>
  </div>

  <p class="kanji-bridge-entry__provenance" lang="ja">{provenance}</p>
</li>

<style>
  .kanji-bridge-entry {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: var(--space-lg);
    overflow-wrap: anywhere;
    word-break: normal;
    list-style: none;
  }
  .kanji-bridge-entry__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }
  .kanji-bridge-entry__headword {
    font-size: 1.5rem;
    line-height: 1.3;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .kanji-bridge-entry__pinyin {
    margin: 0;
    font-size: 0.875rem;
    color: var(--c-text-secondary);
    overflow-wrap: anywhere;
  }
  .script-fallback {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--c-text-secondary);
    overflow-wrap: anywhere;
  }
  .kanji-bridge-entry__meta {
    margin: 0 0 var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .kanji-bridge-entry__meta-row {
    display: flex;
    gap: var(--space-sm);
    min-width: 0;
  }
  .kanji-bridge-entry__meta-row dt {
    flex: 0 0 auto;
    min-width: 2.5rem;
    font-weight: 700;
    color: var(--c-text-secondary);
  }
  .kanji-bridge-entry__meta-row dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .kanji-bridge-entry__relation {
    font-weight: 600;
  }
  .kanji-bridge-entry__tone-note,
  .kanji-bridge-entry__caution {
    margin: 0 0 var(--space-sm);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
  .kanji-bridge-entry__caution {
    background: var(--c-accent-light);
    border-radius: var(--radius);
    padding: var(--space-sm) var(--space-md);
  }
  .kanji-bridge-entry__note-label {
    font-weight: 700;
  }
  .kanji-bridge-entry__example {
    margin: var(--space-md) 0;
    padding: var(--space-md);
    border-left: 3px solid var(--c-accent);
    background: var(--c-slot-bg);
    min-width: 0;
  }
  .kanji-bridge-entry__example-label {
    margin: 0 0 var(--space-sm);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--c-text-secondary);
  }
  .kanji-bridge-entry__example-text {
    margin: 0 0 var(--space-xs);
    font-size: 1.125rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .kanji-bridge-entry__example-pinyin,
  .kanji-bridge-entry__example-japanese {
    margin: 0;
    font-size: 0.875rem;
    color: var(--c-text-secondary);
    overflow-wrap: anywhere;
  }
  .kanji-bridge-entry__provenance {
    margin: var(--space-sm) 0 0;
    font-size: 0.75rem;
    color: var(--c-text-muted);
    overflow-wrap: anywhere;
  }
</style>
