---
import type { TonePracticeItem } from '../domain/tonePractice';

export interface Props {
  items: readonly TonePracticeItem[];
}

const { items } = Astro.props;

const serialized = JSON.stringify({
  items: items.map((item) => ({
    recordId: item.recordId,
    promptJa: item.promptJa,
    correctAnswer: item.correctAnswer,
    distractors: item.distractors.map((choice) => choice),
    contrastId: item.contrastId,
    toneContourId: item.toneContourId,
    toneContourHintJa: item.toneContourHintJa,
    interferenceJa: item.interferenceJa,
  })),
});
---

<div
  class="tone-practice"
  data-tone-practice
  data-tone-session={serialized}
>
  <div class="tone-practice-header">
    <p class="tone-practice-progress" data-tone-progress></p>
    <p class="tone-practice-prompt" data-tone-prompt></p>
  </div>

  <div class="tone-contour" data-tone-contour aria-hidden="true">
    <span class="tone-contour__label" data-tone-contour-label></span>
  </div>
  <p class="tone-hint" data-tone-hint></p>
  <p class="tone-interference" data-tone-interference></p>

  <div class="tone-choices" data-tone-choices role="group" aria-label="声調を選ぶ"></div>

  <div class="tone-feedback" data-tone-feedback role="status" aria-live="polite" aria-atomic="true"></div>

  <div class="tone-actions" data-tone-actions></div>
</div>

<script>
  import { mountTonePractice } from '../client/tonePractice';

  function initialisePractices() {
    document.querySelectorAll<HTMLElement>('[data-tone-practice]').forEach((root) => {
      try {
        mountTonePractice(root);
      } catch (error) {
        // A rejected or missing tone-discrimination record must not take the
        // whole page down; the container stays empty and the error is
        // surfaced to the console for diagnosis.
        console.error('tone practice failed to mount', error);
      }
    });
  }

  initialisePractices();
  document.addEventListener('astro:page-load', initialisePractices);
</script>

<style>
  .tone-practice {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .tone-practice-header {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .tone-practice-progress {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .tone-practice-prompt {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .tone-contour {
    box-sizing: border-box;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 5rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-content);
    background: var(--paper-deep);
    padding: var(--sp-4);
    overflow: hidden;
  }

  .tone-contour__label {
    display: inline-block;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
  }

  .tone-hint {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .tone-interference {
    margin: 0;
    border-left: 3px solid var(--coral);
    background: var(--coral-soft);
    padding: var(--sp-2) var(--sp-4);
    color: var(--ink-secondary);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .tone-choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-2);
  }

  .tone-choice {
    box-sizing: border-box;
    min-height: 2.75rem;
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-control);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, opacity 0.15s;
    overflow-wrap: anywhere;
  }

  .tone-choice:hover:not(:disabled) {
    background: var(--paper-deep);
    border-color: var(--jade);
  }

  .tone-choice[aria-pressed='true'] {
    border-color: var(--jade);
    background: var(--jade-soft);
    color: var(--jade-ink);
  }

  .tone-choice:disabled {
    cursor: default;
    opacity: 0.6;
  }

  /* The chosen answer stays fully visible after submit while the other
   * choices dim, so the selected state survives the feedback transition. */
  .tone-choice:disabled[aria-pressed='true'] {
    opacity: 1;
  }

  .tone-feedback {
    min-height: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .tone-feedback__line {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .tone-feedback--correct {
    color: var(--jade-ink);
    font-weight: 700;
  }

  .tone-feedback--incorrect {
    border-left: 4px solid var(--coral);
    background: var(--coral-soft);
    padding: var(--sp-2) var(--sp-4);
  }

  .tone-feedback--incorrect .tone-feedback__line:first-child {
    font-weight: 700;
  }

  .tone-feedback--incorrect strong {
    font-weight: 700;
  }

  .tone-feedback--complete {
    text-align: center;
    padding: var(--sp-6) var(--sp-4);
    background: var(--jade-soft);
  }

  .tone-complete-text {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .tone-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .tone-action {
    box-sizing: border-box;
    flex: 1 1 auto;
    min-height: 2.75rem;
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-control);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
    overflow-wrap: anywhere;
  }

  .tone-action:hover:not(:disabled) {
    background: var(--paper-deep);
  }

  .tone-action:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .tone-action--submit,
  .tone-action--next,
  .tone-action--restart {
    border-color: var(--jade);
    background: var(--jade);
    color: var(--paper);
  }

  .tone-action--submit:hover:not(:disabled),
  .tone-action--next:hover:not(:disabled),
  .tone-action--restart:hover:not(:disabled) {
    background: var(--jade-ink);
    border-color: var(--jade-ink);
  }

  .tone-action--retry {
    border-color: var(--coral-deep);
    color: var(--coral-deep);
  }

  .tone-action--retry:hover:not(:disabled) {
    background: var(--coral-soft);
  }

  @media (width <= 374px) {
    .tone-choice {
      padding-inline: var(--sp-2);
      font-size: 1rem;
    }

    .tone-action {
      padding-inline: var(--sp-2);
      font-size: 0.875rem;
    }
  }
</style>
