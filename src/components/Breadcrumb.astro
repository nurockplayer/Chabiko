---
/**
 * Semantic breadcrumb (#366 contextual-wayfinding contract).
 *
 * Renders a breadcrumb trail `ホーム › track › current surface` as a labelled
 * landmark with an ordered list. The last crumb is the current page and is
 * rendered as a non-link `<span aria-current="page">`, so the current location
 * is identifiable without colour alone (bold + aria-current, and it is not a
 * focusable link). Separators are decorative CSS-generated `›` marks, so they
 * are not announced by assistive technology. Long Japanese labels wrap safely.
 *
 * Pages without a meaningful trail may omit the breadcrumb entirely.
 */
export interface BreadcrumbCrumb {
  label: string;
  /** Destination. Omit for the current (last) crumb. */
  href?: string;
}

export interface Props {
  crumbs: BreadcrumbCrumb[];
  /** Accessible name for the breadcrumb landmark. */
  label?: string;
}

const { crumbs, label = 'パンくず' } = Astro.props;
---

<nav class="breadcrumb" aria-label={label}>
  <ol class="breadcrumb__list">
    {crumbs.map((crumb, index) => {
      const isLast = index === crumbs.length - 1;
      return (
        <li class="breadcrumb__item">
          {crumb.href !== undefined && !isLast ? (
            <a class="breadcrumb__link" href={crumb.href}>
              {crumb.label}
            </a>
          ) : (
            <span class="breadcrumb__current" aria-current={isLast ? 'page' : undefined}>
              {crumb.label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumb {
    margin: 0 0 var(--space-lg);
    min-width: 0;
  }
  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }
  .breadcrumb__item {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* Decorative separator between non-first items; not announced by AT. */
  .breadcrumb__item + .breadcrumb__item::before {
    content: '›';
    margin-inline: var(--space-xs);
    color: var(--c-text-muted);
    line-height: 1;
  }
  .breadcrumb__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-primary);
  }
  .breadcrumb__current {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-text);
    font-weight: 700;
  }
</style>
