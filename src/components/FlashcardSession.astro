---
import type { HskRenderableEntry } from '../content/loadHskVocabulary';

export interface Props {
  entries: HskRenderableEntry[];
  answerSource: string;
}

const { entries, answerSource } = Astro.props;

const json = JSON.stringify({
  ids: entries.map((e) => e.id),
  answerSource,
});
---

<div class="flashcard-session-root" data-session={json}>
  {entries.length === 0 ? (
    <p class="flashcard-fallback">単語データがありません。</p>
  ) : (
    <>
      <!-- Setup panel – visible before session starts and on restart -->
      <div id="setup-panel" class="setup-panel">
        <div class="setup-group">
          <span class="setup-label">セッションサイズ</span>
          <div class="setup-options" role="radiogroup" aria-label="セッションサイズ">
            <button id="size-10" class="setup-option setup-option--active" type="button"
                    role="radio" aria-checked="true" data-size="10">10語</button>
            <button id="size-20" class="setup-option" type="button"
                    role="radio" aria-checked="false" data-size="20">20語</button>
          </div>
        </div>
        <div class="setup-group">
          <span class="setup-label">学習方向</span>
          <div class="setup-options" role="radiogroup" aria-label="学習方向">
            <button id="dir-zh-ja" class="setup-option setup-option--active" type="button"
                    role="radio" aria-checked="true" data-dir="zh-to-ja">中国語 → 日本語</button>
            <button id="dir-ja-zh" class="setup-option" type="button"
                    role="radio" aria-checked="false" data-dir="ja-to-zh">日本語 → 中国語</button>
          </div>
        </div>
        <p id="setup-count" class="setup-count"></p>
        <button id="btn-start" class="flashcard-btn flashcard-btn--reveal" type="button"
                disabled aria-busy="true">
          スタート
        </button>
        <p id="session-load-error" class="session-load-error" role="status" hidden></p>
      </div>

      <!-- Active session area – hidden during setup -->
      <div id="session-area" class="hidden">
        <div class="flashcard-footer">
          <div id="flashcard-progress" class="flashcard-progress" aria-live="polite">
            <span data-progress-text></span>
          </div>
          <button id="btn-reset-progress" class="flashcard-reset-btn" type="button" hidden>
            学習記録をリセット
          </button>
        </div>

        <div class="flashcard-container">
          <div class="flashcard-card" id="flashcard-card">
            <p data-front class="flashcard-front" lang="zh-Hans"></p>
            <div data-back class="flashcard-back hidden">
              <p data-pinyin class="flashcard-pinyin" lang="zh-Latn"></p>
              <p data-japanese class="flashcard-japanese"></p>
              <p data-traditional class="flashcard-traditional" lang="zh-Hant" style="display:none"></p>
              <p data-progress-hint class="flashcard-progress-hint hidden"></p>
            </div>
          </div>

          <div class="flashcard-actions">
            <button id="btn-reveal" class="flashcard-btn flashcard-btn--reveal" type="button">
              答えを見る
            </button>
            <div id="rating-actions" class="flashcard-ratings hidden">
              <button id="btn-again" class="flashcard-btn flashcard-btn--again" type="button">
                もう一度
              </button>
              <button id="btn-unsure" class="flashcard-btn flashcard-btn--unsure" type="button">
                まだ曖昧
              </button>
              <button id="btn-known" class="flashcard-btn flashcard-btn--known" type="button">
                覚えた
              </button>
            </div>
          </div>
        </div>
      </div>

      <template id="completion-template">
        <div class="flashcard-completion" role="status">
          <p class="flashcard-completion-icon">&#x2714;</p>
          <p class="flashcard-completion-text">セッション完了！</p>
          <button id="btn-restart" class="flashcard-btn flashcard-btn--restart" type="button">
            もう一度
          </button>
        </div>
      </template>
    </>
  )}
</div>

<script>
  import { mountRemoteFlashcardSession } from '../client/flashcardSession';
  import type { RemoteSessionData } from '../client/flashcardSession';

  (function () {
    const root = document.querySelector('.flashcard-session-root') as HTMLElement | null;
    if (!root) return;
    const raw = root.getAttribute('data-session');
    if (!raw) return;
    void mountRemoteFlashcardSession(JSON.parse(raw) as RemoteSessionData);
  })();
</script>

<style>
  .flashcard-session-root {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }
  .flashcard-fallback {
    text-align: center; color: var(--ink-secondary); padding: var(--sp-8);
  }

  /* ── Setup panel ──────────────────────────────────────────────────────── */
  .setup-panel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    max-width: 28rem;
    margin: 0 auto;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-control);
    padding: var(--sp-6);
    box-sizing: border-box;
    min-width: 0;
  }
  .setup-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .setup-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-secondary);
  }
  .setup-options {
    display: flex;
    gap: var(--sp-2);
    min-width: 0;
  }
  .setup-option {
    flex: 1;
    min-width: 0;
    padding: var(--sp-2) var(--sp-4);
    border: 2px solid var(--hairline-strong);
    border-radius: var(--radius-control);
    background: var(--paper);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .setup-option:hover {
    border-color: var(--jade);
  }
  .setup-option--active {
    border-color: var(--jade);
    background: var(--jade-soft);
    color: var(--jade-ink);
  }
  .setup-option:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .setup-count {
    font-size: 0.8rem;
    color: var(--ink-secondary);
    margin: 0;
  }
  .session-load-error {
    color: var(--coral-deep);
    font-size: 0.8rem;
    margin: 0;
  }

  /* ── Footer ───────────────────────────────────────────────────────────── */
  .flashcard-footer {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: var(--sp-4);
  }
  .flashcard-progress {
    font-size: 0.85rem; color: var(--ink-secondary);
  }
  .flashcard-reset-btn {
    font-size: 0.7rem; padding: 2px var(--sp-2);
    border: 1px solid var(--hairline); border-radius: var(--radius-control);
    background: transparent; color: var(--ink-secondary); cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .flashcard-reset-btn:hover { border-color: var(--coral-deep); color: var(--coral-deep); }

  /* ── Card ─────────────────────────────────────────────────────────────── */
  .flashcard-container {
    display: flex; flex-direction: column; align-items: center;
    gap: var(--sp-8); max-width: 36rem; margin: 0 auto;
    min-width: 0;
  }
  .flashcard-card {
    width: 100%; min-height: 14rem;
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; gap: var(--sp-4);
    background: var(--paper-deep); border: 1px solid var(--hairline);
    border-radius: var(--radius-card); padding: var(--sp-8); text-align: center;
    box-sizing: border-box;
    min-width: 0;
  }
  .flashcard-front {
    font-family: var(--font-serif-zh);
    font-size: 52px; font-weight: 700; line-height: 1.2;
    color: var(--ink); margin: 0; overflow-wrap: anywhere;
  }
  .flashcard-back {
    display: flex; flex-direction: column; gap: var(--sp-1); width: 100%;
  }
  .flashcard-pinyin {
    font-size: 1.25rem; color: var(--ink-muted); font-weight: 600; margin: 0;
  }
  .flashcard-japanese {
    font-size: 1.1rem; color: var(--ink); margin: 0;
  }
  .flashcard-traditional {
    font-size: 0.9rem; color: var(--ink-secondary); margin: var(--sp-1) 0 0;
  }
  .flashcard-progress-hint {
    font-size: 0.75rem; color: var(--jade-ink); margin: var(--sp-1) 0 0;
  }

  /* ── Actions ──────────────────────────────────────────────────────────── */
  .flashcard-actions {
    width: 100%; display: flex; flex-direction: column; gap: var(--sp-2);
    min-width: 0;
  }
  .flashcard-ratings {
    display: flex; gap: var(--sp-2); width: 100%; min-width: 0;
  }
  .hidden { display: none !important; }
  .flashcard-ratings.hidden { display: none !important; }
  .flashcard-btn {
    display: block; width: 100%;
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--hairline-strong); border-radius: var(--radius-control);
    background: var(--paper); color: var(--ink);
    font-size: 1rem; font-weight: 600; cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    box-sizing: border-box;
  }
  .flashcard-btn:hover:not(:disabled) { background: var(--jade-soft); }
  .flashcard-btn:focus-visible {
    outline: 3px solid var(--color-focus); outline-offset: 3px;
  }
  .flashcard-btn--reveal {
    background: var(--coral-deep); color: var(--color-on-primary); border-color: var(--coral-deep);
  }
  .flashcard-btn--reveal:hover:not(:disabled) {
    background: var(--coral-deep); border-color: var(--coral-deep);
    box-shadow: 0 0 0 3px var(--coral-soft);
  }
  .flashcard-btn--reveal.hidden { display: none !important; }
  .flashcard-btn--again {
    flex: 1; border-color: var(--coral-deep); color: var(--coral-deep);
  }
  .flashcard-btn--again:hover:not(:disabled) { background: var(--coral-soft); }
  .flashcard-btn--unsure {
    flex: 1; border-color: var(--ink-secondary); color: var(--ink-secondary);
  }
  .flashcard-btn--unsure:hover:not(:disabled) { background: var(--paper-deep); }
  .flashcard-btn--known {
    flex: 1; border-color: var(--jade-ink); color: var(--jade-ink);
  }
  .flashcard-btn--known:hover:not(:disabled) { background: var(--jade-soft); }
  .flashcard-btn--restart {
    margin-top: var(--sp-4);
    background: var(--coral-deep); color: var(--color-on-primary); border-color: var(--coral-deep);
  }
  .flashcard-btn--restart:hover:not(:disabled) {
    background: var(--coral-deep); border-color: var(--coral-deep);
    box-shadow: 0 0 0 3px var(--coral-soft);
  }

  /* ── Completion ───────────────────────────────────────────────────────── */
  .flashcard-completion {
    text-align: center; padding: var(--sp-8) 0;
  }
  .flashcard-completion-icon {
    font-size: 2.5rem; margin: 0 0 var(--sp-2);
  }
  .flashcard-completion-text {
    font-size: 1.25rem; font-weight: 700; margin: 0 0 var(--sp-4);
  }

  @media (width <= 374px) {
    .flashcard-front { font-size: 44px; }
  }
  @media (width >= 640px) {
    .flashcard-ratings { gap: var(--sp-4); }
  }
</style>
