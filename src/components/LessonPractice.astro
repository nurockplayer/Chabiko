---
import { generateQuestions } from '../lib/practice';
import type { Lesson } from '../types/lesson';

export interface Props {
  lesson: Lesson;
}

const { lesson } = Astro.props;
const questions = generateQuestions(lesson);
const json = JSON.stringify(questions);
---

{
  questions.length > 0 && (
    <section class="lesson-practice" aria-labelledby="practice-heading" data-questions={json}>
      <p class="practice-label">確認クイズ</p>
      <h2 id="practice-heading">練習</h2>
      <p class="practice-intro">各質問に答えて、レッスンを完了しましょう。</p>
      <div id="practice-root" aria-live="polite">
        <p class="loading-placeholder">読み込み中…</p>
      </div>
    </section>
  )
}

<script>
  import { ProgressStore } from '../lib/progress';
  import { createSession, answer, getCurrentQuestion, getCurrentIndex } from '../lib/practiceSession';
  import { createTimeoutManager } from '../lib/timeoutManager';
  import { handleProgressStorageEvent } from '../lib/progressSnapshot';
  import { computeRefresh } from '../lib/practiceRefresh';

  (function () {
  const practiceRoot = document.getElementById('practice-root');
  const practiceSection = practiceRoot?.closest('[data-questions]') as HTMLElement | null;
  if (!practiceRoot || !practiceSection) return;
  const root: HTMLElement = practiceRoot;

  const questions: Array<{
    promptJa: string;
    correctAnswer: string;
    choices: string[];
    lessonId: string;
  }> = JSON.parse(practiceSection.getAttribute('data-questions') ?? '[]');

  if (questions.length === 0) {
    root.textContent = '';
  } else {
    let store = new ProgressStore();
    let session: import('../lib/practiceSession').PracticeSession = createSession(questions);
    const timer = createTimeoutManager();

    function syncBadge() {
      const badge = document.getElementById('lesson-completion-badge');
      if (badge) {
        badge.textContent = '✔ 完了済み';
        badge.className = 'completion-badge completion-badge--done';
      }
    }

    function renderCompleted() {
      // markComplete already called in handleAnswer for the last correct answer
      syncBadge();
      root.innerHTML =
        '<div class="practice-complete" role="status" aria-live="polite"><p class="practice-complete-icon" aria-hidden="true">&#x2714;</p><p class="practice-complete-text">練習完了！レッスンをクリアしました。</p></div>';
      const complete = root.querySelector('.practice-complete') as HTMLElement | null;
      if (complete) complete.tabIndex = -1;
    }

    function render() {
      const currentQ = getCurrentQuestion(session);
      if (!currentQ) {
        renderCompleted();
        return;
      }

      const isComplete = store.isComplete(session.lessonId);
      if (isComplete && getCurrentIndex(session) === 0) {
        root.innerHTML =
          '<div class="practice-complete" role="status" aria-live="polite"><p class="practice-complete-icon" aria-hidden="true">&#x2714;</p><p class="practice-complete-text">このレッスンは既に完了しています。</p></div>';
        const complete = root.querySelector('.practice-complete') as HTMLElement | null;
        if (complete) complete.tabIndex = -1;
        return;
      }

      root.innerHTML =
        '<div class="practice-question">' +
        '<p class="practice-progress">' +
        '質問 ' +
        (getCurrentIndex(session) + 1) +
        ' / ' +
        questions.length +
        '</p>' +
        '<p class="practice-prompt">' +
        escapeHtml(currentQ.promptJa) +
        '</p>' +
        '<div class="practice-choices" role="group" aria-label="回答を選択">' +
        currentQ.choices
          .map(
            (choice, i) =>
              '<button class="practice-choice" data-value="' +
              escapeHtml(choice) +
              '" data-index="' +
              i +
              '"><span class="practice-choice__indicator" aria-hidden="true"></span><span class="practice-choice__label">' +
              escapeHtml(choice) +
              '</span></button>',
          )
          .join('') +
        '</div>' +
        '<div class="practice-feedback" role="status" aria-live="polite" aria-atomic="true"></div>' +
        '</div>';

      root.querySelectorAll('.practice-choice').forEach((btn) => {
        btn.addEventListener('click', () => handleAnswer(btn as HTMLButtonElement));
      });
    }

    function handleAnswer(btn: HTMLButtonElement) {
      const selected = btn.getAttribute('data-value') ?? '';
      const feedback = root.querySelector('.practice-feedback') as HTMLElement;
      const choices = root.querySelectorAll('.practice-choice');

      if (!feedback) return;

      const result = answer(session, selected);
      session = result.session;

      if (result.feedback.kind === 'correct') {
        btn.classList.add('practice-choice--correct');
        btn.setAttribute('aria-label', '正解: ' + selected);
        feedback.innerHTML =
          '<p class="feedback-correct"><span class="feedback-icon" aria-hidden="true">✓</span><span>正解！</span></p>';
        feedback.className = 'practice-feedback feedback-visible';
        choices.forEach((c) => (c as HTMLButtonElement).disabled = true);
        feedback.tabIndex = -1;
        feedback.focus();
        if (result.session.status === 'completed') {
          // Write completion to storage immediately, before the animation timeout
          store.markComplete(session.lessonId);
          timer.schedule(() => {
            // Decide focus before the re-render replaces the feedback element:
            // only take focus if the user has not moved it elsewhere (e.g. Tab
            // into the lesson navigation) during the feedback window.
            const shouldTakeFocus = feedback.contains(document.activeElement);
            renderCompleted();
            if (shouldTakeFocus) {
              const complete = root.querySelector('.practice-complete') as HTMLElement | null;
              if (complete) complete.focus();
            }
          }, 1200);
        } else {
          timer.schedule(() => {
            const shouldTakeFocus = feedback.contains(document.activeElement);
            render();
            if (shouldTakeFocus) {
              const firstChoice = root.querySelector('.practice-choice') as HTMLButtonElement | null;
              if (firstChoice) firstChoice.focus();
            }
          }, 1200);
        }
      } else {
        btn.classList.add('practice-choice--incorrect');
        btn.setAttribute('aria-label', '選択した回答、不正解: ' + selected);
        feedback.innerHTML =
          '<p class="feedback-incorrect"><span class="feedback-icon" aria-hidden="true">✕</span><span>不正解。</span></p><p class="feedback-answer">正解：' +
          escapeHtml(result.feedback.correctAnswer ?? '') +
          '</p>';
        feedback.className = 'practice-feedback feedback-visible feedback-visible--incorrect';
        choices.forEach((c) => (c as HTMLButtonElement).disabled = true);
        feedback.tabIndex = -1;
        feedback.focus();
        timer.schedule(() => {
          // Preserve an explicit focus move away from the feedback.
          const shouldTakeFocus = feedback.contains(document.activeElement);
          render();
          if (shouldTakeFocus) {
            const firstChoice = root.querySelector('.practice-choice') as HTMLButtonElement | null;
            if (firstChoice) firstChoice.focus();
          }
        }, 2000);
      }
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    render();

    // Refresh state on pageshow (browser back/forward cache).
    // Preserves active session position so returning via bfcache
    // keeps the learner at their current question.
    window.addEventListener('pageshow', () => {
      timer.clear();
      store = new ProgressStore();
      const outcome = computeRefresh(store, session, questions);
      session = outcome.session;
      if (outcome.kind === 'completed') {
        syncBadge();
        root.innerHTML =
          '<div class="practice-complete" role="status" aria-live="polite"><p class="practice-complete-icon" aria-hidden="true">&#x2714;</p><p class="practice-complete-text">練習完了！レッスンをクリアしました。</p></div>';
      } else if (outcome.kind === 'reset') {
        const badge = document.getElementById('lesson-completion-badge');
        if (badge) {
          badge.textContent = '';
          badge.className = 'completion-badge';
        }
        render();
      } else {
        const badge = document.getElementById('lesson-completion-badge');
        if (badge) {
          badge.textContent = '';
          badge.className = 'completion-badge';
        }
        render();
      }
    });

    // Cross-tab storage synchronisation.
    // Only reacts to the Chabiko progress key, so unrelated keys
    // (user preferences, other apps) never affect practice state.
    window.addEventListener('storage', (event) => {
      handleProgressStorageEvent(event, () => {
        timer.clear();
        store = new ProgressStore();
        const outcome = computeRefresh(store, session, questions);
        session = outcome.session;
        if (outcome.kind === 'completed') {
          syncBadge();
          root.innerHTML =
            '<div class="practice-complete" role="status" aria-live="polite"><p class="practice-complete-icon" aria-hidden="true">&#x2714;</p><p class="practice-complete-text">練習完了！レッスンをクリアしました。</p></div>';
        } else if (outcome.kind === 'reset') {
          const badge = document.getElementById('lesson-completion-badge');
          if (badge) {
            badge.textContent = '';
            badge.className = 'completion-badge';
          }
          render();
        } else {
          const badge = document.getElementById('lesson-completion-badge');
          if (badge) {
            badge.textContent = '';
            badge.className = 'completion-badge';
          }
          render();
        }
      });
    });
  }
  })();
</script>

<style>
  .lesson-practice {
    margin-top: var(--sp-10);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--hairline);
  }
  .practice-label {
    margin: 0 0 var(--sp-2);
    color: var(--coral-deep);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .lesson-practice h2 {
    font-family: var(--font-serif-ja);
    font-size: 16px;
    margin-bottom: var(--sp-2);
  }
  .practice-intro {
    font-size: 13px;
    color: var(--ink-secondary);
    margin-bottom: var(--sp-6);
  }
  :global(.practice-question) {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  :global(.practice-progress) {
    font-size: 12px;
    color: var(--ink-muted);
    margin: 0;
  }
  :global(.practice-prompt) {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  :global(.practice-choices) {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  :global(.practice-choice) {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    width: 100%;
    min-height: 48px;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-control);
    background: var(--paper);
    color: var(--ink);
    font-size: 14px;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  :global(.practice-choice:hover:not(:disabled)) {
    background: var(--paper-deep);
    border-color: var(--jade);
  }
  :global(.practice-choice__indicator) {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--hairline-strong);
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  :global(.practice-choice--correct) {
    border-color: var(--jade);
    background: var(--jade-soft);
  }
  :global(.practice-choice--correct .practice-choice__indicator) {
    border-color: var(--jade);
    background: var(--jade);
  }
  :global(.practice-choice--correct .practice-choice__indicator::after) {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-on-primary);
  }
  :global(.practice-choice--incorrect) {
    border-color: var(--color-error);
    background: var(--color-error-soft);
  }
  :global(.practice-choice--incorrect .practice-choice__indicator) {
    border-color: var(--color-error);
    background: var(--color-error);
  }
  :global(.practice-choice--incorrect .practice-choice__indicator::after) {
    content: '✕';
    color: var(--color-on-status);
    font-size: 0.625rem;
    font-weight: 800;
  }
  :global(.practice-choice:disabled) {
    opacity: 1;
    cursor: default;
  }
  :global(.practice-choice:disabled:not(.practice-choice--correct, .practice-choice--incorrect)) {
    color: var(--ink-muted);
    background: var(--paper-deep);
  }
  :global(.practice-feedback) {
    min-height: 0;
    transition: min-height 0.2s;
  }
  :global(.practice-feedback.feedback-visible) {
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--jade);
    border-radius: var(--radius-content);
    background: var(--jade-soft);
  }
  :global(.practice-feedback.feedback-visible--incorrect) {
    border-color: var(--color-error);
    background: var(--color-error-soft);
  }
  :global(.feedback-correct),
  :global(.feedback-incorrect) {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--ink);
    font-weight: 700;
    margin: 0;
  }
  :global(.feedback-icon) {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--jade);
    color: var(--color-on-primary);
    font-size: 0.75rem;
    font-weight: 800;
    flex: 0 0 auto;
  }
  :global(.feedback-incorrect .feedback-icon) {
    background: var(--color-error);
  }
  :global(.feedback-answer) {
    color: var(--ink-secondary);
    font-size: 13px;
    margin: 0;
  }
  :global(.practice-complete) {
    text-align: center;
    padding: var(--sp-5) var(--sp-4);
    border: 1px solid var(--jade);
    border-radius: var(--radius-content);
    background: var(--jade-soft);
  }
  :global(.practice-complete-icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 0 0 var(--sp-3);
    border-radius: 50%;
    background: var(--jade);
    color: var(--color-on-primary);
    font-size: 1.25rem;
  }
  :global(.practice-complete-text) {
    color: var(--ink-secondary);
    font-weight: 600;
    font-size: 13px;
    margin: 0;
  }
  .loading-placeholder {
    color: var(--ink-secondary);
    font-size: 13px;
  }
  @media (width <= 374px) {
    :global(.practice-choice) {
      padding-inline: var(--sp-3);
    }
  }
</style>
