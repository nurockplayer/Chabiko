---
import { generateQuestions } from '../lib/practice';
import type { Lesson } from '../types/lesson';

export interface Props {
  lesson: Lesson;
}

const { lesson } = Astro.props;
const questions = generateQuestions(lesson);
const json = JSON.stringify(questions);
---

{
  questions.length > 0 && (
    <section class="lesson-practice" aria-labelledby="practice-heading" data-questions={json}>
      <h2 id="practice-heading">練習</h2>
      <p class="practice-intro">各質問に答えて、レッスンを完了しましょう。</p>
      <div id="practice-root" role="region" aria-label="レッスン練習">
        <p class="loading-placeholder" role="status">読み込み中…</p>
      </div>
    </section>
  )
}

<script>
  import { ProgressStore } from '../lib/progress';
  import { createSession, answer, getCurrentQuestion, getCurrentIndex } from '../lib/practiceSession';
  import { createTimeoutManager } from '../lib/timeoutManager';
  import { handleProgressStorageEvent } from '../lib/progressSnapshot';
  import { computeRefresh } from '../lib/practiceRefresh';

  (function () {
  const practiceRoot = document.getElementById('practice-root');
  const practiceSection = practiceRoot?.closest('[data-questions]') as HTMLElement | null;
  if (!practiceRoot || !practiceSection) return;
  const root: HTMLElement = practiceRoot;

  const questions: Array<{
    promptJa: string;
    correctAnswer: string;
    choices: string[];
    lessonId: string;
  }> = JSON.parse(practiceSection.getAttribute('data-questions') ?? '[]');

  if (questions.length === 0) {
    root.textContent = '';
  } else {
    let store = new ProgressStore();
    let session: import('../lib/practiceSession').PracticeSession = createSession(questions);
    const timer = createTimeoutManager();

    function syncBadge() {
      const badge = document.getElementById('lesson-completion-badge');
      if (badge) {
        badge.textContent = '✓ 完了済み';
        badge.className = 'completion-badge completion-badge--done';
      }
      const routeStation = document.querySelector<HTMLElement>(
        `[data-route-lesson-id="${CSS.escape(session.lessonId)}"]`,
      );
      routeStation?.classList.add('route-station--complete');
      const routeStatus = routeStation?.querySelector<HTMLElement>('[data-route-status]');
      if (routeStatus) routeStatus.textContent = '完了';
    }

    function clearCompletionPresentation() {
      const badge = document.getElementById('lesson-completion-badge');
      if (badge) {
        badge.textContent = '';
        badge.className = 'completion-badge';
      }
      const routeStation = document.querySelector<HTMLElement>(
        `[data-route-lesson-id="${CSS.escape(session.lessonId)}"]`,
      );
      routeStation?.classList.remove('route-station--complete');
      const routeStatus = routeStation?.querySelector<HTMLElement>('[data-route-status]');
      if (routeStatus) routeStatus.textContent = '進行中';
    }

    function renderCompleted(moveFocus = false) {
      // markComplete already called in handleAnswer for the last correct answer
      syncBadge();
      root.innerHTML =
        '<div class="practice-complete" role="status" aria-live="polite" tabindex="-1">' +
        '<span class="practice-complete-icon" aria-hidden="true">&#x2713;</span>' +
        '<div><p class="practice-complete-title">練習完了！</p>' +
        '<p class="practice-complete-text">レッスンをクリアしました。</p></div></div>';
      if (moveFocus) {
        root.querySelector<HTMLElement>('.practice-complete')?.focus();
      }
    }

    function render(moveFocus = false) {
      const currentQ = getCurrentQuestion(session);
      if (!currentQ) {
        renderCompleted(moveFocus);
        return;
      }

      const isComplete = store.isComplete(session.lessonId);
      if (isComplete && getCurrentIndex(session) === 0) {
        root.innerHTML =
          '<div class="practice-complete practice-complete--saved" role="status">' +
          '<span class="practice-complete-icon" aria-hidden="true">&#x2713;</span>' +
          '<p class="practice-complete-text">このレッスンは既に完了しています。</p></div>';
        return;
      }

      root.innerHTML =
        '<div class="practice-question">' +
        '<p class="practice-progress">' +
        '質問 ' +
        (getCurrentIndex(session) + 1) +
        ' / ' +
        questions.length +
        '</p>' +
        '<p class="practice-prompt" tabindex="-1">' +
        escapeHtml(currentQ.promptJa) +
        '</p>' +
        '<div class="practice-choices" role="group" aria-label="回答を選択">' +
        currentQ.choices
          .map(
            (choice, i) =>
              '<button class="practice-choice" data-value="' +
              escapeHtml(choice) +
              '" data-index="' +
              i +
              '">' +
              '<span class="practice-choice-indicator" aria-hidden="true"></span>' +
              '<span class="practice-choice-label">' +
              escapeHtml(choice) +
              '</span></button>',
          )
          .join('') +
        '</div>' +
        '<div class="practice-feedback" role="status" aria-live="polite"></div>' +
        '</div>';

      root.querySelectorAll('.practice-choice').forEach((btn) => {
        btn.addEventListener('click', () => handleAnswer(btn as HTMLButtonElement));
      });
      if (moveFocus) {
        root.querySelector<HTMLElement>('.practice-prompt')?.focus();
      }
    }

    function handleAnswer(btn: HTMLButtonElement) {
      const selected = btn.getAttribute('data-value') ?? '';
      const feedback = root.querySelector('.practice-feedback') as HTMLElement;
      const choices = root.querySelectorAll('.practice-choice');

      if (!feedback) return;

      const result = answer(session, selected);
      session = result.session;
      btn.classList.add('practice-choice--selected');

      if (result.feedback.kind === 'correct') {
        btn.classList.add('practice-choice--correct');
        feedback.innerHTML =
          '<span class="feedback-icon" aria-hidden="true">&#x2713;</span>' +
          '<p class="feedback-title">正解！</p>';
        feedback.className = 'practice-feedback feedback-visible';
        choices.forEach((c) => (c as HTMLButtonElement).disabled = true);
        if (result.session.status === 'completed') {
          // Write completion to storage immediately, before the animation timeout
          store.markComplete(session.lessonId);
          timer.schedule(() => renderCompleted(true), 1200);
        } else {
          timer.schedule(() => render(true), 1200);
        }
      } else {
        btn.classList.add('practice-choice--incorrect');
        choices.forEach((choice) => {
          const choiceButton = choice as HTMLButtonElement;
          if (choiceButton.getAttribute('data-value') === result.feedback.correctAnswer) {
            choiceButton.classList.add('practice-choice--correct-answer');
          }
        });
        feedback.innerHTML =
          '<span class="feedback-icon feedback-icon--incorrect" aria-hidden="true">&#x2715;</span>' +
          '<div><p class="feedback-title">不正解。</p><p class="feedback-detail">正解：' +
          '<strong>' + escapeHtml(result.feedback.correctAnswer ?? '') + '</strong>' +
          '</p></div>';
        feedback.className = 'practice-feedback practice-feedback--incorrect feedback-visible';
        choices.forEach((c) => (c as HTMLButtonElement).disabled = true);
        timer.schedule(() => render(true), 2000);
      }
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    render();

    // Refresh state on pageshow (browser back/forward cache).
    // Preserves active session position so returning via bfcache
    // keeps the learner at their current question.
    window.addEventListener('pageshow', () => {
      timer.clear();
      store = new ProgressStore();
      const outcome = computeRefresh(store, session, questions);
      session = outcome.session;
      if (outcome.kind === 'completed') {
        syncBadge();
        renderCompleted();
      } else if (outcome.kind === 'reset') {
        clearCompletionPresentation();
        render();
      } else {
        clearCompletionPresentation();
        render();
      }
    });

    // Cross-tab storage synchronisation.
    // Only reacts to the Chabiko progress key, so unrelated keys
    // (user preferences, other apps) never affect practice state.
    window.addEventListener('storage', (event) => {
      handleProgressStorageEvent(event, () => {
        timer.clear();
        store = new ProgressStore();
        const outcome = computeRefresh(store, session, questions);
        session = outcome.session;
        if (outcome.kind === 'completed') {
          syncBadge();
          renderCompleted();
        } else if (outcome.kind === 'reset') {
          clearCompletionPresentation();
          render();
        } else {
          clearCompletionPresentation();
          render();
        }
      });
    });
  }
  })();
</script>

<style>
  .lesson-practice {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }
  .lesson-practice h2 {
    margin: 0 0 var(--space-xs);
    color: var(--color-text);
    font-size: 1.125rem;
  }
  .practice-intro {
    margin-bottom: var(--space-lg);
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
  }
  :global(.practice-question) {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  :global(.practice-progress) {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 650;
  }
  :global(.practice-prompt) {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 700;
    outline: none;
  }
  :global(.practice-choices) {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  :global(.practice-choice) {
    min-height: 52px;
    width: 100%;
    padding: var(--space-md) var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.9375rem;
    text-align: left;
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }
  :global(.practice-choice:hover:not(:disabled)) {
    background: var(--color-primary-soft);
    border-color: var(--color-primary);
  }
  :global(.practice-choice:active:not(:disabled)) {
    transform: translateY(1px);
  }
  :global(.practice-choice-indicator) {
    width: 1.375rem;
    height: 1.375rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border: 2px solid var(--color-border);
    border-radius: 50%;
  }
  :global(.practice-choice--selected) {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }
  :global(.practice-choice--selected .practice-choice-indicator) {
    border-color: var(--color-primary);
    box-shadow: inset 0 0 0 4px var(--color-surface);
    background: var(--color-primary);
  }
  :global(.practice-choice--correct),
  :global(.practice-choice--correct-answer) {
    border-color: var(--color-success);
    background: var(--color-success-bg);
  }
  :global(.practice-choice--correct .practice-choice-indicator),
  :global(.practice-choice--correct-answer .practice-choice-indicator) {
    border-color: var(--color-success);
    background: var(--color-success);
    box-shadow: inset 0 0 0 4px var(--color-surface);
  }
  :global(.practice-choice--incorrect) {
    border-color: var(--color-error);
    background: var(--color-error-bg);
  }
  :global(.practice-choice--incorrect .practice-choice-indicator) {
    border-color: var(--color-error);
    background: var(--color-error);
    box-shadow: none;
  }
  :global(.practice-choice--incorrect .practice-choice-indicator::after) {
    content: '×';
    color: var(--color-surface);
    font-size: 0.75rem;
    font-weight: 800;
  }
  :global(.practice-choice:disabled) {
    cursor: default;
  }
  :global(.practice-choice:disabled:not(.practice-choice--selected):not(.practice-choice--correct-answer)) {
    opacity: 0.62;
  }
  :global(.practice-feedback) {
    display: none;
  }
  :global(.practice-feedback.feedback-visible) {
    padding: var(--space-md) var(--space-lg);
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    background: var(--color-success-bg);
    border-left: 4px solid var(--color-success);
  }
  :global(.practice-feedback--incorrect.feedback-visible) {
    background: var(--color-error-bg);
    border-left-color: var(--color-error);
  }
  :global(.feedback-icon) {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-success);
    color: var(--color-surface);
    font-size: 0.75rem;
    font-weight: 800;
  }
  :global(.feedback-icon--incorrect) {
    background: var(--color-error);
  }
  :global(.feedback-title) {
    margin: 0;
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: 750;
  }
  :global(.feedback-detail) {
    margin: var(--space-xs) 0 0;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.55;
  }
  :global(.feedback-detail strong) {
    color: var(--color-text);
  }
  :global(.practice-complete) {
    min-height: 7rem;
    padding: var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    background: var(--color-primary-soft);
    outline: none;
  }
  :global(.practice-complete-icon) {
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 1.125rem;
    font-weight: 800;
  }
  :global(.practice-complete-title) {
    margin: 0;
    color: var(--color-text);
    font-weight: 750;
  }
  :global(.practice-complete-text) {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }
  :global(.practice-complete--saved .practice-complete-text) {
    color: var(--color-text);
    font-weight: 700;
  }
  .loading-placeholder {
    min-height: 6rem;
    padding: var(--space-lg);
    display: flex;
    align-items: center;
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
  }
  @media (width <= 374px) {
    :global(.practice-choice),
    :global(.practice-feedback.feedback-visible),
    :global(.practice-complete) {
      padding-inline: var(--space-md);
    }
  }
</style>
