---
import { generateQuestions } from '../lib/practice';
import type { Lesson } from '../types/lesson';

export interface Props {
  lesson: Lesson;
}

const { lesson } = Astro.props;
const questions = generateQuestions(lesson);
const json = JSON.stringify(questions);
---

{
  questions.length > 0 && (
    <section class="lesson-practice" aria-labelledby="practice-heading" data-questions={json}>
      <h2 id="practice-heading">練習</h2>
      <p class="practice-intro">各質問に答えて、レッスンを完了しましょう。</p>
      <div id="practice-root" role="region" aria-live="polite">
        <p class="loading-placeholder">読み込み中…</p>
      </div>
    </section>
  )
}

<script>
  import { ProgressStore } from '../lib/progress';

  (function () {
  const practiceRoot = document.getElementById('practice-root');
  const practiceSection = practiceRoot?.closest('[data-questions]') as HTMLElement | null;
  if (!practiceRoot || !practiceSection) return;
  const root: HTMLElement = practiceRoot;

  const questions: Array<{
    promptJa: string;
    correctAnswer: string;
    choices: string[];
    lessonId: string;
  }> = JSON.parse(practiceSection.getAttribute('data-questions') ?? '[]');

  if (questions.length === 0) {
    root.textContent = '';
  } else {
    const store = new ProgressStore();
    const lessonId = questions[0].lessonId;
    let current = 0;

    function render() {
      if (current >= questions.length) {
        store.markComplete(lessonId);
        // Sync completion badge immediately (not waiting for refresh)
        const badge = document.getElementById('lesson-completion-badge');
        if (badge) {
          badge.textContent = '✔ 完了済み';
          badge.className = 'completion-badge completion-badge--done';
        }
        root.innerHTML =
          '<div class="practice-complete" role="status"><p class="practice-complete-icon">&#x2714;</p><p class="practice-complete-text">練習完了！レッスンをクリアしました。</p></div>';
        return;
      }

      const q = questions[current];
      const isComplete = store.isComplete(lessonId);
      if (isComplete && current === 0) {
        root.innerHTML =
          '<div class="practice-complete" role="status"><p class="practice-complete-icon">&#x2714;</p><p class="practice-complete-text">このレッスンは既に完了しています。</p></div>';
        return;
      }

      root.innerHTML =
        '<div class="practice-question">' +
        '<p class="practice-progress">' +
        '質問 ' +
        (current + 1) +
        ' / ' +
        questions.length +
        '</p>' +
        '<p class="practice-prompt">' +
        escapeHtml(q.promptJa) +
        '</p>' +
        '<div class="practice-choices" role="group">' +
        q.choices
          .map(
            (choice, i) =>
              '<button class="practice-choice" data-value="' +
              escapeHtml(choice) +
              '" data-index="' +
              i +
              '">' +
              escapeHtml(choice) +
              '</button>',
          )
          .join('') +
        '</div>' +
        '<div class="practice-feedback" aria-live="assertive"></div>' +
        '</div>';

      root.querySelectorAll('.practice-choice').forEach((btn) => {
        btn.addEventListener('click', () => handleAnswer(btn as HTMLButtonElement));
      });
    }

    function handleAnswer(btn: HTMLButtonElement) {
      const selected = btn.getAttribute('data-value') ?? '';
      const feedback = root.querySelector('.practice-feedback') as HTMLElement;
      const choices = root.querySelectorAll('.practice-choice');

      if (!feedback) return;

      const q = questions[current];
      if (selected === q.correctAnswer) {
        feedback.innerHTML =
          '<p class="feedback-correct">正解！</p>';
        feedback.className = 'practice-feedback feedback-visible';
        choices.forEach((c) => (c as HTMLButtonElement).disabled = true);
        setTimeout(() => {
          current++;
          render();
        }, 1200);
      } else {
        feedback.innerHTML =
          '<p class="feedback-incorrect">不正解。</p><p class="feedback-answer">正解：' +
          escapeHtml(q.correctAnswer) +
          '</p>';
        feedback.className = 'practice-feedback feedback-visible';
        choices.forEach((c) => (c as HTMLButtonElement).disabled = true);
        setTimeout(() => {
          render();
        }, 2000);
      }
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    render();
  }
  })();
</script>

<style>
  .lesson-practice {
    margin-top: var(--space-xl);
    border-radius: var(--radius);
    padding: var(--space-lg);
    background: var(--c-slot-bg);
    border: 1px solid var(--c-border);
  }
  .lesson-practice h2 {
    font-size: 1.05rem;
    margin-bottom: var(--space-xs);
  }
  .practice-intro {
    font-size: 0.85rem;
    color: var(--c-text-secondary);
    margin-bottom: var(--space-md);
  }
  .practice-question {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .practice-progress {
    font-size: 0.8rem;
    color: var(--c-text-secondary);
    margin: 0;
  }
  .practice-prompt {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }
  .practice-choices {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .practice-choice {
    display: block;
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-surface);
    color: var(--c-text);
    font-size: 0.95rem;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .practice-choice:hover:not(:disabled) {
    background: var(--c-accent);
    color: #fff;
    border-color: var(--c-accent);
  }
  .practice-choice:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .practice-feedback {
    min-height: 0;
    transition: min-height 0.2s;
  }
  .practice-feedback.feedback-visible {
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius);
  }
  .feedback-correct {
    color: #166534;
    font-weight: 700;
    margin: 0;
  }
  .feedback-incorrect {
    color: #991b1b;
    font-weight: 700;
    margin: 0 0 var(--space-xs);
  }
  .feedback-answer {
    color: var(--c-text-secondary);
    font-size: 0.9rem;
    margin: 0;
  }
  .practice-complete {
    text-align: center;
    padding: var(--space-md) 0;
  }
  .practice-complete-icon {
    font-size: 2rem;
    margin: 0 0 var(--space-sm);
  }
  .practice-complete-text {
    font-weight: 700;
    font-size: 1rem;
    margin: 0;
  }
  .loading-placeholder {
    color: var(--c-text-secondary);
    font-size: 0.85rem;
  }
</style>
