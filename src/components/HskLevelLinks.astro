---
import { loadHskLearnerProjection } from '../content/loadHskVocabulary';
interface Props { showQuizScores?: boolean }
const { showQuizScores = false } = Astro.props;
const projection = loadHskLearnerProjection();
const levels = projection.levels.filter(({ ids }) => ids.length > 0);
const payload = JSON.stringify(levels);
---

{levels.length > 0 && (
<section class="hsk-levels" aria-label="HSKレベルを選ぶ" data-hsk-levels={payload}>
  <h2>HSK 1〜4の単語</h2>
  <div class="hsk-level-grid">
    {levels.map(({ level, ids }) => (
      <a href={`/vocabulary/hsk/${level}/`} data-hsk-level={level}>
        <strong>HSK {level}</strong>
        <span>新出 {ids.length}語</span>
        <span data-hsk-level-progress>覚えた 0 / {ids.length}語</span>
        {showQuizScores && <span data-hsk-quiz-best>テスト未受験</span>}
      </a>
    ))}
  </div>
  <p>学習記録はこの端末のブラウザに保存されます。</p>
</section>
)}

<script>
  import { HSK_QUIZ_BEST_KEY, HSK_QUIZ_SCORE_EVENT, formatHskQuizBest, readHskQuizBest } from '../domain/hskQuizBestScore';
  import { VocabularyProgressStore, VOCABULARY_PROGRESS_KEY } from '../domain/vocabularyProgress';
  const roots = document.querySelectorAll<HTMLElement>('[data-hsk-levels]');
  for (const root of roots) {
    const levels = JSON.parse(root.dataset.hskLevels ?? '[]') as { level: number; ids: string[] }[];
    const store = new VocabularyProgressStore();
    const render = () => {
      store.refresh();
      for (const { level, ids } of levels) {
        const count = ids.filter((id) => store.getStatus(id) === 'learned').length;
        const label = root.querySelector(`[data-hsk-level="${level}"] [data-hsk-level-progress]`);
        const best = root.querySelector(`[data-hsk-level="${level}"] [data-hsk-quiz-best]`);
        if (best) best.textContent = formatHskQuizBest(readHskQuizBest(level));
        if (label) label.textContent = `覚えた ${count} / ${ids.length}語`;
      }
    };
    render();
    window.addEventListener('pageshow', render);
    window.addEventListener(HSK_QUIZ_SCORE_EVENT, render);
    window.addEventListener('storage', (event) => {
      if (event.key === null || event.key === VOCABULARY_PROGRESS_KEY || event.key.startsWith(`${HSK_QUIZ_BEST_KEY}:`)) render();
    });
  }
</script>

<style>
  .hsk-levels { margin: var(--sp-8) 0; min-width: 0; }
  h2 { font-size: 1rem; margin-bottom: var(--sp-4); }
  .hsk-level-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); }
  a { display: flex; flex-direction: column; gap: var(--sp-1); padding: var(--sp-4); border: 1px solid var(--hairline); border-radius: var(--radius-content); background: var(--paper); color: var(--jade-ink); text-decoration: none; overflow-wrap: anywhere; }
  a:hover { background: var(--paper-deep); }
  a:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  span, p { font-size: 0.8rem; color: var(--ink-secondary); }
  p { margin-top: var(--sp-3); }
  @media (width >= 768px) { .hsk-level-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
