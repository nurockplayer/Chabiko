---
import type { VocabularyQuizPayload } from '../../content/vocabularyQuizPayload';

export interface Props {
  payload: VocabularyQuizPayload;
  payloadJson: string;
}

const { payload, payloadJson } = Astro.props;
const { eligibleIds } = payload;
const total = Math.min(10, eligibleIds.length);
---

<section
  class="basic-vocabulary-quiz"
  data-basic-vocabulary-quiz
>
  <nav class="basic-vocabulary-quiz-back">
    <a href="/vocabulary/basic/">単語学習に戻る</a>
  </nav>

  <p class="basic-vocabulary-quiz-total" data-quiz-total>対象 {eligibleIds.length}語</p>
  <p class="basic-vocabulary-quiz-progress" data-quiz-progress aria-live="polite">0 / {total}</p>
  <p class="basic-vocabulary-quiz-score" data-quiz-score>正解 0 / {total}</p>

  <div class="basic-vocabulary-quiz-card" data-quiz-card></div>

  <script type="application/json" id="basic-vocabulary-quiz-data" set:html={payloadJson} is:inline></script>
</section>

<script>
  import { initBasicVocabularyQuiz } from '../../client/basicVocabularyQuiz';

  function initialiseQuiz(): void {
    document.querySelectorAll<HTMLElement>('[data-basic-vocabulary-quiz]').forEach((root) => {
      initBasicVocabularyQuiz(root);
    });
  }

  initialiseQuiz();
  document.addEventListener('astro:page-load', initialiseQuiz);
</script>

<style is:global>
  .basic-vocabulary-quiz {
    width: 100%;
  }

  .basic-vocabulary-quiz-back {
    margin: 0 0 var(--sp-6);
  }

  .basic-vocabulary-quiz-back a {
    display: inline-block;
    min-height: 2.75rem;
    padding: var(--sp-2) 0;
    font-weight: 600;
  }

  .basic-vocabulary-quiz-total {
    margin: 0 0 var(--sp-1);
    color: var(--ink-secondary);
    font-size: 0.8125rem;
    text-align: right;
  }

  .basic-vocabulary-quiz-progress,
  .basic-vocabulary-quiz-score {
    margin: 0 0 var(--sp-2);
    color: var(--ink-secondary);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .basic-vocabulary-quiz-card {
    box-sizing: border-box;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 3vw, 1.25rem);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background: var(--paper-deep);
    padding: clamp(1rem, 5vw, 2rem);
    text-align: center;
  }

  .basic-vocabulary-quiz-simplified {
    max-width: 100%;
    margin: 0;
    font-family: var(--font-serif-zh);
    color: var(--ink);
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }

  @media (max-width: 374px) {
    .basic-vocabulary-quiz-simplified {
      font-size: 2.75rem;
    }
  }

  @media (min-width: 720px) {
    .basic-vocabulary-quiz-simplified {
      font-size: 3.5rem;
    }
  }

  .basic-vocabulary-quiz-options {
    display: grid;
    gap: var(--sp-2);
    width: min(100%, 22rem);
  }

  .basic-vocabulary-quiz-option,
  .basic-vocabulary-quiz-action {
    box-sizing: border-box;
    min-height: 2.75rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-control);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }

  .basic-vocabulary-quiz-option {
    width: 100%;
    padding: var(--sp-2) var(--sp-4);
    overflow-wrap: anywhere;
  }

  .basic-vocabulary-quiz-option:hover:not(:disabled) {
    background: var(--jade-soft);
  }

  .basic-vocabulary-quiz-option:focus-visible,
  .basic-vocabulary-quiz-action:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .basic-vocabulary-quiz-option[aria-pressed='true'] {
    border-color: var(--jade);
    background: var(--jade-soft);
    color: var(--jade-ink);
  }

  .basic-vocabulary-quiz-option[data-correct='true'] {
    border-color: var(--jade);
    background: var(--jade-soft);
    color: var(--jade-ink);
  }

  .basic-vocabulary-quiz-option[data-wrong='true'] {
    border-color: var(--coral-deep);
    background: var(--coral-soft);
    color: var(--coral-deep);
  }

  .basic-vocabulary-quiz-option:disabled {
    cursor: default;
    opacity: 0.75;
  }

  .basic-vocabulary-quiz-action {
    width: min(100%, 22rem);
    padding: var(--sp-2) var(--sp-4);
  }

  .basic-vocabulary-quiz-submit,
  .basic-vocabulary-quiz-next {
    border-color: var(--coral);
    background: var(--coral);
    color: var(--color-on-primary);
  }

  .basic-vocabulary-quiz-submit:hover:not(:disabled),
  .basic-vocabulary-quiz-next:hover {
    background: var(--coral-deep);
  }

  .basic-vocabulary-quiz-submit:disabled {
    cursor: default;
    opacity: 0.55;
    background: var(--jade-soft);
    border-color: var(--hairline);
    color: var(--ink-muted);
  }

  .basic-vocabulary-quiz-restart {
    background: var(--paper);
    color: var(--coral);
    border-color: var(--coral);
  }

  .basic-vocabulary-quiz-feedback {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1rem, 4.5vw, 1.2rem);
    font-weight: 600;
  }

  .basic-vocabulary-quiz-answer {
    display: grid;
    gap: var(--sp-1);
    max-width: 100%;
  }

  .basic-vocabulary-quiz-pinyin,
  .basic-vocabulary-quiz-japanese,
  .basic-vocabulary-quiz-traditional {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .basic-vocabulary-quiz-pinyin {
    color: var(--ink-muted);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .basic-vocabulary-quiz-japanese {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 700;
  }

  .basic-vocabulary-quiz-traditional {
    color: var(--ink-muted);
    font-size: 0.75rem;
  }

  .basic-vocabulary-quiz-completion-title {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.25rem, 6vw, 1.75rem);
    overflow-wrap: anywhere;
  }

  .basic-vocabulary-quiz-completion-score {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1rem, 4.5vw, 1.2rem);
    font-variant-numeric: tabular-nums;
  }

  .basic-vocabulary-quiz-unavailable {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }
</style>
