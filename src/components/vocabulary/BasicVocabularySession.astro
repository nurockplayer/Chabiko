---
import type { LearnerSessionPayload } from '../../content/learnerSessionPayload';
import PronounceButton from '../PronounceButton.astro';

export interface Props {
  payload: LearnerSessionPayload;
  payloadJson: string;
}

const { payload, payloadJson } = Astro.props;
const { ids, totalCount, first } = payload;
const sessionSize = Math.min(10, ids.length);
---

<section
  class="basic-vocabulary-session"
  data-basic-vocabulary-session
  data-basic-vocabulary-ids={JSON.stringify(ids)}
  data-basic-vocabulary-session-size={sessionSize}
>
  <div class="basic-vocabulary-session-head">
    <p class="basic-vocabulary-progress" data-progress aria-live="polite">今回 0 / {sessionSize}語</p>
    <!-- Decorative mirror of the live progress text above; screen readers get
         the text, sighted learners also get momentum at a glance. -->
    <div class="basic-vocabulary-meter" aria-hidden="true">
      <span class="basic-vocabulary-meter__fill" data-progress-meter></span>
    </div>
    <p class="basic-vocabulary-totals">
      <span class="basic-vocabulary-total" data-total>全{totalCount}語</span>
      <span class="basic-vocabulary-summary" data-summary>新規 {ids.length}語・学習中 0語・習得済み 0語</span>
    </p>
  </div>
  <!-- Recall-first reveal (#356): the opening card is the front word only.
       The illustration is answer feedback, rendered client-side together with
       the answer when 「答えを見る」 is pressed — never a pre-reveal hint. -->
  <div class="basic-vocabulary-card" data-card>
    {first && <p class="basic-vocabulary-simplified" lang="zh-Hans">{first.simplified}</p>}
    <button class="basic-vocabulary-action basic-vocabulary-reveal" data-action="reveal" type="button">
      答えを見る
    </button>
  </div>
  <details class="basic-vocabulary-reset">
    <summary>学習データの管理</summary>
    <button class="basic-vocabulary-reset-button" data-action="reset" type="button">
      学習記録をリセット
    </button>
  </details>
  <!-- Loads the shared client runtime; study controls are created only after answer reveal. -->
  <span hidden aria-hidden="true"><PronounceButton text="" /></span>
  <script type="application/json" id="basic-vocabulary-data" set:html={payloadJson} is:inline></script>
</section>

<script>
  import { initBasicVocabularySession } from '../../client/basicVocabularySession';

  function initialiseSessions() {
    document.querySelectorAll<HTMLElement>('[data-basic-vocabulary-session]').forEach((root) => {
      initBasicVocabularySession(root);
    });
  }

  initialiseSessions();
  document.addEventListener('astro:page-load', initialiseSessions);
</script>

<style is:global>
  .basic-vocabulary-session {
    width: 100%;
  }

  /* Session head: this-session progress leads (text + meter); corpus totals
   * are quieter metadata on one wrapping line. */
  .basic-vocabulary-session-head {
    display: grid;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-3);
  }

  .basic-vocabulary-progress {
    margin: 0;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .basic-vocabulary-meter {
    height: 4px;
    overflow: hidden;
    background: var(--hairline);
  }

  .basic-vocabulary-meter__fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--jade);
    transform: scaleX(var(--session-progress, 0));
    transform-origin: left center;
  }

  .basic-vocabulary-totals {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-3);
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .basic-vocabulary-total,
  .basic-vocabulary-summary {
    overflow-wrap: anywhere;
  }

  .basic-vocabulary-reset {
    margin-top: var(--sp-2);
  }

  .basic-vocabulary-reset summary {
    width: fit-content;
    margin: 0 0 0 auto;
    padding: var(--sp-1) var(--sp-4);
    color: var(--ink-secondary);
    font-size: 0.8125rem;
    font-weight: 400;
    cursor: pointer;
    border-radius: var(--radius-control);
    list-style: none;
    user-select: none;
  }

  .basic-vocabulary-reset summary::-webkit-details-marker {
    display: none;
  }

  .basic-vocabulary-reset summary:hover {
    background: var(--jade-soft);
  }

  .basic-vocabulary-reset[open] .basic-vocabulary-reset-button {
    display: inline-block;
  }

  .basic-vocabulary-reset-button {
    display: none;
    width: auto;
    min-height: 2.75rem;
    margin-top: var(--sp-1);
    padding: var(--sp-1) var(--sp-4);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--ink-secondary);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-control);
    background: transparent;
    cursor: pointer;
  }

  .basic-vocabulary-reset-button:hover {
    background: var(--jade-soft);
  }

  .basic-vocabulary-reset-button:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .basic-vocabulary-card {
    box-sizing: border-box;
    width: 100%;
    min-height: clamp(22rem, 66vh, 39rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 3vw, 1.25rem);
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background: var(--paper-deep);
    padding: clamp(1rem, 5vw, 2rem);
    text-align: center;
  }

  /* Every render replaces the card's children, so new content eases in
   * (front word, revealed answer, next card, completion) instead of
   * hard-swapping. Motion-safe only: with reduced motion nothing animates
   * and content is shown at rest immediately. */
  @media (prefers-reduced-motion: no-preference) {
    .basic-vocabulary-card > *,
    .basic-vocabulary-completion > * {
      animation: chabiko-rise var(--motion-base) var(--ease-out-calm) backwards;
    }

    .basic-vocabulary-card > :nth-child(2),
    .basic-vocabulary-completion > :nth-child(2) {
      animation-delay: 40ms;
    }

    .basic-vocabulary-card > :nth-child(n + 3),
    .basic-vocabulary-completion > :nth-child(n + 3) {
      animation-delay: 80ms;
    }

    .basic-vocabulary-meter__fill {
      transition: transform var(--motion-base) var(--ease-out-calm);
    }

    .basic-vocabulary-rating,
    .basic-vocabulary-action {
      transition:
        background var(--motion-quick) ease,
        border-color var(--motion-quick) ease,
        transform var(--motion-quick) ease;
    }
  }

  .basic-vocabulary-completion {
    box-sizing: border-box;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 3vw, 1.25rem);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background: var(--paper-deep);
    padding: clamp(1rem, 5vw, 2rem);
    text-align: center;
  }

  .basic-vocabulary-state {
    align-self: flex-start;
    color: var(--jade-ink);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    margin: 0;
  }

  .basic-vocabulary-illustration {
    display: block;
    box-sizing: border-box;
    width: auto;
    max-width: 180px;
    height: auto;
    max-height: min(42vh, 420px);
    object-fit: contain;
    border-radius: var(--radius-content);
  }

  .basic-vocabulary-context {
    display: grid;
    gap: var(--sp-2);
    width: min(100%, 40rem);
    text-align: left;
  }

  .basic-vocabulary-context-label,
  .basic-vocabulary-word-label,
  .basic-vocabulary-word-field-label {
    margin: 0;
    color: var(--ink-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .basic-vocabulary-context-text {
    margin: 0;
    font-family: var(--font-serif-zh);
    color: var(--ink);
    font-size: clamp(1.75rem, 7.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.45;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .basic-vocabulary-context--missing {
    gap: 0;
    padding: var(--sp-2) 0;
  }

  .basic-vocabulary-context--missing .basic-vocabulary-context-label {
    color: var(--ink-muted);
    font-weight: 400;
  }

  .basic-vocabulary-word-breakdown {
    display: grid;
    gap: var(--sp-1);
    width: min(100%, 34rem);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--hairline);
    text-align: left;
  }

  .basic-vocabulary-simplified {
    max-width: 100%;
    margin: 0;
    font-family: var(--font-serif-zh);
    color: var(--ink);
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }

  .basic-vocabulary-word-breakdown .basic-vocabulary-simplified {
    font-size: clamp(1.5rem, 7vw, 2rem);
    line-height: 1.3;
  }

  .basic-vocabulary-answer {
    display: grid;
    gap: var(--sp-2);
    max-width: 100%;
    margin-top: var(--sp-2);
  }

  .basic-vocabulary-word-field {
    display: grid;
    grid-template-columns: minmax(6.5rem, 0.35fr) minmax(0, 1fr);
    gap: var(--sp-2);
    align-items: baseline;
  }

  .basic-vocabulary-pinyin,
  .basic-vocabulary-japanese,
  .basic-vocabulary-traditional,
  .basic-vocabulary-script-fallback {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .basic-vocabulary-script-fallback {
    color: var(--ink-secondary);
    font-size: 0.875rem;
  }

  .basic-vocabulary-pinyin {
    color: var(--ink-muted);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .basic-vocabulary-japanese {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
  }
  ul.basic-vocabulary-japanese {
    padding-inline-start: 1.2em;
    display: grid;
    gap: var(--sp-2);
  }

  .basic-vocabulary-traditional {
    color: var(--ink-muted);
    font-size: 0.8125rem;
  }

  .basic-vocabulary-action,
  .basic-vocabulary-rating {
    box-sizing: border-box;
    min-height: 2.75rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-control);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  .basic-vocabulary-action {
    width: min(100%, 22rem);
    padding: var(--sp-2) var(--sp-4);
  }

  .basic-vocabulary-reveal,
  .basic-vocabulary-continue {
    border-color: var(--coral-deep);
    background: var(--coral-deep);
    color: var(--color-on-primary);
  }

  .basic-vocabulary-ratings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: min(100%, 34rem);
    gap: clamp(0.375rem, 2vw, 0.75rem);
  }

  .basic-vocabulary-rating {
    min-width: 0;
    padding: var(--sp-2) 0.375rem;
    font-size: clamp(0.8125rem, 3.5vw, 0.9375rem);
    overflow-wrap: anywhere;
    white-space: nowrap;
  }

  .basic-vocabulary-rating[data-rating="again"] {
    border-color: var(--coral-deep);
    color: var(--coral-deep);
  }

  .basic-vocabulary-rating[data-rating="unsure"] {
    border-color: var(--ink-secondary);
    color: var(--ink-secondary);
  }

  .basic-vocabulary-rating[data-rating="known"] {
    border-color: var(--jade-ink);
    color: var(--jade-ink);
  }

  .basic-vocabulary-action:hover {
    background: var(--jade-soft);
  }

  .basic-vocabulary-rating:hover {
    border-color: var(--ink-muted);
  }

  .basic-vocabulary-reveal:hover,
  .basic-vocabulary-continue:hover {
    background: var(--c-accent-hover);
    box-shadow: 0 0 0 3px var(--coral-soft);
  }

  .basic-vocabulary-action:active,
  .basic-vocabulary-rating:active {
    transform: translateY(1px);
  }

  .basic-vocabulary-action:focus-visible,
  .basic-vocabulary-rating:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .basic-vocabulary-completion-title {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.25rem, 6vw, 1.75rem);
    overflow-wrap: anywhere;
  }

  .basic-vocabulary-completion-stats {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: clamp(0.75rem, 3vw, 1.5rem);
    row-gap: var(--sp-1);
    width: 100%;
    max-width: 24rem;
    margin: 0;
    text-align: left;
  }

  .basic-vocabulary-completion-stat {
    display: contents;
  }

  .basic-vocabulary-completion-stat dt {
    color: var(--ink-secondary);
    font-size: clamp(0.8125rem, 3.5vw, 0.9375rem);
  }

  .basic-vocabulary-completion-stat dd {
    margin: 0;
    color: var(--ink);
    font-size: clamp(0.8125rem, 3.5vw, 0.9375rem);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .basic-vocabulary-completion-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    width: min(100%, 22rem);
  }

  .basic-vocabulary-completion-actions .basic-vocabulary-action {
    width: 100%;
  }

  .basic-vocabulary-replay {
    background: var(--paper);
    color: var(--ink-secondary);
    border-color: var(--hairline-strong);
  }

  .basic-vocabulary-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 767px) {
    /* Phone ergonomics: anchor card content to the top so the front word and
     * 「答えを見る」 sit inside the first screen, and the revealed answer reads
     * from the top of the card instead of re-centering inside it. */
    .basic-vocabulary-card {
      justify-content: flex-start;
    }

    .basic-vocabulary-card > .basic-vocabulary-simplified:first-child {
      margin-top: clamp(1.5rem, 9vh, 5rem);
    }
  }

  @media (max-width: 480px) {
    .basic-vocabulary-illustration {
      /* Mobile ergonomics (#369): the reveal illustration is answer feedback,
       * not the card anchor — cap it lower on phones so the word, the answer,
       * and the rating controls stay reachable without excess scroll. */
      max-width: 160px;
      max-height: min(24vh, 180px);
    }
  }

  @media (max-width: 374px) {
    .basic-vocabulary-simplified {
      font-size: 2.75rem;
    }

    .basic-vocabulary-illustration {
      max-width: 150px;
    }
  }

  @media (max-width: 359px) {
    .basic-vocabulary-card {
      min-height: 20rem;
      padding: 0.875rem;
    }

    .basic-vocabulary-completion {
      padding: 0.875rem;
    }

    .basic-vocabulary-rating {
      font-size: 0.8125rem;
    }
  }

  @media (min-width: 720px) {
    .basic-vocabulary-simplified {
      font-size: 3.5rem;
    }

    .basic-vocabulary-illustration {
      max-width: 220px;
    }
  }
</style>
