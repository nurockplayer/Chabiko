---
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Chabiko ホーム">
      <span class="brand-mark" aria-hidden="true">C</span>
      <span class="logo">Chabiko</span>
      <span class="logo-sub">チャビコ</span>
    </a>
    <nav class="nav-primary" aria-label="メインナビゲーション">
      <a href="/" class="nav-link">ホーム</a>
    </nav>
    <div class="script-toggle-slot" aria-label="簡体字・繁体字切り替え（準備中）">
      <span aria-hidden="true">繁｜簡</span>
      <span class="slot-badge">準備中</span>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--c-primary);
    color: #fff;
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--space-lg);
    min-height: 56px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand:focus-visible,
  .nav-link:focus-visible {
    outline-color: var(--c-accent);
  }
  .brand-mark {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--c-accent);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 800;
    flex: 0 0 auto;
  }
  .logo {
    font-weight: 700;
    font-size: 1rem;
    color: #fff;
  }
  .logo-sub {
    font-size: 0.75rem;
    color: rgb(255 255 255 / 78%);
    margin-left: -0.25rem;
  }
  .nav-primary {
    margin-left: auto;
  }
  .nav-link {
    font-size: 0.875rem;
    color: rgb(255 255 255 / 92%);
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .script-toggle-slot {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.6875rem;
    color: rgb(255 255 255 / 70%);
    white-space: nowrap;
  }
  .slot-badge {
    padding-left: var(--space-xs);
    border-left: 1px solid rgb(255 255 255 / 35%);
    font-size: 0.625rem;
  }
  @media (width <= 374px) {
    .header-inner {
      padding-inline: var(--space-md);
      gap: var(--space-sm);
    }
    .logo-sub {
      display: none;
    }
    .script-toggle-slot {
      font-size: 0.625rem;
    }
    .slot-badge {
      display: none;
    }
  }
</style>
