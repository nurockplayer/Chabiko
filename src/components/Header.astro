---
export interface Props {
  themeEnabled?: boolean;
}

const { themeEnabled = false } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Chabiko ホーム">
      <span class="brand-mark" aria-hidden="true">C</span>
      <span class="logo">Chabiko</span>
      <span class="logo-sub">チャビコ</span>
    </a>
    <nav class="nav-primary" aria-label="メインナビゲーション">
      <a href="/" class="nav-link">ホーム</a>
    </nav>
    {
      themeEnabled && (
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="ダークテーマに切り替える"
          aria-pressed="false"
        >
          <span class="theme-toggle__mark" aria-hidden="true">◐</span>
          <span class="theme-toggle__label" aria-hidden="true">暗</span>
        </button>
      )
    }
    <div class="script-toggle-slot">
      <label for="script-preference-select">漢字表記</label>
      <select id="script-preference-select" class="script-preference-select">
        <option value="path-default">コース標準</option>
        <option value="traditional">繁体字</option>
        <option value="simplified">簡体字</option>
      </select>
    </div>
  </div>
</header>

<script>
  import { THEME_STORAGE_KEY, getNextTheme } from '../lib/theme';
  import { initScriptPreferenceControl } from '../client/scriptPreferenceControl';

  const themeToggle = document.getElementById('theme-toggle');

  function updateThemeControl(theme: 'light' | 'dark') {
    if (!(themeToggle instanceof HTMLButtonElement)) return;
    const isDark = theme === 'dark';
    themeToggle.setAttribute('aria-pressed', String(isDark));
    themeToggle.setAttribute(
      'aria-label',
      isDark ? 'ライトテーマに切り替える' : 'ダークテーマに切り替える',
    );
    const label = themeToggle.querySelector('.theme-toggle__label');
    if (label) label.textContent = isDark ? '明' : '暗';
  }

  if (themeToggle instanceof HTMLButtonElement) {
    const initialTheme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    updateThemeControl(initialTheme);
    themeToggle.addEventListener('click', () => {
      const nextTheme = getNextTheme(document.documentElement.dataset.theme);
      document.documentElement.dataset.theme = nextTheme;
      try {
        localStorage.setItem(THEME_STORAGE_KEY, nextTheme);
      } catch {
        // The active page still changes theme when storage is unavailable.
      }
      updateThemeControl(nextTheme);
    });
  }

  // The script-preference control always renders in the header, regardless of
  // the theme-enabled flag. It initializes from the validated root dataset set
  // by the BaseLayout pre-paint bootstrap and persists only through the
  // Issue #251 store.
  initScriptPreferenceControl();
</script>

<style>
  .site-header {
    background: var(--color-header);
    color: var(--color-header-text);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--space-lg);
    min-height: 56px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    color: var(--color-header-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand:focus-visible,
  .nav-link:focus-visible,
  .theme-toggle:focus-visible {
    outline-color: var(--c-accent);
  }
  .brand-mark {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--c-accent);
    color: var(--color-on-status);
    font-size: 0.8125rem;
    font-weight: 800;
    flex: 0 0 auto;
  }
  .logo {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-header-text);
  }
  .logo-sub {
    font-size: 0.75rem;
    color: var(--color-header-muted);
    margin-left: -0.25rem;
  }
  .nav-primary {
    margin-left: auto;
  }
  .nav-link {
    font-size: 0.875rem;
    color: var(--color-header-text);
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-width: 52px;
    min-height: 44px;
    padding: 0 var(--space-sm);
    border: 1px solid color-mix(in srgb, var(--color-header-text) 35%, transparent);
    background: transparent;
    color: var(--color-header-text);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: color-mix(in srgb, var(--color-header-text) 10%, transparent);
  }
  .theme-toggle__mark {
    color: var(--c-accent);
    font-size: 1rem;
    line-height: 1;
  }
  .script-toggle-slot {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.6875rem;
    color: var(--color-header-muted);
    white-space: nowrap;
  }
  .script-toggle-slot label {
    font-size: 0.6875rem;
    color: var(--color-header-muted);
    white-space: nowrap;
  }
  .script-preference-select {
    min-height: 44px;
    max-width: 8.5rem;
    padding: 0 var(--space-sm);
    border: 1px solid color-mix(in srgb, var(--color-header-text) 35%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-header-text) 8%, transparent);
    color: var(--color-header-text);
    font: inherit;
    font-size: 0.6875rem;
    font-weight: 700;
    cursor: pointer;
  }
  .script-preference-select:hover {
    background: color-mix(in srgb, var(--color-header-text) 10%, transparent);
  }
  .script-preference-select:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
  @media (width <= 767px) {
    .logo-sub {
      display: none;
    }
    .header-inner {
      gap: var(--space-sm);
    }
    /* The control label stacks above the select so the header never
     * overflows at 320/375/390px. */
    .script-toggle-slot {
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
      line-height: 1.2;
    }
    .script-toggle-slot label {
      font-size: 0.625rem;
    }
    .script-preference-select {
      max-width: 6.5rem;
      padding-inline: var(--space-xs);
      font-size: 0.625rem;
    }
  }
  @media (width <= 374px) {
    .header-inner {
      padding-inline: var(--space-md);
    }
    .script-toggle-slot label {
      font-size: 0.5625rem;
    }
    .script-preference-select {
      max-width: 6rem;
      font-size: 0.5625rem;
    }
    .theme-toggle {
      min-width: 44px;
      padding-inline: var(--space-xs);
    }
    .theme-toggle__mark {
      display: none;
    }
  }
</style>
