---
const isHome = Astro.url.pathname === '/';
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Chabiko ホーム">
      <span class="brand-mark" aria-hidden="true">C</span>
      <span class="brand-copy">
        <span class="logo">Chabiko</span>
        <span class="logo-sub">チャビコ</span>
      </span>
    </a>
    <nav class="nav-primary" aria-label="メインナビゲーション">
      <a href="/" class="nav-link" aria-current={isHome ? 'page' : undefined}>ホーム</a>
      <span
        class="script-toggle-slot"
        aria-label="簡体字・繁体字切り替え（準備中）"
        aria-disabled="true"
        title="簡体字・繁体字切り替えは準備中です"
      >
        繁 / 簡
      </span>
      <label class="theme-toggle" title="ライト・ダークテーマ切り替え">
        <input id="theme-toggle" type="checkbox" aria-label="ダークテーマを使用" />
        <span aria-hidden="true">明</span>
        <span class="theme-toggle-divider" aria-hidden="true">/</span>
        <span aria-hidden="true">暗</span>
      </label>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #1a2744;
    color: #f8f7f3;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    max-width: var(--max-w);
    margin: 0 auto;
    min-height: var(--header-h);
    padding: 0 var(--space-lg);
  }
  .brand {
    min-width: 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: #f8f7f3;
    text-decoration: none;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand-mark {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    background: #d48c2b;
    color: #1a2744;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .brand-copy {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    min-width: 0;
    white-space: nowrap;
  }
  .logo {
    font-weight: 750;
    font-size: 1rem;
    letter-spacing: 0.015em;
  }
  .logo-sub {
    font-size: 0.6875rem;
    color: rgb(248 247 243 / 0.72);
  }
  .nav-primary {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    white-space: nowrap;
  }
  .nav-link {
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--space-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgb(248 247 243 / 0.9);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }
  .nav-link:hover {
    color: #ffffff;
    text-decoration: none;
  }
  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: #d48c2b;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35rem;
  }
  .script-toggle-slot {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-sm);
    color: rgb(248 247 243 / 0.68);
    font-size: 0.75rem;
    border-left: 1px solid rgb(248 247 243 / 0.2);
  }
  .theme-toggle {
    min-width: 56px;
    min-height: 44px;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    color: rgb(248 247 243 / 0.9);
    border: 1px solid rgb(248 247 243 / 0.32);
    border-radius: var(--radius);
    font-size: 0.6875rem;
    font-weight: 700;
    cursor: pointer;
  }
  .theme-toggle input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .theme-toggle:has(input:focus-visible) {
    outline: 2px solid #f0b55d;
    outline-offset: 3px;
  }
  .theme-toggle:has(input:checked) {
    background: rgb(248 247 243 / 0.12);
  }
  .theme-toggle-divider {
    color: rgb(248 247 243 / 0.46);
  }
  .brand:focus-visible,
  .nav-link:focus-visible {
    outline-color: #f0b55d;
  }
  @media (width <= 480px) {
    .header-inner {
      padding-inline: var(--space-md);
    }
    .logo-sub {
      display: none;
    }
    .nav-primary {
      gap: var(--space-xs);
    }
  }
  @media (width <= 374px) {
    .nav-link {
      display: none;
    }
  }
</style>
