---
export interface Props {
  themeEnabled?: boolean;
}

const { themeEnabled = false } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Chabiko ホーム">
      <span class="brand-mark" aria-hidden="true">C</span>
      <span class="logo">Chabiko</span>
      <span class="logo-sub">チャビコ</span>
    </a>
    <nav class="nav-primary" aria-label="メインナビゲーション">
      <a
        href="/"
        class="nav-link"
        aria-current={isHome ? 'page' : undefined}
      >ホーム</a>
    </nav>
    {
      themeEnabled && (
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="ダークテーマに切り替える"
          title="ダークテーマに切り替える"
          aria-pressed="false"
        >
          <svg class="theme-toggle__mark" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path data-theme-moon d="M20 15.5A8.5 8.5 0 0 1 8.5 4a8.5 8.5 0 1 0 11.5 11.5Z" />
            <g data-theme-sun data-theme-hidden>
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
            </g>
          </svg>
        </button>
      )
    }
    <div class="script-toggle-slot">
      <label for="script-preference-select">漢字表記</label>
      <select id="script-preference-select" class="script-preference-select">
        <option value="path-default">表記：標準</option>
        <option value="traditional">表記：繁体字</option>
        <option value="simplified">表記：簡体字</option>
      </select>
    </div>
  </div>
</header>

<script>
  import { THEME_STORAGE_KEY, getNextTheme } from '../lib/theme';
  import { initScriptPreferenceControl } from '../client/scriptPreferenceControl';

  const themeToggle = document.getElementById('theme-toggle');

  function updateThemeControl(theme: 'light' | 'dark') {
    if (!(themeToggle instanceof HTMLButtonElement)) return;
    const isDark = theme === 'dark';
    themeToggle.setAttribute('aria-pressed', String(isDark));
    themeToggle.setAttribute(
      'aria-label',
      isDark ? 'ライトテーマに切り替える' : 'ダークテーマに切り替える',
    );
    themeToggle.title = isDark ? 'ライトテーマに切り替える' : 'ダークテーマに切り替える';
    themeToggle.querySelector('[data-theme-moon]')?.toggleAttribute('data-theme-hidden', isDark);
    themeToggle.querySelector('[data-theme-sun]')?.toggleAttribute('data-theme-hidden', !isDark);
  }

  if (themeToggle instanceof HTMLButtonElement) {
    const initialTheme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    updateThemeControl(initialTheme);
    themeToggle.addEventListener('click', () => {
      const nextTheme = getNextTheme(document.documentElement.dataset.theme);
      document.documentElement.dataset.theme = nextTheme;
      try {
        localStorage.setItem(THEME_STORAGE_KEY, nextTheme);
      } catch {
        // The active page still changes theme when storage is unavailable.
      }
      updateThemeControl(nextTheme);
    });
  }

  // The script-preference control always renders in the header, regardless of
  // the theme-enabled flag. It initializes from the validated root dataset set
  // by the BaseLayout pre-paint bootstrap and persists only through the
  // Issue #251 store.
  initScriptPreferenceControl();
</script>

<style>
  .site-header {
    background: var(--paper);
    color: var(--ink);
    border-bottom: 1px solid var(--hairline);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--sp-7);
    min-height: 56px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand:focus-visible,
  .nav-link:focus-visible,
  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .brand-mark {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--coral);
    color: var(--color-on-status);
    font-family: var(--font-serif-ja);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    flex: 0 0 auto;
  }
  .logo {
    font-family: var(--font-serif-ja);
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--ink);
    letter-spacing: 0.02em;
  }
  .logo-sub {
    font-size: 0.625rem;
    color: var(--ink-muted);
    letter-spacing: 0.12em;
  }
  .nav-primary {
    margin-left: auto;
  }
  .nav-link {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--ink-secondary);
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-bottom: 2px solid var(--hairline-strong);
    text-decoration: none;
  }
  .nav-link[aria-current='page'] {
    border-bottom-color: var(--coral);
    color: var(--coral-deep);
    font-weight: 700;
  }
  .nav-link:hover {
    border-bottom-color: var(--jade);
    color: var(--ink);
  }
  .nav-link:active {
    background: var(--paper-deep);
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-1);
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--sp-2);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-control);
    background: var(--paper-deep);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }
  .theme-toggle:hover {
    border-color: var(--coral);
    background: var(--coral-soft);
  }
  .theme-toggle:active {
    background: var(--paper);
  }
  .theme-toggle__mark {
    color: var(--coral);
    font-size: 1.125rem;
    line-height: 1;
  }
  .theme-toggle__mark [data-theme-hidden] {
    display: none;
  }
  .script-toggle-slot {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .script-toggle-slot label {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .script-preference-select {
    min-height: 44px;
    max-width: 8.5rem;
    padding: 0 var(--sp-3);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-control);
    background: var(--paper-deep);
    color: var(--ink-secondary);
    font: inherit;
    font-size: 0.6875rem;
    font-weight: 700;
    cursor: pointer;
  }
  .script-preference-select:hover {
    border-color: var(--jade);
  }
  .script-preference-select:active {
    background: var(--paper);
  }
  .script-preference-select:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
  @media (width <= 767px) {
    .logo-sub {
      display: none;
    }
    .header-inner {
      gap: var(--sp-2);
      padding-inline: var(--sp-3);
    }
    /* Keep the native label accessible without adding a second header row. */
    .script-toggle-slot label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .script-preference-select {
      max-width: 7rem;
      padding-inline: var(--sp-1);
      font-size: 0.6875rem;
    }
  }
  @media (width <= 374px) {
    .header-inner {
      /* Keep the full control row inside the drawable width when a vertical
       * scrollbar reduces the layout viewport to 305px at a 320px viewport. */
      gap: var(--sp-1);
      padding-inline: var(--sp-3);
    }
    .script-preference-select {
      max-width: 6.5rem;
    }
    .theme-toggle {
      min-width: 44px;
      padding-inline: var(--sp-1);
    }
    .brand-mark {
      display: none;
    }
  }
</style>
