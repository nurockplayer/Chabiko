---
import type { LearningPathRecord } from '../types/learningPath';

/** A track-level comprehensive-test entry rendered beside the path card (#376).
 *  Supplied by the caller from track→route navigation config, never authored in
 *  the path record. */
export interface LearningPathQuizEntry {
  labelJa: string;
  href: string;
}

export interface Props {
  path: LearningPathRecord;
  /** Marks the visually primary path (repository-controlled, currently the
   *  Taiwan-travel path). */
  emphasized?: boolean;
  /** Optional assessment entry shown as a sibling link (data-gated). */
  quiz?: LearningPathQuizEntry | null;
}

const { path, emphasized = false, quiz = null } = Astro.props;

const scriptLabel = path.script === 'simplified' ? '簡体字' : '繁体字';
const available = path.availability === 'available';
const primaryClass = emphasized ? ' learning-path-card--primary' : '';
const totalMembers = path.members.length;
---

{
  available ? (
    <a
      class={`learning-path-card learning-path-card--available${primaryClass}`}
      href={path.destination}
      data-path-id={path.id}
      data-path-availability="available"
    >
      <span class="learning-path-card__body">
        {emphasized && (
          <span class="learning-path-card__badge" data-path-primary-badge>
            メインルート
          </span>
        )}
        <span class="learning-path-card__label">{path.labelJa}</span>
        <span class="learning-path-card__description">{path.descriptionJa}</span>
        <span class="learning-path-card__meta">
          <span class="learning-path-card__script">{scriptLabel}表示</span>
          <span class="learning-path-card__status">利用できます</span>
        </span>
        {totalMembers > 0 && (
          <span class="learning-path-card__progress" data-path-progress aria-live="polite">
            {`0 / ${totalMembers}`}
          </span>
        )}
      </span>
      <span class="learning-path-card__arrow" aria-hidden="true">→</span>
    </a>
  ) : (
    <div
      class={`learning-path-card learning-path-card--unavailable${primaryClass}`}
      data-path-id={path.id}
      data-path-availability="unavailable"
    >
      <span class="learning-path-card__body">
        <span class="learning-path-card__label">{path.labelJa}</span>
        <span class="learning-path-card__description">{path.descriptionJa}</span>
        <span class="learning-path-card__meta">
          <span class="learning-path-card__script">{scriptLabel}表示</span>
          <span class="learning-path-card__status">準備中です</span>
        </span>
        {totalMembers > 0 && (
          <span class="learning-path-card__progress" data-path-progress aria-live="polite">
            {`0 / ${totalMembers}`}
          </span>
        )}
      </span>
    </div>
  )
}

{
  quiz && (
    <a
      class="learning-path-card__quiz"
      href={quiz.href}
      data-path-quiz
    >
      <span class="learning-path-card__quiz-label">{quiz.labelJa}</span>
      <span class="learning-path-card__quiz-arrow" aria-hidden="true">→</span>
    </a>
  )
}

<style>
  .learning-path-card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    width: 100%;
    min-width: 0;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: var(--space-lg);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .learning-path-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
    flex: 1 1 auto;
  }
  /* First-class track marker: only the repository-primary (Taiwan-travel)
   * path renders this badge, so the primary track is identifiable without
   * colour alone and without promoting any auxiliary/future path. */
  .learning-path-card__badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 20px;
    padding: 0 var(--space-sm);
    border-radius: var(--radius);
    background: var(--c-primary);
    color: var(--color-on-primary);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .learning-path-card__label {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--c-text);
  }
  .learning-path-card__description {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--c-text-secondary);
  }
  .learning-path-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }
  .learning-path-card__script {
    color: var(--c-text-secondary);
    font-size: 0.75rem;
  }
  .learning-path-card__status {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 700;
  }
  .learning-path-card__progress {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--c-text-secondary);
    font-variant-numeric: tabular-nums;
  }
  .learning-path-card__arrow {
    flex: 0 0 auto;
    align-self: center;
    font-size: 1.25rem;
    color: var(--c-primary);
  }
  .learning-path-card--available .learning-path-card__status {
    background: var(--c-success-bg);
    color: var(--color-status-success);
  }
  .learning-path-card--available:hover {
    background: var(--c-primary-light);
  }
  .learning-path-card--available:hover .learning-path-card__label {
    color: var(--c-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .learning-path-card--available:focus-visible {
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px var(--c-accent-light);
  }
  .learning-path-card--primary {
    border-color: var(--c-primary);
    box-shadow: 0 0 0 1px var(--c-primary);
  }
  .learning-path-card--unavailable {
    color: var(--c-text-muted);
    cursor: default;
  }
  .learning-path-card--unavailable .learning-path-card__label {
    color: var(--c-text-muted);
  }
  .learning-path-card--unavailable .learning-path-card__status {
    background: var(--c-primary-light);
    color: var(--c-text-secondary);
  }

  /* Track-level assessment entry (#376): a truthful sibling link rendered
   * only when the caller supplies a quiz entry for this track, so no path
   * card ever fabricates an assessment link. */
  .learning-path-card__quiz {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    margin-top: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--c-primary);
    border-radius: var(--radius);
    background: var(--c-surface);
    color: var(--c-primary);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .learning-path-card__quiz:hover {
    background: var(--c-primary-light);
    text-decoration: none;
  }
  .learning-path-card__quiz:focus-visible {
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px var(--c-accent-light);
  }
  .learning-path-card__quiz-arrow {
    flex: 0 0 auto;
    color: var(--c-primary);
  }
</style>
